USER nix-crypto-service/src/export.rs
USER ```
USER //! Implements the `export secret` subcommand of `nix-crypto-service`.
USER //!
USER //! ## Overview
USER //!
USER //! This module resolves the CLI arguments for `export secret`, constructs a
USER //! [`CryptoNix`] instance from the sled store configuration, retrieves (or
USER //! generates) the requested private key or symmetric key passphrase, and writes
USER //! it to a file.
USER //!
USER //! ## Store resolution
USER //!
USER //! The sled store path is resolved from either:
USER //! - The `--sled-store` CLI flag, or
USER //! - The `NIX_CRYPTO_STORE` environment variable, which must be set to
USER //!   `sled:<path>`.
USER //!
USER //! ## Key identity
USER //!
USER //! The key identity string passed via `--openssl-pkey-id` must match exactly
USER //! the identity string produced by the nix-crypto plugin when the key was
USER //! stored. The identity string is produced by `to-key-identity` in
USER //! `crypto/openssl/main.nix`, which sorts the `attrs` keys alphabetically and
USER //! joins them as `key=value` pairs separated by `&`. For example:
USER //! `{ vault = "openssl"; name = "my-key"; }` → `"name=my-key&vault=openssl"`.
USER //! The `identity` field on the nix private key object exposes this string
USER //! directly so callers do not need to reconstruct it manually.
USER 
USER use nix_crypto_core::openssl::ffi::IsOpensslPrivateKeyIdentity;
USER use nix_crypto_core::openssl::decryptable::IsOpensslSymmetricKeyIdentity;
USER 
USER use crate::common::{Error, NixCryptoArgs};
USER 
USER /// The supported identity types for the `export secret` subcommand.
USER pub enum IdentityType {
USER     /// An OpenSSL private key identity, identified by key type and key id.
USER     ///
USER     /// - `pkey_type`: the key type (e.g. `"rsa"`).
USER     /// - `pkey_id`: the key identity string (e.g. `"name=my-key&vault=openssl"`).
USER     OpensslPkey {
USER         pkey_type: String,
USER         pkey_id: String,
USER     },
USER     /// An OpenSSL symmetric key identity. The passphrase (random secret) for
USER     /// this key will be retrieved from the store and written to the output file.
USER     ///
USER     /// - `key_id`: a unique identifier for the symmetric key.
USER     /// - `key_derivation`: the key derivation scheme (e.g. `"pbkdf2"`).
USER     /// - `iterations`: the number of iterations for the key derivation function.
USER     OpensslSymmetricKey {
USER         key_id: String,
USER         key_derivation: String,
USER         iterations: u32,
USER     },
USER }
USER 
USER /// The resolved arguments for the `export secret` subcommand.
USER pub struct ExportArgs {
USER     /// The identity of the secret to export.
USER     pub identity_type: IdentityType,
USER     /// The file path to write the exported secret to.
USER     pub output_file: String,
USER     /// The arguments used to build the `CryptoNix` instance.
USER     pub nix_crypto_args: NixCryptoArgs,
USER }
USER 
USER struct OpensslPkeyIdentity {
USER     pkey_type: String,
USER     pkey_id: String,
USER }
USER 
USER impl IsOpensslPrivateKeyIdentity for OpensslPkeyIdentity {
USER     fn key_type(&self) -> &String {
USER         &self.pkey_type
USER     }
USER 
USER     fn key_id(&self) -> &String {
USER         &self.pkey_id
USER     }
USER }
USER 
USER struct OpensslSymmetricKeyIdentity {
USER     key_id: String,
USER     key_derivation: String,
USER     iterations: u32,
USER }
USER 
USER impl IsOpensslSymmetricKeyIdentity for OpensslSymmetricKeyIdentity {
USER     fn key_id(&self) -> &String {
USER         &self.key_id
USER     }
USER 
USER     fn key_derivation(&self) -> &String {
USER         &self.key_derivation
USER     }
USER 
USER     fn iterations(&self) -> u32 {
USER         self.iterations
USER     }
USER }
USER 
USER const DEFAULT_KEY_DERIVATION: &str = "pbkdf2";
USER const DEFAULT_ITERATIONS: u32 = 600_000;
USER 
USER /// Resolves the identity type from the `--identity-type`, `--openssl-pkey-type`,
USER /// `--openssl-pkey-id`, `--openssl-symmetric-key-id`,
USER /// `--openssl-symmetric-key-derivation` and `--openssl-symmetric-key-iterations`
USER /// flags. Supported identity types are `openssl-pkey` and `openssl-symmetric-key`.
USER fn resolve_identity_type(
USER     flag_identity_type: Option<String>,
USER     flag_openssl_pkey_type: Option<String>,
USER     flag_openssl_pkey_id: Option<String>,
USER     flag_openssl_symmetric_key_id: Option<String>,
USER     flag_openssl_symmetric_key_derivation: Option<String>,
USER     flag_openssl_symmetric_key_iterations: Option<String>,
USER ) -> Result<IdentityType, Error> {
USER     match flag_identity_type.as_deref() {
USER         Some("openssl-pkey") => {
USER             let pkey_type = flag_openssl_pkey_type.ok_or_else(|| Error::argument_error(
USER                 "--openssl-pkey-type is required when --identity-type is 'openssl-pkey'".to_string()
USER             ))?;
USER             let pkey_id = flag_openssl_pkey_id.ok_or_else(|| Error::argument_error(
USER                 "--openssl-pkey-id is required when --identity-type is 'openssl-pkey'".to_string()
USER             ))?;
USER             Ok(IdentityType::OpensslPkey { pkey_type, pkey_id })
USER         }
USER         Some("openssl-symmetric-key") => {
USER             let key_id = flag_openssl_symmetric_key_id.ok_or_else(|| Error::argument_error(
USER                 "--openssl-symmetric-key-id is required when --identity-type is 'openssl-symmetric-key'".to_string()
USER             ))?;
USER             let key_derivation = flag_openssl_symmetric_key_derivation
USER                 .unwrap_or_else(|| DEFAULT_KEY_DERIVATION.to_string());
USER             let iterations = match flag_openssl_symmetric_key_iterations {
USER                 None => DEFAULT_ITERATIONS,
USER                 Some(s) => s.parse::<u32>().map_err(|_| Error::argument_error(
USER                     format!("--openssl-symmetric-key-iterations must be a positive integer, got '{}'", s)
USER                 ))?,
USER             };
USER             Ok(IdentityType::OpensslSymmetricKey { key_id, key_derivation, iterations })
USER         }
USER         Some(other) => Err(Error::argument_error(format!(
USER             "Unrecognised identity type '{}'. Supported types are: openssl-pkey, openssl-symmetric-key",
USER             other
USER         ))),
USER         None => Err(Error::argument_error(
USER             "--identity-type is required for export secret".to_string()
USER         )),
USER     }
USER }
USER 
USER /// Resolves all CLI flags into an [`ExportArgs`] struct.
USER pub fn resolve_args(
USER     nix_crypto_args: NixCryptoArgs,
USER     flag_identity_type: Option<String>,
USER     flag_openssl_pkey_type: Option<String>,
USER     flag_openssl_pkey_id: Option<String>,
USER     flag_openssl_symmetric_key_id: Option<String>,
USER     flag_openssl_symmetric_key_derivation: Option<String>,
USER     flag_openssl_symmetric_key_iterations: Option<String>,
USER     flag_output_file: Option<String>,
USER ) -> Result<ExportArgs, Error> {
USER     let identity_type = resolve_identity_type(
USER         flag_identity_type,
USER         flag_openssl_pkey_type,
USER         flag_openssl_pkey_id,
USER         flag_openssl_symmetric_key_id,
USER         flag_openssl_symmetric_key_derivation,
USER         flag_openssl_symmetric_key_iterations,
USER     )?;
USER 
USER     let output_file = flag_output_file.ok_or_else(|| Error::argument_error(
USER         "--output-file is required for export secret".to_string()
USER     ))?;
USER 
USER     Ok(ExportArgs {
USER         identity_type,
USER         output_file,
USER         nix_crypto_args,
USER     })
USER }
USER 
USER /// Runs the `export secret` subcommand.
USER ///
USER /// Constructs a [`CryptoNix`] instance from the sled store configuration,
USER /// retrieves (or generates) the secret identified by [`ExportArgs::identity_type`],
USER /// and writes it to [`ExportArgs::output_file`].
USER ///
USER /// - For `openssl-pkey`: retrieves the private key and writes it as PEM.
USER /// - For `openssl-symmetric-key`: retrieves the passphrase (random secret) and
USER ///   writes it as a plain string.
USER pub fn run_secret(args: ExportArgs) -> Result<(), Error> {
USER 
USER     let crypto_nix = args.nix_crypto_args.init()?;
USER 
USER     match args.identity_type {
USER         IdentityType::OpensslPkey { pkey_type, pkey_id } => {
USER             let identity = OpensslPkeyIdentity { pkey_type, pkey_id };
USER 
USER             let key = crypto_nix
USER                 .openssl_private_key(&identity)
USER                 .map_err(|e| Error::argument_error(format!("Failed to obtain private key: {}", e)))?;
USER 
USER             let pem_bytes = key
USER                 .key_to_pem()
USER                 .map_err(|e| Error::argument_error(format!("Failed to convert key to PEM: {}", e)))?;
USER 
USER             let pem_string = String::from_utf8(pem_bytes)
USER                 .map_err(|e| Error::argument_error(format!("Failed to convert PEM bytes to string: {}", e)))?;
USER 
USER             std::fs::write(&args.output_file, pem_string)
USER                 .map_err(|e| Error::argument_error(format!("Failed to write key to '{}': {}", args.output_file, e)))?;
USER 
USER             println!("Successfully exported private key to '{}'", args.output_file);
USER             Ok(())
USER         }
USER         IdentityType::OpensslSymmetricKey { key_id, key_derivation, iterations } => {
USER             let identity = OpensslSymmetricKeyIdentity { key_id, key_derivation, iterations };
USER 
USER             let passphrase = crypto_nix
USER                 .openssl_symmetric_key_passphrase(&identity)
USER                 .map_err(|e| Error::argument_error(format!("Failed to obtain symmetric key passphrase: {}", e)))?;
USER 
USER             std::fs::write(&args.output_file, passphrase)
USER                 .map_err(|e| Error::argument_error(format!("Failed to write passphrase to '{}': {}", args.output_file, e)))?;
USER 
USER             println!("Successfully exported symmetric key passphrase to '{}'", args.output_file);
USER             Ok(())
USER         }
USER     }
USER }
USER ```
USER 
USER nix-crypto-core/src/openssl/pkey.rs
USER ```
USER use openssl::pkey::{PKey, Public, Private};
USER use openssl::rsa;
USER 
USER // Imports from this crate
USER use crate::error::{Error};
USER use crate::foundations::{IsCryptoStoreKeyDerivable};
USER use crate::store::{IsCryptoStoreKey, StoreHasher};
USER use crate::support::{Exportable};
USER 
USER #[repr(u8)]
USER pub enum Type {
USER     RsaKey = 0
USER }
USER 
USER impl From<u8> for Type {
USER 
USER     fn from(value: u8) -> Type {
USER 
USER         if value == Type::RsaKey as u8 {
USER             return Type::RsaKey;
USER         }
USER         
USER         panic!("The value {} is not a vaild RSA key type", value)
USER     }
USER }
USER 
USER impl From<Type> for u8 {
USER 
USER     fn from(value: Type) -> u8 {
USER         value as u8
USER     }
USER }
USER 
USER impl TryFrom<&str> for Type {
USER     type Error = Error;
USER 
USER     fn try_from(value: &str) -> Result<Type, Error> {
USER 
USER         let error_message = format!("The value {value} is not a known openssl private key type.");
USER 
USER         match value {
USER             "rsa" => Ok(Type::RsaKey),
USER             _ => Error::fail_with(error_message)
USER         }
USER     }
USER }
USER 
USER impl TryFrom<&String> for Type {
USER     type Error = Error;
USER 
USER     fn try_from(value: &String) -> Result<Type, Error> {
USER         Type::try_from(value.as_str())
USER     }
USER }
USER 
USER /// CryptoNix wrapper type around 'PKey'. The main purpose
USER /// of this struct is to provide an API that can be used
USER /// in C++ code.
USER pub struct Key {
USER     pub pkey: PKey<Private>
USER }
USER 
USER impl Key {
USER 
USER     pub fn key_to_pem(&self) -> Result<Vec<u8>, Error> {
USER         let result = self.pkey.private_key_to_pem_pkcs8()?;
USER         Ok(result)
USER     }
USER 
USER     pub fn key_from_pem(pem_bytes: &[u8]) -> Result<Self, Error> {
USER         let pkey = PKey::private_key_from_pem(pem_bytes)?;
USER         Ok(Self::from_openssl_pkey(pkey))
USER     }
USER 
USER     pub fn from_openssl_pkey(pkey: PKey<Private>) -> Self {
USER         Key { pkey: pkey }
USER     }
USER 
USER     pub fn new(key_type : Type) -> Result<Key, Error> {
USER 
USER         match key_type {
USER             Type::RsaKey => {
USER                 let rsa = rsa::Rsa::generate(4096)?;
USER                 Ok(Key::from_openssl_pkey(PKey::from_rsa(rsa)?))
USER             }
USER         }
USER     }
USER 
USER     pub fn public_pem(self: &Self) -> Result<String, Error> {
USER         let pem = self.pkey.public_key_to_pem()?;
USER         let result = String::from_utf8(pem)?;
USER         Ok(result)
USER     }
USER 
USER     pub fn public_key(&self) -> Result<PKey<Public>, Error> {
USER         let pem = self.pkey.public_key_to_pem()?;
USER         let result = PKey::public_key_from_pem(&pem)?;
USER         Ok(result)
USER     }
USER }
USER 
USER impl Exportable for Key {
USER     fn export(&self) -> Result<Vec<u8>, Error> {
USER         self.key_to_pem()
USER     }
USER }
USER 
USER /// This trait allows defining structs meant to be used as
USER /// identities for openssl private keys (in the context of
USER /// assymetric cryptography). They idea is that they contain
USER /// all the context needed to both uniquely reference a key
USER /// and generate the key if no reference currently exits.
USER pub trait IsOpensslPrivateKeyIdentity {
USER     fn key_type(&self) -> &String;
USER     fn key_id(&self) -> &String;
USER }
USER 
USER /// This struct serves as a wrapper to allow instances of the
USER /// `IsCrytpoStoreKey` and `IsCryptoStoreKeyDerivable` to be
USER /// implemented for any instance of `IsOpensslPrivatekeyIdentity`
USER /// without using blanket implementations.
USER pub struct OpensslPrivateKeyIdentityWrapper<'a, T>(pub &'a T);
USER 
USER impl<'a,T : IsOpensslPrivateKeyIdentity> IsCryptoStoreKey for OpensslPrivateKeyIdentityWrapper<'a, T> {
USER     type Value = Key;
USER 
USER     /// Derive a key for the store using the wrapped `IsOpensslPrivateKeyIdentity` instance.
USER     /// The key is derived by hashing all of the fields together.
USER     fn to_store_key_raw(&self, mut hasher: StoreHasher) -> Vec<u8> {
USER         let identity = self.0;
USER         hasher.update(identity.key_type().as_bytes());
USER         hasher.update(identity.key_id().as_bytes());
USER         Vec::from(hasher.finish())
USER     }
USER 
USER     /// Make a byte representation of the Openssl private key by converting
USER     /// it to pem format and then encoding the resulting string into a
USER     /// byte array.
USER     fn to_store_value_raw(value: &Self::Value) -> Result<Vec<u8>, Error> {
USER         Key::key_to_pem(value)
USER     }
USER 
USER     /// Recover the openssl private key by parsing the pem string which
USER     /// contains the key.
USER     fn from_store_value_raw(bytes: &Vec<u8>) -> Result<Self::Value, Error> {
USER         Key::key_from_pem(&bytes[..])
USER     }
USER }
USER 
USER impl<'a, T : IsOpensslPrivateKeyIdentity> IsCryptoStoreKeyDerivable for OpensslPrivateKeyIdentityWrapper<'a, T> {
USER 
USER     fn derive(&self) -> Result<Key, Error> {
USER         let key_type = Type::try_from(self.0.key_type())?;
USER         Key::new(key_type)
USER     }
USER }
USER ```
USER 
USER nix-crypto-core/src/openssl.rs
USER ```
USER use openssl::bn::{BigNum};
USER use openssl::hash::{MessageDigest};
USER use openssl::pkey::{PKey, Public};
USER use openssl::x509::{X509Builder};
USER use openssl::x509::extension::{AuthorityKeyIdentifier, SubjectKeyIdentifier};
USER 
USER use crate::error::{Error};
USER use crate::foundations::{CryptoNix, IsCryptoStoreKeyDerivable};
USER use crate::support::{Exportable};
USER 
USER pub mod pkey;
USER pub mod decryptable;
USER 
USER /// This module defines traits which describe the fields expected from
USER /// CXX types. The reason why this is needed is because the "cxx" crate
USER /// needs types to be defined in the same module in order for the fields
USER /// of the type to be visible in C++. Since theese types are built with
USER /// C++ code and then passed to rust code they cannot be opaque and cannot
USER /// be defined in this crate as this crate is meant to contain all the core
USER /// logic of nix-crypto as a rust library which should not have any dependencies
USER /// on the nix libraries.
USER pub mod ffi {
USER 
USER     use openssl::asn1::{Asn1Time};
USER     use openssl::pkey::*;
USER     use openssl::x509::*;
USER     use openssl::x509::extension::*;
USER     use time::{UtcDateTime};
USER     use time::format_description::well_known::{Rfc3339};
USER 
USER     // Modules from this crate
USER     use crate::error::*;
USER 
USER     pub use crate::openssl::pkey::{IsOpensslPrivateKeyIdentity};
USER 
USER     pub trait IsX509NameItem {
USER         fn entry_name(&self) -> &String;
USER         fn entry_value(&self) -> &String;
USER     }
USER 
USER     pub trait IsX509KeyUsage {
USER         fn critical(&self) -> bool;
USER         fn key_cert_sign(&self) -> bool;
USER         fn crl_sign(&self) -> bool;
USER     }
USER 
USER     pub trait IsX509BasicConstraints {
USER         fn critical(&self) -> bool; 
USER         fn ca(&self) -> bool;
USER     }
USER 
USER     pub trait IsX509BuildParams {
USER         type PrivateKeyIdentity : IsOpensslPrivateKeyIdentity;
USER         type NameItem : IsX509NameItem;
USER         type KeyUsage : IsX509KeyUsage;
USER         type BasicConstraints : IsX509BasicConstraints;
USER 
USER         fn subject_public_key(&self) -> Option<&String>;
USER         fn signing_private_key_identity(&self) -> &Self::PrivateKeyIdentity;
USER         fn issuer_name(&self) -> &Vec<Self::NameItem>;
USER         fn subject_name(&self) -> &Vec<Self::NameItem>;
USER         fn serial(&self) -> u32;
USER         fn start_date(&self) -> &String;
USER         fn expiry_date(&self) -> &String;
USER         fn extension_key_usage(&self) -> Option<&Self::KeyUsage>;
USER         fn extension_basic_constraints(&self) -> Option<&Self::BasicConstraints>;
USER     }
USER 
USER     fn name_from_entries<T : IsX509NameItem>(entries: &Vec<T>) -> Result<X509Name, Error> {
USER         let mut builder = X509NameBuilder::new()?;
USER         for entry in entries.iter() {
USER             builder.append_entry_by_text(
USER                 entry.entry_name().as_str(),
USER                 entry.entry_value().as_str()
USER             )?;
USER         }
USER     
USER         Ok(builder.build())
USER     }
USER 
USER     fn parse_date_rfc3339(date: &str) -> Result<Asn1Time, Error> {
USER         let utc = UtcDateTime::parse(date, &Rfc3339)?;
USER         Ok(Asn1Time::from_unix(utc.unix_timestamp())?)
USER     }
USER 
USER     
USER     pub fn as_key_usage_extension<T: IsX509KeyUsage>(key_usage: &T) -> Result<X509Extension, Error> {
USER     
USER         let mut builder = KeyUsage::new();
USER     
USER         if key_usage.critical() {
USER             builder.critical();
USER         }
USER     
USER         if key_usage.key_cert_sign() {
USER             builder.key_cert_sign();
USER         }
USER     
USER         if key_usage.crl_sign() {
USER             builder.crl_sign();
USER         }
USER     
USER         Ok(builder.build()?)
USER     }
USER     
USER     pub fn as_basic_constraints_extension<T: IsX509BasicConstraints>(basic_constraints: &T) -> Result<X509Extension, Error> {
USER     
USER         let mut builder = BasicConstraints::new();
USER     
USER         if basic_constraints.critical() {
USER             builder.critical();
USER         }
USER     
USER         if basic_constraints.ca() {
USER             builder.ca();
USER         }
USER     
USER         Ok(builder.build()?)
USER     }
USER 
USER     
USER     pub fn get_subject_public_key<T: IsX509BuildParams>(params: &T) -> Result<Option<PKey<Public>>, Error> {
USER     
USER         match params.subject_public_key() {
USER             Some(pem) => {
USER                 let result = PKey::public_key_from_pem(pem.as_bytes())?;
USER                 Ok(Some(result))
USER             },
USER             None => Ok(None)
USER         }
USER     }
USER     
USER     pub fn build_issuer_name<T: IsX509BuildParams>(params: &T) -> Result<X509Name, Error> {
USER         name_from_entries(&params.issuer_name())
USER     }
USER     
USER     pub fn build_subject_name<T: IsX509BuildParams>(params: &T) -> Result<X509Name, Error> {
USER         name_from_entries(&params.subject_name())
USER     }
USER     
USER     pub fn start_date_as_asn1<T: IsX509BuildParams>(params: &T) -> Result<Asn1Time, Error> {
USER         parse_date_rfc3339(&params.start_date())
USER     }
USER     
USER     pub fn expiry_date_as_asn1<T: IsX509BuildParams>(params: &T) -> Result<Asn1Time, Error> {
USER         parse_date_rfc3339(&params.expiry_date())
USER     }
USER     
USER     /// Convert the key usage declarations specified in the CXX struct
USER     /// into a 'X509Extension' which can be applied when building
USER     /// a 'X509' certificate.
USER     pub fn build_key_usage_ext<T: IsX509BuildParams>(params: &T) -> Result<Option<X509Extension>, Error> {
USER         params.extension_key_usage()
USER             .map(|e : &T::KeyUsage| as_key_usage_extension(e))
USER             .transpose()
USER     }
USER     
USER     /// Convert the basic constraints that have been declared in the
USER     /// CXX call into a 'X509Extension', which can be applied when building
USER     /// a 'X509' certificate.
USER     pub fn build_basic_constraints_ext<T: IsX509BuildParams>(params: &T) -> Result<Option<X509Extension>, Error> {
USER         params.extension_basic_constraints()
USER             .map(|e : &T::BasicConstraints| as_basic_constraints_extension(e))
USER             .transpose()
USER     }
USER }
USER 
USER pub mod x509 {
USER     use openssl::x509::{X509};
USER 
USER     use crate::error::{Error};
USER 
USER     /// This is a wrapper tipe for the 'X509' type defined in the
USER     /// 'openssl' crate. The main purpose of this type is to
USER     /// expose methods which can be invoked from C++ code.
USER     pub struct X509Certificate {
USER         pub certificate: X509
USER     }
USER 
USER     impl X509Certificate {
USER 
USER         pub fn new(cert: X509) -> Self {
USER             X509Certificate { certificate: cert }
USER         }
USER 
USER         pub fn public_pem(&self) -> Result<String, Error> {
USER             let pem = self.certificate.to_pem()?;
USER             let result = String::from_utf8(pem)?;
USER             Ok(result)
USER         }
USER     }
USER }
USER 
USER impl CryptoNix {
USER 
USER     /// Get the Openssl private key which corresponds to the
USER     /// given 'OpensslPrivateKeyIdentity'. If there is no key
USER     /// associated with that identity, a fresh key will be
USER     /// generated and saved to the store.
USER     pub fn openssl_private_key<T : pkey::IsOpensslPrivateKeyIdentity>(
USER         &self,
USER         key_identity: &T
USER     ) -> Result<pkey::Key, Error> {
USER         self.get_or_derive(&pkey::OpensslPrivateKeyIdentityWrapper(key_identity))
USER     }
USER 
USER     /// Construct an X509 certificate. This function accepts a 'X50BuildParams'
USER     /// which describe how the certificate is to be built in the context of
USER     /// nix-crypto.
USER     pub fn openssl_x509_certificate<T : ffi::IsX509BuildParams>(
USER         &self,
USER         params: &T
USER     ) -> Result<x509::X509Certificate, Error> {
USER 
USER         let signing_key = self.openssl_private_key(params.signing_private_key_identity())?;
USER 
USER         let subject_key: PKey<Public> = match ffi::get_subject_public_key(params)? {
USER 
USER             // Subject has been explicitly provided
USER             Some(sub) => sub,
USER 
USER             // No subject provided, certificate will be self-sigend
USER             None => signing_key.public_key()?
USER         };
USER 
USER         let mut builder = X509Builder::new()?;
USER         let issuer_name = ffi::build_issuer_name(params)?;
USER         let subject_name = ffi::build_subject_name(params)?;
USER 
USER         builder.set_pubkey(&subject_key)?;
USER         builder.set_issuer_name(&issuer_name)?;
USER         builder.set_subject_name(&subject_name)?;
USER 
USER         let serial = BigNum::from_u32(params.serial())?.to_asn1_integer()?;
USER         builder.set_serial_number(&serial)?;
USER 
USER         let start_date = ffi::start_date_as_asn1(params)?;
USER         let expiry_date = ffi::expiry_date_as_asn1(params)?;
USER         builder.set_not_before(&start_date)?;
USER         builder.set_not_after(&expiry_date)?;
USER 
USER         ffi::build_key_usage_ext(params)?
USER             .map(|e| builder.append_extension(e))
USER             .transpose()?;
USER 
USER         ffi::build_basic_constraints_ext(params)?
USER             .map(|e| builder.append_extension(e))
USER             .transpose()?;
USER 
USER         builder.append_extension(
USER             SubjectKeyIdentifier::new().build(&builder.x509v3_context(None, None))?,
USER         )?;
USER 
USER         builder.append_extension(
USER             AuthorityKeyIdentifier::new()
USER                 .keyid(true)
USER                 .build(&builder.x509v3_context(None, None))?,
USER         )?;
USER 
USER         builder.sign(&signing_key.pkey, MessageDigest::sha256())?;
USER 
USER         Ok(x509::X509Certificate::new(builder.build()))
USER     }
