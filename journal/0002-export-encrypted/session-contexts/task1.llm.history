USER use crate::error::{Error};
USER 
USER // ============================================================================
USER // Exportable trait
USER // ============================================================================
USER 
USER /// The exportable trait applies to all credentials that can be exported
USER /// as plaintext. This text is not expected to contain any encryption or
USER /// security.
USER pub trait Exportable {
USER     fn export(&self) -> Result<Vec<u8>, Error>;
USER }
