ASSISTANT impl<C> IsCryptoStoreKeyDerivable for AsymmetricEncryptionKey<C>
ASSISTANT where
ASSISTANT     C: IsCryptoStoreKeyDerivable,
ASSISTANT     C::Value: Exportable,
ASSISTANT {
ASSISTANT     fn derive(&self) -> Result<AsymmetricEncryptionResult, Error> {
ASSISTANT         // Export the credential to bytes.
ASSISTANT         let credential_bytes = self.credential.export()?;
ASSISTANT 
ASSISTANT         // Generate a random 256-bit (32 byte) AES symmetric key.
ASSISTANT         let mut sym_key = vec![0u8; 32];
ASSISTANT         rand_bytes(&mut sym_key)?;
ASSISTANT 
ASSISTANT         // Generate a random 128-bit (16 byte) IV for AES-256-CBC.
ASSISTANT         let mut iv = vec![0u8; 16];
ASSISTANT         rand_bytes(&mut iv)?;
ASSISTANT 
ASSISTANT         // Encrypt the credential bytes with AES-256-CBC.
ASSISTANT         let cipher = Cipher::aes_256_cbc();
ASSISTANT         let ciphertext = encrypt(cipher, &sym_key, Some(&iv), &credential_bytes)?;
ASSISTANT 
ASSISTANT         // Prepend the IV to the ciphertext.
ASSISTANT         let mut iv_and_ciphertext = iv;
ASSISTANT         iv_and_ciphertext.extend_from_slice(&ciphertext);
ASSISTANT 
ASSISTANT         // Encrypt the symmetric key with RSA-OAEP using the asymmetric public key.
ASSISTANT         let pkey_ref = PKey::from_rsa(self.pkey.pkey.rsa()?)?;
ASSISTANT         let mut encrypter = Encrypter::new(&pkey_ref)?;
ASSISTANT         encrypter.set_rsa_padding(Padding::PKCS1_OAEP)?;
ASSISTANT 
ASSISTANT         let buffer_len = encrypter.encrypt_len(&sym_key)?;
ASSISTANT         let mut encrypted_key = vec![0u8; buffer_len];
ASSISTANT         let actual_len = encrypter.encrypt(&sym_key, &mut encrypted_key)?;
ASSISTANT         encrypted_key.truncate(actual_len);
ASSISTANT 
ASSISTANT         Ok(AsymmetricEncryptionResult {
ASSISTANT             encrypted_key,
ASSISTANT             iv_and_ciphertext,
ASSISTANT         })
ASSISTANT     }
ASSISTANT }
