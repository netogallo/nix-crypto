ASSISTANT pub fn export_encrypted<K, C>(
ASSISTANT     crypto_nix: &CryptoNix,
ASSISTANT     key: &K,
ASSISTANT     credential: &C,
ASSISTANT ) -> Result<String, Error>
ASSISTANT where
ASSISTANT     K: IsOpensslPrivateKeyIdentity,
ASSISTANT     C: IsCryptoStoreKeyDerivable,
ASSISTANT     C::Value: Exportable,
ASSISTANT {
ASSISTANT     // Resolve the asymmetric key using get_or_derive.
ASSISTANT     let pkey_wrapper = OpensslPrivateKeyIdentityWrapper(key);
ASSISTANT     let pkey = crypto_nix.get_or_derive(&pkey_wrapper)?;
ASSISTANT 
ASSISTANT     // Resolve the credential using get_or_derive.
ASSISTANT     let resolved_credential = crypto_nix.get_or_derive(credential)?;
ASSISTANT 
ASSISTANT     // Compute the store key by hashing the asymmetric key identity and
ASSISTANT     // credential identity together using StoreHasher.
ASSISTANT     let mut hasher = StoreHasher::init(crypto_nix.salt());
ASSISTANT     hasher.update(b"asymmetric_encryption");
ASSISTANT     hasher.update_with_identity(&pkey_wrapper);
ASSISTANT     hasher.update_with_identity(credential);
ASSISTANT     let store_key = Vec::from(hasher.finish());
ASSISTANT 
ASSISTANT     // Construct the AsymmetricEncryptionKey struct.
ASSISTANT     let asym_enc_key = AsymmetricEncryptionKey::<C> {
ASSISTANT         store_key,
ASSISTANT         pkey,
ASSISTANT         credential: resolved_credential,
ASSISTANT     };
ASSISTANT 
ASSISTANT     // Get or compute the AsymmetricEncryptionResult.
ASSISTANT     let result = crypto_nix.get_or_derive(&asym_enc_key)?;
ASSISTANT 
ASSISTANT     // PEM-encode the encrypted symmetric key.
ASSISTANT     let encrypted_key_pem = encode_pem("ENCRYPTED KEY", &result.encrypted_key);
ASSISTANT 
ASSISTANT     // PEM-encode the IV-prepended ciphertext.
ASSISTANT     let encrypted_data_pem = encode_pem("ENCRYPTED DATA", &result.iv_and_ciphertext);
ASSISTANT 
ASSISTANT     // Concatenate and return.
ASSISTANT     Ok(format!("{}{}", encrypted_key_pem, encrypted_data_pem))
ASSISTANT }
