ASSISTANT 
ASSISTANT impl<K, C> IsCryptoStoreKeyDerivable for AsymmetricEncryptionKey<K, C>
ASSISTANT where
ASSISTANT     K: IsOpensslPrivateKeyIdentity,
ASSISTANT     C: IsCryptoStoreKeyDerivable,
ASSISTANT     C::Value: Exportable,
ASSISTANT {
ASSISTANT     fn derive(&self) -> Result<AsymmetricEncryptionResult, Error> {
ASSISTANT         // Export the credential to bytes.
ASSISTANT         let credential_bytes = self.credential.export()?;
ASSISTANT 
ASSISTANT         // Generate a random 256-bit (32 byte) AES symmetric key.
ASSISTANT         let mut sym_key = vec![0u8; 32];
ASSISTANT         rand_bytes(&mut sym_key)?;
ASSISTANT 
ASSISTANT         // Generate a random 128-bit (16 byte) IV for AES-256-CBC.
ASSISTANT         let mut iv = vec![0u8; 16];
ASSISTANT         rand_bytes(&mut iv)?;
ASSISTANT 
ASSISTANT         // Encrypt the credential bytes with AES-256-CBC.
ASSISTANT         let cipher = Cipher::aes_256_cbc();
ASSISTANT         let ciphertext = encrypt(cipher, &sym_key, Some(&iv), &credential_bytes)?;
ASSISTANT 
ASSISTANT         // Prepend the IV to the ciphertext.
ASSISTANT         let mut iv_and_ciphertext = iv;
ASSISTANT         iv_and_ciphertext.extend_from_slice(&ciphertext);
ASSISTANT 
ASSISTANT         // Encrypt the symmetric key with RSA-OAEP using the asymmetric public key.
ASSISTANT         let pkey_ref = PKey::from_rsa(self.pkey.pkey.rsa()?)?;
ASSISTANT         let mut encrypter = Encrypter::new(&pkey_ref)?;
ASSISTANT         encrypter.set_rsa_padding(Padding::PKCS1_OAEP)?;
ASSISTANT 
ASSISTANT         let buffer_len = encrypter.encrypt_len(&sym_key)?;
ASSISTANT         let mut encrypted_key = vec![0u8; buffer_len];
ASSISTANT         let actual_len = encrypter.encrypt(&sym_key, &mut encrypted_key)?;
ASSISTANT         encrypted_key.truncate(actual_len);
ASSISTANT 
ASSISTANT         Ok(AsymmetricEncryptionResult {
ASSISTANT             encrypted_key,
ASSISTANT             iv_and_ciphertext,
ASSISTANT         })
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT pub fn export_encrypted<K, C>(
ASSISTANT     crypto_nix: &CryptoNix,
ASSISTANT     key: &K,
ASSISTANT     credential: &C,
ASSISTANT ) -> Result<String, Error>
ASSISTANT where
ASSISTANT     K: IsOpensslPrivateKeyIdentity,
ASSISTANT     C: IsCryptoStoreKeyDerivable,
ASSISTANT     C::Value: Exportable,
ASSISTANT {
ASSISTANT     // Resolve the asymmetric key using get_or_derive.
ASSISTANT     let pkey_wrapper = OpensslPrivateKeyIdentityWrapper(key);
ASSISTANT     let pkey = crypto_nix.get_or_derive(&pkey_wrapper)?;
ASSISTANT 
ASSISTANT     // Resolve the credential using get_or_derive.
ASSISTANT     let resolved_credential = crypto_nix.get_or_derive(credential)?;
ASSISTANT 
ASSISTANT     // Compute the store key by hashing the asymmetric key identity and
ASSISTANT     // credential identity together using StoreHasher.
ASSISTANT     let mut hasher = StoreHasher::init(crypto_nix.salt());
ASSISTANT     hasher.update(b"asymmetric_encryption");
ASSISTANT     hasher.update_with_identity(&pkey_wrapper);
ASSISTANT     hasher.update_with_identity(credential);
ASSISTANT     let store_key = Vec::from(hasher.finish());
ASSISTANT 
ASSISTANT     // Construct the AsymmetricEncryptionKey struct.
ASSISTANT     let asym_enc_key = AsymmetricEncryptionKey::<K, C> {
ASSISTANT         store_key,
ASSISTANT         pkey,
ASSISTANT         credential: resolved_credential,
ASSISTANT     };
ASSISTANT 
ASSISTANT     // Get or compute the AsymmetricEncryptionResult.
ASSISTANT     let result = crypto_nix.get_or_derive(&asym_enc_key)?;
ASSISTANT 
ASSISTANT     // PEM-encode the encrypted symmetric key.
ASSISTANT     let encrypted_key_pem = encode(&Pem {
ASSISTANT         tag: "ENCRYPTED KEY".to_string(),
ASSISTANT         contents: result.encrypted_key,
ASSISTANT     });
ASSISTANT 
ASSISTANT     // PEM-encode the IV-prepended ciphertext.
ASSISTANT     let encrypted_data_pem = encode(&Pem {
ASSISTANT         tag: "ENCRYPTED DATA".to_string(),
ASSISTANT         contents: result.iv_and_ciphertext,
ASSISTANT     });
ASSISTANT 
ASSISTANT     // Concatenate and return.
ASSISTANT     Ok(format!("{}{}", encrypted_key_pem, encrypted_data_pem))
ASSISTANT }
ASSISTANT ```
