ASSISTANT /// Encode a byte slice as a PEM block with the given label.
ASSISTANT fn encode_pem(label: &str, data: &[u8]) -> String {
ASSISTANT     let encoded = STANDARD.encode(data);
ASSISTANT     // Split base64 into 64-character lines as per PEM convention.
ASSISTANT     let lines: Vec<&str> = encoded
ASSISTANT         .as_bytes()
ASSISTANT         .chunks(64)
ASSISTANT         .map(|chunk| std::str::from_utf8(chunk).unwrap())
ASSISTANT         .collect();
ASSISTANT     format!(
ASSISTANT         "-----BEGIN {}-----\n{}\n-----END {}-----\n",
ASSISTANT         label,
ASSISTANT         lines.join("\n"),
ASSISTANT         label
ASSISTANT     )
ASSISTANT }
