USER nix-crypto-service/src/export.rs
USER ```
USER //! Implements the `export secret` subcommand of `nix-crypto-service`.
USER //!
USER //! ## Overview
USER //!
USER //! This module resolves the CLI arguments for `export secret`, constructs a
USER //! [`CryptoNix`] instance from the sled store configuration, retrieves (or
USER //! generates) the requested private key or symmetric key passphrase, and writes
USER //! it to a file.
USER //!
USER //! ## Store resolution
USER //!
USER //! The sled store path is resolved from either:
USER //! - The `--sled-store` CLI flag, or
USER //! - The `NIX_CRYPTO_STORE` environment variable, which must be set to
USER //!   `sled:<path>`.
USER //!
USER //! ## Key identity
USER //!
USER //! The key identity string passed via `--openssl-pkey-id` must match exactly
USER //! the identity string produced by the nix-crypto plugin when the key was
USER //! stored. The identity string is produced by `to-key-identity` in
USER //! `crypto/openssl/main.nix`, which sorts the `attrs` keys alphabetically and
USER //! joins them as `key=value` pairs separated by `&`. For example:
USER //! `{ vault = "openssl"; name = "my-key"; }` → `"name=my-key&vault=openssl"`.
USER //! The `identity` field on the nix private key object exposes this string
USER //! directly so callers do not need to reconstruct it manually.
USER 
USER use nix_crypto_core::openssl::ffi::IsOpensslPrivateKeyIdentity;
USER use nix_crypto_core::openssl::decryptable::IsOpensslSymmetricKeyIdentity;
USER 
USER use crate::common::{Error, NixCryptoArgs};
USER 
USER /// The supported identity types for the `export secret` subcommand.
USER pub enum IdentityType {
USER     /// An OpenSSL private key identity, identified by key type and key id.
USER     ///
USER     /// - `pkey_type`: the key type (e.g. `"rsa"`).
USER     /// - `pkey_id`: the key identity string (e.g. `"name=my-key&vault=openssl"`).
USER     OpensslPkey {
USER         pkey_type: String,
USER         pkey_id: String,
USER     },
USER     /// An OpenSSL symmetric key identity. The passphrase (random secret) for
USER     /// this key will be retrieved from the store and written to the output file.
USER     ///
USER     /// - `key_id`: a unique identifier for the symmetric key.
USER     /// - `key_derivation`: the key derivation scheme (e.g. `"pbkdf2"`).
USER     /// - `iterations`: the number of iterations for the key derivation function.
USER     OpensslSymmetricKey {
USER         key_id: String,
USER         key_derivation: String,
USER         iterations: u32,
USER     },
USER }
USER 
USER /// The resolved arguments for the `export secret` subcommand.
USER pub struct ExportArgs {
USER     /// The identity of the secret to export.
USER     pub identity_type: IdentityType,
USER     /// The file path to write the exported secret to.
USER     pub output_file: String,
USER     /// The arguments used to build the `CryptoNix` instance.
USER     pub nix_crypto_args: NixCryptoArgs,
USER }
USER 
USER struct OpensslPkeyIdentity {
USER     pkey_type: String,
USER     pkey_id: String,
USER }
USER 
USER impl IsOpensslPrivateKeyIdentity for OpensslPkeyIdentity {
USER     fn key_type(&self) -> &String {
USER         &self.pkey_type
USER     }
USER 
USER     fn key_id(&self) -> &String {
USER         &self.pkey_id
USER     }
USER }
USER 
USER struct OpensslSymmetricKeyIdentity {
USER     key_id: String,
USER     key_derivation: String,
USER     iterations: u32,
USER }
USER 
USER impl IsOpensslSymmetricKeyIdentity for OpensslSymmetricKeyIdentity {
USER     fn key_id(&self) -> &String {
USER         &self.key_id
USER     }
USER 
USER     fn key_derivation(&self) -> &String {
USER         &self.key_derivation
USER     }
USER 
USER     fn iterations(&self) -> u32 {
USER         self.iterations
USER     }
USER }
USER 
USER const DEFAULT_KEY_DERIVATION: &str = "pbkdf2";
USER const DEFAULT_ITERATIONS: u32 = 600_000;
USER 
USER /// Resolves the identity type from the `--identity-type`, `--openssl-pkey-type`,
USER /// `--openssl-pkey-id`, `--openssl-symmetric-key-id`,
USER /// `--openssl-symmetric-key-derivation` and `--openssl-symmetric-key-iterations`
USER /// flags. Supported identity types are `openssl-pkey` and `openssl-symmetric-key`.
USER fn resolve_identity_type(
USER     flag_identity_type: Option<String>,
USER     flag_openssl_pkey_type: Option<String>,
USER     flag_openssl_pkey_id: Option<String>,
USER     flag_openssl_symmetric_key_id: Option<String>,
USER     flag_openssl_symmetric_key_derivation: Option<String>,
USER     flag_openssl_symmetric_key_iterations: Option<String>,
USER ) -> Result<IdentityType, Error> {
USER     match flag_identity_type.as_deref() {
USER         Some("openssl-pkey") => {
USER             let pkey_type = flag_openssl_pkey_type.ok_or_else(|| Error::argument_error(
USER                 "--openssl-pkey-type is required when --identity-type is 'openssl-pkey'".to_string()
USER             ))?;
USER             let pkey_id = flag_openssl_pkey_id.ok_or_else(|| Error::argument_error(
USER                 "--openssl-pkey-id is required when --identity-type is 'openssl-pkey'".to_string()
USER             ))?;
USER             Ok(IdentityType::OpensslPkey { pkey_type, pkey_id })
USER         }
USER         Some("openssl-symmetric-key") => {
USER             let key_id = flag_openssl_symmetric_key_id.ok_or_else(|| Error::argument_error(
USER                 "--openssl-symmetric-key-id is required when --identity-type is 'openssl-symmetric-key'".to_string()
USER             ))?;
USER             let key_derivation = flag_openssl_symmetric_key_derivation
USER                 .unwrap_or_else(|| DEFAULT_KEY_DERIVATION.to_string());
USER             let iterations = match flag_openssl_symmetric_key_iterations {
USER                 None => DEFAULT_ITERATIONS,
USER                 Some(s) => s.parse::<u32>().map_err(|_| Error::argument_error(
USER                     format!("--openssl-symmetric-key-iterations must be a positive integer, got '{}'", s)
USER                 ))?,
USER             };
USER             Ok(IdentityType::OpensslSymmetricKey { key_id, key_derivation, iterations })
USER         }
USER         Some(other) => Err(Error::argument_error(format!(
USER             "Unrecognised identity type '{}'. Supported types are: openssl-pkey, openssl-symmetric-key",
USER             other
USER         ))),
USER         None => Err(Error::argument_error(
USER             "--identity-type is required for export secret".to_string()
USER         )),
USER     }
USER }
USER 
USER /// Resolves all CLI flags into an [`ExportArgs`] struct.
USER pub fn resolve_args(
USER     nix_crypto_args: NixCryptoArgs,
USER     flag_identity_type: Option<String>,
USER     flag_openssl_pkey_type: Option<String>,
USER     flag_openssl_pkey_id: Option<String>,
USER     flag_openssl_symmetric_key_id: Option<String>,
USER     flag_openssl_symmetric_key_derivation: Option<String>,
USER     flag_openssl_symmetric_key_iterations: Option<String>,
USER     flag_output_file: Option<String>,
USER ) -> Result<ExportArgs, Error> {
USER     let identity_type = resolve_identity_type(
USER         flag_identity_type,
USER         flag_openssl_pkey_type,
USER         flag_openssl_pkey_id,
USER         flag_openssl_symmetric_key_id,
USER         flag_openssl_symmetric_key_derivation,
USER         flag_openssl_symmetric_key_iterations,
USER     )?;
USER 
USER     let output_file = flag_output_file.ok_or_else(|| Error::argument_error(
USER         "--output-file is required for export secret".to_string()
USER     ))?;
USER 
USER     Ok(ExportArgs {
USER         identity_type,
USER         output_file,
USER         nix_crypto_args,
USER     })
USER }
USER 
USER /// Runs the `export secret` subcommand.
USER ///
USER /// Constructs a [`CryptoNix`] instance from the sled store configuration,
USER /// retrieves (or generates) the secret identified by [`ExportArgs::identity_type`],
USER /// and writes it to [`ExportArgs::output_file`].
USER ///
USER /// - For `openssl-pkey`: retrieves the private key and writes it as PEM.
USER /// - For `openssl-symmetric-key`: retrieves the passphrase (random secret) and
USER ///   writes it as a plain string.
USER pub fn run_secret(args: ExportArgs) -> Result<(), Error> {
USER 
USER     let crypto_nix = args.nix_crypto_args.init()?;
USER 
USER     match args.identity_type {
USER         IdentityType::OpensslPkey { pkey_type, pkey_id } => {
USER             let identity = OpensslPkeyIdentity { pkey_type, pkey_id };
USER 
USER             let key = crypto_nix
USER                 .openssl_private_key(&identity)
USER                 .map_err(|e| Error::argument_error(format!("Failed to obtain private key: {}", e)))?;
USER 
USER             let pem_bytes = key
USER                 .key_to_pem()
USER                 .map_err(|e| Error::argument_error(format!("Failed to convert key to PEM: {}", e)))?;
USER 
USER             let pem_string = String::from_utf8(pem_bytes)
USER                 .map_err(|e| Error::argument_error(format!("Failed to convert PEM bytes to string: {}", e)))?;
USER 
USER             std::fs::write(&args.output_file, pem_string)
USER                 .map_err(|e| Error::argument_error(format!("Failed to write key to '{}': {}", args.output_file, e)))?;
USER 
USER             println!("Successfully exported private key to '{}'", args.output_file);
USER             Ok(())
USER         }
USER         IdentityType::OpensslSymmetricKey { key_id, key_derivation, iterations } => {
USER             let identity = OpensslSymmetricKeyIdentity { key_id, key_derivation, iterations };
USER 
USER             let passphrase = crypto_nix
USER                 .openssl_symmetric_key_passphrase(&identity)
USER                 .map_err(|e| Error::argument_error(format!("Failed to obtain symmetric key passphrase: {}", e)))?;
USER 
USER             std::fs::write(&args.output_file, passphrase)
USER                 .map_err(|e| Error::argument_error(format!("Failed to write passphrase to '{}': {}", args.output_file, e)))?;
USER 
USER             println!("Successfully exported symmetric key passphrase to '{}'", args.output_file);
USER             Ok(())
USER         }
USER     }
USER }
USER ```
USER 
USER nix-crypto-core/src/openssl/export.rs
USER ```
USER use openssl::encrypt::Encrypter;
USER use openssl::pkey::PKey;
USER use openssl::rsa::Padding;
USER use openssl::symm::{encrypt, Cipher};
USER use openssl::rand::rand_bytes;
USER use base64::engine::general_purpose::STANDARD;
USER use base64::Engine;
USER 
USER use crate::error::Error;
USER use crate::foundations::{CryptoNix, IsCryptoStoreKeyDerivable};
USER use crate::store::{IsCryptoStoreKey, StoreHasher};
USER use crate::support::Exportable;
USER use crate::openssl::pkey::{IsOpensslPrivateKeyIdentity, Key, OpensslPrivateKeyIdentityWrapper};
USER 
USER // The result of asymmetric encryption, storing the RSA-OAEP encrypted
USER // symmetric key and the IV-prepended AES-256-CBC ciphertext.
USER struct AsymmetricEncryptionResult {
USER     encrypted_key: Vec<u8>,
USER     iv_and_ciphertext: Vec<u8>,
USER }
USER 
USER struct AsymmetricEncryptionRequest<Cred>
USER where
USER     Cred: IsCryptoStoreKeyDerivable,
USER     Cred::Value: Exportable,
USER {
USER     store_key: Vec<u8>,
USER     pkey: Key,
USER     credential: Cred::Value,
USER }
USER 
USER impl<C> IsCryptoStoreKey for AsymmetricEncryptionRequest<C>
USER where
USER     C: IsCryptoStoreKeyDerivable,
USER     C::Value: Exportable,
USER {
USER     type Value = AsymmetricEncryptionResult;
USER 
USER     fn to_store_key_raw(&self, _hasher: StoreHasher) -> Vec<u8> {
USER         self.store_key.clone()
USER     }
USER 
USER     fn to_store_value_raw(value: &Self::Value) -> Result<Vec<u8>, Error> {
USER         let key_len = value.encrypted_key.len() as u32;
USER         let mut result = Vec::new();
USER         result.extend_from_slice(&key_len.to_be_bytes());
USER         result.extend_from_slice(&value.encrypted_key);
USER         result.extend_from_slice(&value.iv_and_ciphertext);
USER         Ok(result)
USER     }
USER 
USER     fn from_store_value_raw(value: &Vec<u8>) -> Result<Self::Value, Error> {
USER         if value.len() < 4 {
USER             return Err(Error::CryptoNixError(
USER                 "AsymmetricEncryptionResult: stored value too short".to_string()
USER             ));
USER         }
USER         let key_len = u32::from_be_bytes([value[0], value[1], value[2], value[3]]) as usize;
USER         if value.len() < 4 + key_len {
USER             return Err(Error::CryptoNixError(
USER                 "AsymmetricEncryptionResult: stored value truncated".to_string()
USER             ));
USER         }
USER         let encrypted_key = value[4..4 + key_len].to_vec();
USER         let iv_and_ciphertext = value[4 + key_len..].to_vec();
USER         Ok(AsymmetricEncryptionResult { encrypted_key, iv_and_ciphertext })
USER     }
USER }
USER 
USER impl<C> IsCryptoStoreKeyDerivable for AsymmetricEncryptionRequest<C>
USER where
USER     C: IsCryptoStoreKeyDerivable,
USER     C::Value: Exportable,
USER {
USER     fn derive(&self) -> Result<AsymmetricEncryptionResult, Error> {
USER         // Export the credential to bytes.
USER         let credential_bytes = self.credential.export()?;
USER 
USER         // Generate a random 256-bit (32 byte) AES symmetric key.
USER         let mut sym_key = vec![0u8; 32];
USER         rand_bytes(&mut sym_key)?;
USER 
USER         // Generate a random 128-bit (16 byte) IV for AES-256-CBC.
USER         let mut iv = vec![0u8; 16];
USER         rand_bytes(&mut iv)?;
USER 
USER         // Encrypt the credential bytes with AES-256-CBC.
USER         let cipher = Cipher::aes_256_cbc();
USER         let ciphertext = encrypt(cipher, &sym_key, Some(&iv), &credential_bytes)?;
USER 
USER         // Prepend the IV to the ciphertext.
USER         let mut iv_and_ciphertext = iv;
USER         iv_and_ciphertext.extend_from_slice(&ciphertext);
USER 
USER         // Encrypt the symmetric key with RSA-OAEP using the asymmetric public key.
USER         let pkey_ref = PKey::from_rsa(self.pkey.pkey.rsa()?)?;
USER         let mut encrypter = Encrypter::new(&pkey_ref)?;
USER         encrypter.set_rsa_padding(Padding::PKCS1_OAEP)?;
USER 
USER         let buffer_len = encrypter.encrypt_len(&sym_key)?;
USER         let mut encrypted_key = vec![0u8; buffer_len];
USER         let actual_len = encrypter.encrypt(&sym_key, &mut encrypted_key)?;
USER         encrypted_key.truncate(actual_len);
USER 
USER         Ok(AsymmetricEncryptionResult {
USER             encrypted_key,
USER             iv_and_ciphertext,
USER         })
USER     }
USER }
USER 
USER /// Encode a byte slice as a PEM block with the given label.
USER fn encode_pem(label: &str, data: &[u8]) -> String {
USER     let encoded = STANDARD.encode(data);
USER     // Split base64 into 64-character lines as per PEM convention.
USER     let lines: Vec<&str> = encoded
USER         .as_bytes()
USER         .chunks(64)
USER         .map(|chunk| std::str::from_utf8(chunk).unwrap())
USER         .collect();
USER     format!(
USER         "-----BEGIN {}-----\n{}\n-----END {}-----\n",
USER         label,
USER         lines.join("\n"),
USER         label
USER     )
USER }
USER 
USER pub fn export_encrypted<K, C>(
USER     crypto_nix: &CryptoNix,
USER     key: &K,
USER     credential: &C,
USER ) -> Result<String, Error>
USER where
USER     K: IsOpensslPrivateKeyIdentity,
USER     C: IsCryptoStoreKeyDerivable,
USER     C::Value: Exportable,
USER {
USER     // Resolve the asymmetric key using get_or_derive.
USER     let pkey_wrapper = OpensslPrivateKeyIdentityWrapper(key);
USER     let pkey = crypto_nix.get_or_derive(&pkey_wrapper)?;
USER 
USER     // Resolve the credential using get_or_derive.
USER     let resolved_credential = crypto_nix.get_or_derive(credential)?;
USER 
USER     // Compute the store key by hashing the asymmetric key identity and
USER     // credential identity together using StoreHasher.
USER     let mut hasher = StoreHasher::init(crypto_nix.salt());
USER     hasher.update(b"asymmetric_encryption");
USER     hasher.update_with_identity(&pkey_wrapper);
USER     hasher.update_with_identity(credential);
USER     let store_key = Vec::from(hasher.finish());
USER 
USER     // Construct the AsymmetricEncryptionKey struct.
USER     let asym_enc_key = AsymmetricEncryptionRequest::<C> {
USER         store_key,
USER         pkey,
USER         credential: resolved_credential,
USER     };
USER 
USER     // Get or compute the AsymmetricEncryptionResult.
USER     let result = crypto_nix.get_or_derive(&asym_enc_key)?;
USER 
USER     // PEM-encode the encrypted symmetric key.
USER     let encrypted_key_pem = encode_pem("ENCRYPTED KEY", &result.encrypted_key);
USER 
USER     // PEM-encode the IV-prepended ciphertext.
USER     let encrypted_data_pem = encode_pem("ENCRYPTED DATA", &result.iv_and_ciphertext);
USER 
USER     // Concatenate and return.
USER     Ok(format!("{}{}", encrypted_key_pem, encrypted_data_pem))
USER }
USER ```
USER 
USER nix-crypto-core/src/openssl/decryptable.rs
USER ```
USER use openssl::pkcs5::pbkdf2_hmac;
USER use openssl::hash::MessageDigest;
USER use openssl::symm::{encrypt, Cipher};
USER use openssl::rand::rand_bytes;
USER 
USER use base64::engine::general_purpose::STANDARD;
USER use base64::Engine;
USER 
USER use crate::error::Error;
USER use crate::foundations::{CryptoNix, IsCryptoStoreKeyDerivable};
USER use crate::store::{IsCryptoStoreKey, StoreHasher};
USER use crate::support::{Exportable};
USER 
USER #[repr(u8)]
USER #[derive(Debug, Clone, Copy, PartialEq, Eq)]
USER /// Enum that lists all the key derivation schemes supported
USER /// by Nix Crypto for exporting decryptable credentials.
USER pub enum KeyDerivation {
USER     PBKDF2 = 0
USER }
USER 
USER impl KeyDerivation {
USER 
USER     pub fn from_string(value: &String) -> Result<KeyDerivation, Error> {
USER         match value.to_lowercase().as_str() {
USER             "pbkdf2" => Ok(KeyDerivation::PBKDF2),
USER             _ => Error::fail_with(
USER                 format!("The given string '{}' is not a valid key derivation method.", value)
USER             )
USER         }
USER     }
USER 
USER     pub fn from_u8(value: u8) -> Result<KeyDerivation, Error> {
USER 
USER         if value == (KeyDerivation::PBKDF2 as u8) {
USER             Ok(KeyDerivation::PBKDF2)
USER         }
USER         else {
USER             Error::fail_with(format!("Cannot convert '{}' into a KeyDerivation", value))
USER         }
USER     }
USER }
USER 
USER // ============================================================================
USER // SymmetricKeyValue
USER // ============================================================================
USER 
USER /// The value stored in the `CryptoStore` for a symmetric key. Contains the
USER /// randomly generated secret, the key derivation scheme, and the iteration
USER /// count used for PBKDF2.
USER pub struct SymmetricKeyValue {
USER     pub random_secret: String,
USER     pub key_derivation: KeyDerivation,
USER     pub iterations: u32,
USER }
USER 
USER impl SymmetricKeyValue {
USER     /// Serialize to bytes as `<key_derivation>:<iterations>:<random_secret>`.
USER     fn to_bytes(&self) -> Vec<u8> {
USER         format!("{}:{}:{}", (self.key_derivation as u8).clone(), self.iterations, self.random_secret)
USER             .into_bytes()
USER     }
USER 
USER     /// Deserialize from bytes produced by `to_bytes`.
USER     fn from_bytes(bytes: &[u8]) -> Result<Self, Error> {
USER         let s = std::str::from_utf8(bytes)?;
USER 
USER         // Split into at most 3 parts so the random_secret can itself contain ':'
USER         let mut parts = s.splitn(3, ':');
USER 
USER         let key_derivation_u8 = parts
USER             .next()
USER             .ok_or_else(|| Error::from_message("Missing key_derivation in SymmetricKeyValue".to_string()))?
USER             .to_string()
USER             .parse::<u8>()
USER             .map_err(|_| Error::from_message("Invalid key derivaiton for value.".to_string()))?;
USER 
USER         let key_derivation = KeyDerivation::from_u8(key_derivation_u8)?;
USER 
USER         let iterations_str = parts
USER             .next()
USER             .ok_or_else(|| Error::from_message("Missing iterations in SymmetricKeyValue".to_string()))?;
USER 
USER         let iterations = iterations_str
USER             .parse::<u32>()
USER             .map_err(|_| Error::from_message(format!("Invalid iterations value: {}", iterations_str)))?;
USER 
USER         let random_secret = parts
USER             .next()
USER             .ok_or_else(|| Error::from_message("Missing random_secret in SymmetricKeyValue".to_string()))?
USER             .to_string();
USER 
USER         Ok(SymmetricKeyValue { random_secret, key_derivation, iterations })
USER     }
USER 
USER     /// Derive a key and IV from the passphrase and salt using PBKDF2-HMAC-SHA256.
USER     ///
USER     /// For AES-128-CBC, `openssl enc -pbkdf2` derives `key_len + iv_len` = 32 bytes
USER     /// total from the passphrase, then splits them: first 16 bytes are the key,
USER     /// last 16 bytes are the IV. We replicate that behaviour here so that the
USER     /// output is compatible with `openssl enc -d -aes-128-cbc -pbkdf2`.
USER     fn derive_key_and_iv(&self, salt: &[u8]) -> Result<(Vec<u8>, Vec<u8>), Error> {
USER         match self.key_derivation {
USER             KeyDerivation::PBKDF2 => {
USER                 let mut key_and_iv = vec![0u8; 32];
USER                 pbkdf2_hmac(
USER                     self.random_secret.as_bytes(),
USER                     salt,
USER                     self.iterations as usize,
USER                     MessageDigest::sha256(),
USER                     &mut key_and_iv,
USER                 )?;
USER                 let key = key_and_iv[..16].to_vec();
USER                 let iv  = key_and_iv[16..].to_vec();
USER                 Ok((key, iv))
USER             }
USER         }
USER     }
USER }
USER 
USER // ============================================================================
USER // IsOpensslSymmetricKeyIdentity
USER // ============================================================================
USER 
USER /// Identifies an OpenSSL symmetric key. Implementors provide the key identity,
USER /// derivation scheme, and PBKDF2 iteration count. The underlying
USER /// `SymmetricKeyValue` (including the random secret) is derived and stored
USER /// automatically.
USER pub trait IsOpensslSymmetricKeyIdentity {
USER     fn key_id(&self) -> &String;
USER     fn key_derivation(&self) -> &String;
USER     fn iterations(&self) -> u32;
USER }
USER 
USER /// A newtype wrapper around a reference to an arbitrary `IsOpensslSymmetricKeyIdentity`
USER /// instance. The `IsCrytpoStoreKeyDerivable` trait for symmetric key identites
USER /// is implemented through this type.
USER struct SymmetricKeyIdentity<'a, T: IsOpensslSymmetricKeyIdentity>(pub &'a T);
USER 
USER impl<'a, T : IsOpensslSymmetricKeyIdentity> IsCryptoStoreKey
USER for SymmetricKeyIdentity<'a, T> {
USER     type Value = SymmetricKeyValue;
USER 
USER     fn to_store_key_raw(&self, mut hasher: StoreHasher) -> Vec<u8> {
USER         let identity = self.0;
USER         let iterations = identity.iterations();
USER         hasher.update(identity.key_id().as_bytes());
USER         hasher.update(identity.key_derivation().as_bytes());
USER         hasher.update(&iterations.to_be_bytes());
USER         Vec::from(hasher.finish())
USER     }
USER 
USER     fn to_store_value_raw(value: &SymmetricKeyValue) -> Result<Vec<u8>, Error> {
USER         Ok(value.to_bytes())
USER     }
USER 
USER     fn from_store_value_raw(value: &Vec<u8>) -> Result<SymmetricKeyValue, Error> {
USER         SymmetricKeyValue::from_bytes(value)
USER     }
USER }
USER 
USER impl<'a, T: IsOpensslSymmetricKeyIdentity> IsCryptoStoreKeyDerivable
USER for SymmetricKeyIdentity<'a, T> {
USER     fn derive(&self) -> Result<SymmetricKeyValue, Error> {
USER         let mut random_bytes = vec![0u8; 16];
USER         rand_bytes(&mut random_bytes)?;
USER         let random_secret = STANDARD.encode(&random_bytes);
USER 
USER         Ok(SymmetricKeyValue {
USER             random_secret,
USER             key_derivation: KeyDerivation::from_string(&self.0.key_derivation())?,
USER             iterations: self.0.iterations(),
USER         })
USER     }
USER }
USER 
USER // ============================================================================
USER // EncryptionParams
USER // ============================================================================
USER 
USER /// Stores the salt used to encrypt a specific `(symmetric_key, credential)`
USER /// pair. By persisting this in the store we guarantee that calling
USER /// `export_decryptable` with the same key, credential, and store always
USER /// produces identical output.
USER ///
USER /// The IV is not stored separately — it is derived deterministically from the
USER /// passphrase and salt by PBKDF2, exactly as `openssl enc -pbkdf2` does.
USER pub struct EncryptionParams {
USER     pub salt: Vec<u8>,
USER }
USER 
USER impl EncryptionParams {
USER     fn generate() -> Result<Self, Error> {
USER         let mut salt = vec![0u8; 8];
USER         rand_bytes(&mut salt)?;
USER         Ok(EncryptionParams { salt })
USER     }
USER 
USER     /// Serialize as the raw salt bytes.
USER     fn to_bytes(&self) -> Vec<u8> {
USER         self.salt.clone()
USER     }
USER 
USER     fn from_bytes(bytes: &[u8]) -> Result<Self, Error> {
USER         if bytes.is_empty() {
USER             return Err(Error::from_message("EncryptionParams bytes are empty".to_string()));
USER         }
USER         Ok(EncryptionParams { salt: bytes.to_vec() })
USER     }
USER }
USER 
USER /// The store key for `EncryptionParams`. It is derived by hashing the raw
USER /// store keys of both the symmetric key identity and the credential identity,
USER /// making it unique per `(key, credential)` pair.
USER struct EncryptionParamsKey<'a, TKey, TCred> {
USER     symmetric_key_identity: &'a TKey,
USER     credential_identity: &'a TCred,
USER }
USER 
USER impl<'a, TKey, TCred> EncryptionParamsKey<'a, TKey, TCred> {
USER     pub fn new(symmetric_key_identity: &'a TKey, credential_identity: &'a TCred) -> Self {
USER         EncryptionParamsKey { symmetric_key_identity, credential_identity }
USER     }
USER }
USER 
USER impl<'a, TKey, TCred> IsCryptoStoreKey
USER for EncryptionParamsKey<'a, TKey, TCred>
USER where TKey : IsCryptoStoreKey, TCred : IsCryptoStoreKey {
USER     type Value = EncryptionParams;
USER 
USER     fn to_store_key_raw(&self, mut hasher: StoreHasher) -> Vec<u8> {
USER         hasher.update(b"encryption_params");
USER         hasher.update_with_identity(self.symmetric_key_identity);
USER         hasher.update_with_identity(self.credential_identity);
USER         Vec::from(hasher.finish())
USER     }
USER 
USER     fn to_store_value_raw(value: &EncryptionParams) -> Result<Vec<u8>, Error> {
USER         Ok(value.to_bytes())
USER     }
USER 
USER     fn from_store_value_raw(value: &Vec<u8>) -> Result<EncryptionParams, Error> {
USER         EncryptionParams::from_bytes(value)
USER     }
USER }
USER 
USER impl<'a, TKey, TCred> IsCryptoStoreKeyDerivable for EncryptionParamsKey<'a, TKey, TCred>
USER where TKey : IsCryptoStoreKey, TCred : IsCryptoStoreKey {
USER     fn derive(&self) -> Result<EncryptionParams, Error> {
USER         EncryptionParams::generate()
USER     }
USER }
USER 
USER // ============================================================================
USER // Encryption helpers
USER // ============================================================================
USER 
USER /// Encrypt `plaintext` with AES-128-CBC and return a PEM-encoded string
USER /// compatible with `openssl enc -d -aes-128-cbc -pbkdf2`.
USER ///
USER /// The key and IV are derived from the passphrase and salt using
USER /// PBKDF2-HMAC-SHA256, deriving 32 bytes total and splitting them into
USER /// a 16-byte key and a 16-byte IV — exactly as `openssl enc -pbkdf2` does.
USER ///
USER /// The payload layout matches the OpenSSL `enc` format:
USER ///   `Salted__` (8 bytes) | salt (8 bytes) | ciphertext
USER /// The whole payload is Base64-encoded and wrapped in a PEM envelope.
USER fn encrypt_to_pem(
USER     key: &SymmetricKeyValue,
USER     salt: &Vec<u8>,
USER     plaintext: &Vec<u8>
USER ) -> Result<String, Error> {
USER     let (aes_key, iv) = key.derive_key_and_iv(salt)?;
USER     let cipher = Cipher::aes_128_cbc();
USER     let ciphertext = encrypt(cipher, &aes_key, Some(&iv), plaintext)?;
USER 
USER     let mut payload = Vec::new();
USER     payload.extend_from_slice(b"Salted__");
USER     payload.extend_from_slice(salt);
USER     payload.extend_from_slice(&ciphertext);
USER 
USER     let b64 = STANDARD.encode(&payload);
USER 
USER     // Wrap Base64 at 64 characters per line, as is standard for PEM
USER     let pem_body = b64
USER         .as_bytes()
USER         .chunks(64)
USER         .map(|chunk| std::str::from_utf8(chunk).unwrap())
USER         .collect::<Vec<_>>()
USER         .join("\n");
USER 
USER     Ok(pem_body)
USER }
USER 
USER // ============================================================================
USER // export_decryptable
USER // ============================================================================
USER 
USER /// Export a credential encrypted with a symmetric key, returning a
USER /// PEM-formatted string containing the AES-128-CBC encrypted credential,
USER /// compatible with `openssl enc -d -aes-128-cbc -pbkdf2`.
USER ///
USER /// Calling this function multiple times with the same `key`, `credential`,
USER /// and store will always produce identical output, because the salt is
USER /// stored in the `CryptoStore` on the first call and reused thereafter.
USER pub fn export_decryptable<K, C>(
USER     crypto_nix: &CryptoNix,
USER     key: &K,
USER     credential: &C,
USER ) -> Result<String, Error>
USER where
USER     K: IsOpensslSymmetricKeyIdentity,
USER     C: IsCryptoStoreKeyDerivable,
USER     C::Value: Exportable,
USER {
USER     // Step 1: Wrap the key in a SymmetricKeyIdentity and get or derive the
USER     // symmetric key value (random_secret, derivation, iterations).
USER     let symmetric_identity = SymmetricKeyIdentity(key);
USER     let symmetric_key_value = crypto_nix.get_or_derive(&symmetric_identity)?;
USER 
USER     // Step 2: Get or derive the credential value.
USER     let credential_value = crypto_nix.get_or_derive(credential)?;
USER 
USER     // Step 3: Get or derive the encryption params (salt) for this
USER     // (key, credential) pair. Using a unique salt per pair ensures that
USER     // encrypting the same credential with different keys produces different
USER     // ciphertext, preventing IV reuse.
USER     let encryption_params_key = EncryptionParamsKey::new(&symmetric_identity, credential);
USER     let encryption_params = crypto_nix.get_or_derive(&encryption_params_key)?;
USER 
USER     // Step 4: Export the credential to plaintext bytes.
USER     let plaintext = credential_value.export()?;
USER 
USER     // Step 5: Encrypt and return as PEM.
USER     encrypt_to_pem(
USER         &symmetric_key_value,
USER         &encryption_params.salt,
USER         &plaintext
USER     )
USER }
USER 
USER // ============================================================================
USER // get_symmetric_key_passphrase
USER // ============================================================================
USER 
USER /// Retrieve (or derive and store) the random passphrase for the symmetric key
USER /// identified by `key`. Returns the `random_secret` string which is the
USER /// passphrase used as input to the key derivation function.
USER ///
USER /// Calling this function multiple times with the same `key` and store will
USER /// always return the same passphrase, because the `SymmetricKeyValue` is
USER /// stored on the first call and reused thereafter.
USER pub fn get_symmetric_key_passphrase<K: IsOpensslSymmetricKeyIdentity>(
USER     crypto_nix: &CryptoNix,
USER     key: &K,
USER ) -> Result<String, Error> {
USER     let symmetric_identity = SymmetricKeyIdentity(key);
USER     let value = crypto_nix.get_or_derive(&symmetric_identity)?;
USER     Ok(value.random_secret)
USER }
USER ```
USER 
USER crypto/openssl/main.nix
USER ```
USER /**
USER   OpenSSL cryptographic operations for nix-crypto.
USER */
USER { pkgs, prelude, private-key-spec-type, x509-params-type, export-decryptable-pkey-params-type, ... }@module:
USER let
USER   inherit (pkgs) lib;
USER   inherit (lib) types;
USER   inherit (builtins.crypto) openssl;
USER   type-checker = prelude.type-checker { };
USER 
USER   /**
USER     Produces a deterministic key identity string from an attribute set.
USER     Keys are sorted alphabetically and joined as `key=value` pairs separated
USER     by `&`. For example, `{ vault = "openssl"; name = "my-key"; }` produces
USER     `"name=my-key&vault=openssl"`.
USER 
USER     This string is used by both the nix-crypto plugin (to store the key) and
USER     `nix-crypto-service` (to look it up). The sort order ensures the identity
USER     is stable regardless of the order in which `attrs` is defined in nix.
USER   */
USER   to-key-identity = attrs:
USER     let
USER       keys = lib.sort (a: b: a < b) (lib.attrNames attrs);
USER       mk-entry = k:
USER         let
USER           value = attrs.${k};
USER         in
USER           "${k}=${value}"
USER       ;
USER     in
USER       lib.concatStringsSep "&" (lib.map mk-entry keys)
USER   ;
USER 
USER   /**
USER     Build an X.509 certificate signed by the given private key.
USER     Returns an attribute set with:
USER     - `certificate-pem`: the certificate in PEM format.
USER   */
USER   x509 = { key-ref, x509-params }:
USER   let
USER     x509-params-all =
USER       x509-params
USER       // { signing-private-key-identity = key-ref; }
USER     ;
USER   in
USER     {
USER       certificate-pem = openssl.x509-pem x509-params-all;
USER     }
USER   ;
USER 
USER   /**
USER     Export a private key credential encrypted with the given symmetric key.
USER     Returns a PEM-formatted string containing the AES-128-CBC encrypted
USER     private key.
USER 
USER     The same inputs (symmetric-key-params, key-ref, store) will always
USER     produce identical output, as the salt and IV are persisted in the store
USER     on the first call and reused thereafter.
USER   */
USER   export-decryptable-pkey = { key-ref, symmetric-key-params }:
USER   let
USER     key-id = to-key-identity symmetric-key-params.attrs;
USER     params = {
USER       inherit key-id;
USER       inherit (symmetric-key-params) key-derivation iterations;
USER     };
USER   in
USER     {
USER       inherit key-id;
USER       ciphertext-base64 = openssl.export-decryptable-pkey params key-ref;
USER     }
USER   ;
USER 
USER   /**
USER     Retrieve or generate an OpenSSL private key.
USER     Accepts a `key-spec` with:
USER     - `attrs`: an attribute set of key-value pairs used to construct the key
USER       identity string (e.g. `{ vault = "openssl"; name = "my-key"; }`).
USER     - `type`: the key type string (e.g. `"rsa"`).
USER 
USER     Returns an attribute set with:
USER     - `identity`: the key identity string produced by `to-key-identity`. Exposed
USER       so that callers (e.g. `nix-crypto-service`) can locate the key in the
USER       sled store without reconstructing the identity manually.
USER     - `public-key-pem`: the public key in PEM format, computed by the nix plugin.
USER     - `x509`: a function to build X.509 certificates signed by this key.
USER     - `export-decryptable-pkey`: a function to export this private key encrypted
USER       with a symmetric key.
USER     - `export-encrypted-pkey-pkey`: a function to export this private key encrypted
USER       with another private key.
USER   */
USER   private-key-impl = key-spec:
USER   let
USER     key-ref = {
USER       key-identity = to-key-identity key-spec.attrs;
USER       key-type = key-spec.type;
USER     };
USER   in
USER     {
USER       inherit key-spec;
USER       identity = key-ref.key-identity;
USER       public-key-pem = openssl.public-key-pem key-ref;
USER       x509 =
USER         type-checker.function
USER         [ { name = "x509-params"; type = x509-params-type; } ]
USER         (x509-params: x509 { inherit key-ref x509-params; })
USER       ;
USER       export-decryptable-pkey =
USER         type-checker.function
USER         [ { name = "symmetric-key-params"; type = export-decryptable-pkey-params-type; } ]
USER         (symmetric-key-params: export-decryptable-pkey { inherit key-ref symmetric-key-params; })
USER       ;
USER       export-encrypted-pkey-pkey =
USER         type-checker.function
USER         [ { name = "credential-spec"; type = private-key-spec-type; } ]
USER         (credential-spec: {
USER           ciphertext-base64 = openssl.export-encrypted-pkey-pkey key-ref {
USER             key-identity = to-key-identity credential-spec.attrs;
USER             key-type = credential-spec.type;
USER           };
USER         })
USER       ;
USER     }
USER   ;
USER 
USER   private-key =
USER     type-checker.function
USER     [ { name = "key-spec"; type = private-key-spec-type; } ]
USER     private-key-impl
USER   ;
USER in
USER   { inherit private-key; }
USER ```
