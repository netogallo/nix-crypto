ASSISTANT ```
ASSISTANT /**
ASSISTANT   OpenSSL cryptographic operations for nix-crypto.
ASSISTANT */
ASSISTANT { pkgs, prelude, private-key-spec-type, x509-params-type, export-decryptable-pkey-params-type, ... }@module:
ASSISTANT let
ASSISTANT   inherit (pkgs) lib;
ASSISTANT   inherit (lib) types;
ASSISTANT   inherit (builtins.crypto) openssl;
ASSISTANT   type-checker = prelude.type-checker { };
ASSISTANT 
ASSISTANT   /**
ASSISTANT     Produces a deterministic key identity string from an attribute set.
ASSISTANT     Keys are sorted alphabetically and joined as `key=value` pairs separated
ASSISTANT     by `&`. For example, `{ vault = "openssl"; name = "my-key"; }` produces
ASSISTANT     `"name=my-key&vault=openssl"`.
ASSISTANT 
ASSISTANT     This string is used by both the nix-crypto plugin (to store the key) and
ASSISTANT     `nix-crypto-service` (to look it up). The sort order ensures the identity
ASSISTANT     is stable regardless of the order in which `attrs` is defined in nix.
ASSISTANT   */
ASSISTANT   to-key-identity = attrs:
ASSISTANT     let
ASSISTANT       keys = lib.sort (a: b: a < b) (lib.attrNames attrs);
ASSISTANT       mk-entry = k:
ASSISTANT         let
ASSISTANT           value = attrs.${k};
ASSISTANT         in
ASSISTANT           "${k}=${value}"
ASSISTANT       ;
ASSISTANT     in
ASSISTANT       lib.concatStringsSep "&" (lib.map mk-entry keys)
ASSISTANT   ;
ASSISTANT 
ASSISTANT   /**
ASSISTANT     Build an X.509 certificate signed by the given private key.
ASSISTANT     Returns an attribute set with:
ASSISTANT     - `certificate-pem`: the certificate in PEM format.
ASSISTANT   */
ASSISTANT   x509 = { key-ref, x509-params }:
ASSISTANT   let
ASSISTANT     x509-params-all =
ASSISTANT       x509-params
ASSISTANT       // { signing-private-key-identity = key-ref; }
ASSISTANT     ;
ASSISTANT   in
ASSISTANT     {
ASSISTANT       certificate-pem = openssl.x509-pem x509-params-all;
ASSISTANT     }
ASSISTANT   ;
ASSISTANT 
ASSISTANT   /**
ASSISTANT     Export a private key credential encrypted with the given symmetric key.
ASSISTANT     Returns a PEM-formatted string containing the AES-128-CBC encrypted
ASSISTANT     private key.
ASSISTANT 
ASSISTANT     The same inputs (symmetric-key-params, key-ref, store) will always
ASSISTANT     produce identical output, as the salt and IV are persisted in the store
ASSISTANT     on the first call and reused thereafter.
ASSISTANT   */
ASSISTANT   export-decryptable-pkey = { key-ref, symmetric-key-params }:
ASSISTANT   let
ASSISTANT     key-id = to-key-identity symmetric-key-params.attrs;
ASSISTANT     params = {
ASSISTANT       inherit key-id;
ASSISTANT       inherit (symmetric-key-params) key-derivation iterations;
ASSISTANT     };
ASSISTANT   in
ASSISTANT     {
ASSISTANT       inherit key-id;
ASSISTANT       ciphertext-base64 = openssl.export-decryptable-pkey params key-ref;
ASSISTANT     }
ASSISTANT   ;
ASSISTANT 
ASSISTANT   /**
ASSISTANT     Retrieve or generate an OpenSSL private key.
ASSISTANT     Accepts a `key-spec` with:
ASSISTANT     - `attrs`: an attribute set of key-value pairs used to construct the key
ASSISTANT       identity string (e.g. `{ vault = "openssl"; name = "my-key"; }`).
ASSISTANT     - `type`: the key type string (e.g. `"rsa"`).
ASSISTANT 
ASSISTANT     Returns an attribute set with:
ASSISTANT     - `identity`: the key identity string produced by `to-key-identity`. Exposed
ASSISTANT       so that callers (e.g. `nix-crypto-service`) can locate the key in the
ASSISTANT       sled store without reconstructing the identity manually.
ASSISTANT     - `public-key-pem`: the public key in PEM format, computed by the nix plugin.
ASSISTANT     - `x509`: a function to build X.509 certificates signed by this key.
ASSISTANT     - `export-decryptable-pkey`: a function to export this private key encrypted
ASSISTANT       with a symmetric key.
ASSISTANT     - `export-encrypted-pkey-pkey`: a function to export this private key encrypted
ASSISTANT       with another private key.
ASSISTANT   */
ASSISTANT   private-key-impl = key-spec:
ASSISTANT   let
ASSISTANT     key-ref = {
ASSISTANT       key-identity = to-key-identity key-spec.attrs;
ASSISTANT       key-type = key-spec.type;
ASSISTANT     };
ASSISTANT   in
ASSISTANT     {
ASSISTANT       identity = key-ref.key-identity;
ASSISTANT       public-key-pem = openssl.public-key-pem key-ref;
ASSISTANT       x509 =
ASSISTANT         type-checker.function
ASSISTANT         [ { name = "x509-params"; type = x509-params-type; } ]
ASSISTANT         (x509-params: x509 { inherit key-ref x509-params; })
ASSISTANT       ;
ASSISTANT       export-decryptable-pkey =
ASSISTANT         type-checker.function
ASSISTANT         [ { name = "symmetric-key-params"; type = export-decryptable-pkey-params-type; } ]
ASSISTANT         (symmetric-key-params: export-decryptable-pkey { inherit key-ref symmetric-key-params; })
ASSISTANT       ;
ASSISTANT       export-encrypted-pkey-pkey =
