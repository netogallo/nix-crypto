USER //! Implements the `export secret` subcommand of `nix-crypto-service`.
USER //!
USER //! ## Overview
USER //!
USER //! This module resolves the CLI arguments for `export secret`, constructs a
USER //! [`CryptoNix`] instance from the sled store configuration, retrieves (or
USER //! generates) the requested private key or symmetric key passphrase, and writes
USER //! it to a file.
USER //!
USER //! ## Store resolution
USER //!
USER //! The sled store path is resolved from either:
USER //! - The `--sled-store` CLI flag, or
USER //! - The `NIX_CRYPTO_STORE` environment variable, which must be set to
USER //!   `sled:<path>`.
USER //!
USER //! ## Key identity
USER //!
USER //! The key identity string passed via `--openssl-pkey-id` must match exactly
USER //! the identity string produced by the nix-crypto plugin when the key was
USER //! stored. The identity string is produced by `to-key-identity` in
USER //! `crypto/openssl/main.nix`, which sorts the `attrs` keys alphabetically and
USER //! joins them as `key=value` pairs separated by `&`. For example:
USER //! `{ vault = "openssl"; name = "my-key"; }` → `"name=my-key&vault=openssl"`.
USER //! The `identity` field on the nix private key object exposes this string
USER //! directly so callers do not need to reconstruct it manually.
USER 
USER use nix_crypto_core::openssl::ffi::IsOpensslPrivateKeyIdentity;
USER use nix_crypto_core::openssl::decryptable::IsOpensslSymmetricKeyIdentity;
USER 
USER use crate::common::{Error, NixCryptoArgs};
USER 
USER /// The supported identity types for the `export secret` subcommand.
USER pub enum IdentityType {
USER     /// An OpenSSL private key identity, identified by key type and key id.
USER     ///
USER     /// - `pkey_type`: the key type (e.g. `"rsa"`).
USER     /// - `pkey_id`: the key identity string (e.g. `"name=my-key&vault=openssl"`).
USER     OpensslPkey {
USER         pkey_type: String,
USER         pkey_id: String,
USER     },
USER     /// An OpenSSL symmetric key identity. The passphrase (random secret) for
USER     /// this key will be retrieved from the store and written to the output file.
USER     ///
USER     /// - `key_id`: a unique identifier for the symmetric key.
USER     /// - `key_derivation`: the key derivation scheme (e.g. `"pbkdf2"`).
USER     /// - `iterations`: the number of iterations for the key derivation function.
USER     OpensslSymmetricKey {
USER         key_id: String,
USER         key_derivation: String,
USER         iterations: u32,
USER     },
USER }
USER 
USER /// The resolved arguments for the `export secret` subcommand.
USER pub struct ExportArgs {
USER     /// The identity of the secret to export.
USER     pub identity_type: IdentityType,
USER     /// The file path to write the exported secret to.
USER     pub output_file: String,
USER     /// The arguments used to build the `CryptoNix` instance.
USER     pub nix_crypto_args: NixCryptoArgs,
USER }
USER 
USER struct OpensslPkeyIdentity {
USER     pkey_type: String,
USER     pkey_id: String,
USER }
USER 
USER impl IsOpensslPrivateKeyIdentity for OpensslPkeyIdentity {
USER     fn key_type(&self) -> &String {
USER         &self.pkey_type
USER     }
USER 
USER     fn key_id(&self) -> &String {
USER         &self.pkey_id
USER     }
USER }
USER 
USER struct OpensslSymmetricKeyIdentity {
USER     key_id: String,
USER     key_derivation: String,
USER     iterations: u32,
USER }
USER 
USER impl IsOpensslSymmetricKeyIdentity for OpensslSymmetricKeyIdentity {
USER     fn key_id(&self) -> &String {
USER         &self.key_id
USER     }
USER 
USER     fn key_derivation(&self) -> &String {
USER         &self.key_derivation
USER     }
USER 
USER     fn iterations(&self) -> u32 {
USER         self.iterations
USER     }
USER }
USER 
USER const DEFAULT_KEY_DERIVATION: &str = "pbkdf2";
USER const DEFAULT_ITERATIONS: u32 = 600_000;
USER 
USER /// Resolves the identity type from the `--identity-type`, `--openssl-pkey-type`,
USER /// `--openssl-pkey-id`, `--openssl-symmetric-key-id`,
USER /// `--openssl-symmetric-key-derivation` and `--openssl-symmetric-key-iterations`
USER /// flags. Supported identity types are `openssl-pkey` and `openssl-symmetric-key`.
USER fn resolve_identity_type(
USER     flag_identity_type: Option<String>,
USER     flag_openssl_pkey_type: Option<String>,
USER     flag_openssl_pkey_id: Option<String>,
USER     flag_openssl_symmetric_key_id: Option<String>,
USER     flag_openssl_symmetric_key_derivation: Option<String>,
USER     flag_openssl_symmetric_key_iterations: Option<String>,
USER ) -> Result<IdentityType, Error> {
USER     match flag_identity_type.as_deref() {
USER         Some("openssl-pkey") => {
USER             let pkey_type = flag_openssl_pkey_type.ok_or_else(|| Error::argument_error(
USER                 "--openssl-pkey-type is required when --identity-type is 'openssl-pkey'".to_string()
USER             ))?;
USER             let pkey_id = flag_openssl_pkey_id.ok_or_else(|| Error::argument_error(
USER                 "--openssl-pkey-id is required when --identity-type is 'openssl-pkey'".to_string()
USER             ))?;
USER             Ok(IdentityType::OpensslPkey { pkey_type, pkey_id })
USER         }
USER         Some("openssl-symmetric-key") => {
USER             let key_id = flag_openssl_symmetric_key_id.ok_or_else(|| Error::argument_error(
USER                 "--openssl-symmetric-key-id is required when --identity-type is 'openssl-symmetric-key'".to_string()
USER             ))?;
USER             let key_derivation = flag_openssl_symmetric_key_derivation
USER                 .unwrap_or_else(|| DEFAULT_KEY_DERIVATION.to_string());
USER             let iterations = match flag_openssl_symmetric_key_iterations {
USER                 None => DEFAULT_ITERATIONS,
USER                 Some(s) => s.parse::<u32>().map_err(|_| Error::argument_error(
USER                     format!("--openssl-symmetric-key-iterations must be a positive integer, got '{}'", s)
USER                 ))?,
USER             };
USER             Ok(IdentityType::OpensslSymmetricKey { key_id, key_derivation, iterations })
USER         }
USER         Some(other) => Err(Error::argument_error(format!(
USER             "Unrecognised identity type '{}'. Supported types are: openssl-pkey, openssl-symmetric-key",
USER             other
USER         ))),
USER         None => Err(Error::argument_error(
USER             "--identity-type is required for export secret".to_string()
USER         )),
USER     }
USER }
USER 
USER /// Resolves all CLI flags into an [`ExportArgs`] struct.
USER pub fn resolve_args(
USER     nix_crypto_args: NixCryptoArgs,
USER     flag_identity_type: Option<String>,
USER     flag_openssl_pkey_type: Option<String>,
USER     flag_openssl_pkey_id: Option<String>,
USER     flag_openssl_symmetric_key_id: Option<String>,
USER     flag_openssl_symmetric_key_derivation: Option<String>,
USER     flag_openssl_symmetric_key_iterations: Option<String>,
USER     flag_output_file: Option<String>,
USER ) -> Result<ExportArgs, Error> {
USER     let identity_type = resolve_identity_type(
USER         flag_identity_type,
USER         flag_openssl_pkey_type,
USER         flag_openssl_pkey_id,
USER         flag_openssl_symmetric_key_id,
USER         flag_openssl_symmetric_key_derivation,
USER         flag_openssl_symmetric_key_iterations,
USER     )?;
USER 
USER     let output_file = flag_output_file.ok_or_else(|| Error::argument_error(
USER         "--output-file is required for export secret".to_string()
USER     ))?;
USER 
USER     Ok(ExportArgs {
USER         identity_type,
USER         output_file,
USER         nix_crypto_args,
USER     })
USER }
USER 
USER /// Runs the `export secret` subcommand.
USER ///
USER /// Constructs a [`CryptoNix`] instance from the sled store configuration,
USER /// retrieves (or generates) the secret identified by [`ExportArgs::identity_type`],
USER /// and writes it to [`ExportArgs::output_file`].
USER ///
USER /// - For `openssl-pkey`: retrieves the private key and writes it as PEM.
USER /// - For `openssl-symmetric-key`: retrieves the passphrase (random secret) and
USER ///   writes it as a plain string.
USER pub fn run_secret(args: ExportArgs) -> Result<(), Error> {
USER 
USER     let crypto_nix = args.nix_crypto_args.init()?;
USER 
USER     match args.identity_type {
USER         IdentityType::OpensslPkey { pkey_type, pkey_id } => {
USER             let identity = OpensslPkeyIdentity { pkey_type, pkey_id };
USER 
USER             let key = crypto_nix
USER                 .openssl_private_key(&identity)
USER                 .map_err(|e| Error::argument_error(format!("Failed to obtain private key: {}", e)))?;
USER 
USER             let pem_bytes = key
USER                 .key_to_pem()
USER                 .map_err(|e| Error::argument_error(format!("Failed to convert key to PEM: {}", e)))?;
USER 
USER             let pem_string = String::from_utf8(pem_bytes)
USER                 .map_err(|e| Error::argument_error(format!("Failed to convert PEM bytes to string: {}", e)))?;
USER 
USER             std::fs::write(&args.output_file, pem_string)
USER                 .map_err(|e| Error::argument_error(format!("Failed to write key to '{}': {}", args.output_file, e)))?;
USER 
USER             println!("Successfully exported private key to '{}'", args.output_file);
USER             Ok(())
USER         }
USER         IdentityType::OpensslSymmetricKey { key_id, key_derivation, iterations } => {
USER             let identity = OpensslSymmetricKeyIdentity { key_id, key_derivation, iterations };
USER 
USER             let passphrase = crypto_nix
USER                 .openssl_symmetric_key_passphrase(&identity)
USER                 .map_err(|e| Error::argument_error(format!("Failed to obtain symmetric key passphrase: {}", e)))?;
USER 
USER             std::fs::write(&args.output_file, passphrase)
USER                 .map_err(|e| Error::argument_error(format!("Failed to write passphrase to '{}': {}", args.output_file, e)))?;
USER 
USER             println!("Successfully exported symmetric key passphrase to '{}'", args.output_file);
USER             Ok(())
USER         }
USER     }
USER }
USER ```
