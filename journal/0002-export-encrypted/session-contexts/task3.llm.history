USER test/openssl.nix
USER ```
USER /**
USER   Test suite for OpenSSL functionality.
USER 
USER   Accepts the following arguments:
USER   - `pkgs`: the nixpkgs package set.
USER   - `nix-crypto-service`: path to the `nix-crypto-service` binary.
USER */
USER { pkgs, nix-crypto-service, ... }:
USER let
USER   crypto = pkgs.callPackage ../crypto/default.nix {};
USER   inherit (crypto) openssl;
USER 
USER   # Generates an RSA key or returns the existing one from the store.
USER   # The private key itself is not returned — only operations that can
USER   # be performed with it.
USER   pk-rsa = openssl.private-key {
USER     attrs = {
USER       vault = "openssl";
USER       name = "openssl-test-key";
USER     };
USER     type = "rsa";
USER   };
USER 
USER   # Symmetric key parameters used to encrypt the private key.
USER   # The same parameters must be passed to nix-crypto-service when
USER   # retrieving the passphrase.
USER   symmetric-key-params = {
USER     attrs = { key-id = "openssl-test-symmetric-key"; };
USER     key-derivation = "pbkdf2";
USER     iterations = 600000;
USER   };
USER 
USER   # This contains the private key encrypted using a symmetric
USER   # key derived from the `symmetric-key-params`
USER   encrypted-pk-rsa = pk-rsa.export-decryptable-pkey symmetric-key-params;
USER 
USER   # A second private key to test encryption with export-encrypted-pkey-pkey
USER   credential-key = openssl.private-key {
USER     attrs = {
USER       vault = "openssl";
USER       name = "credential-test-key";
USER     };
USER     type = "rsa";
USER   };
USER 
USER   # Encrypt the credential-key using pk-rsa
USER   encrypted-credential = pk-rsa.export-encrypted-pkey-pkey credential-key.key-spec;
USER in
USER   {
USER     # Asserts that the plugin can generate or retrieve a public key in PEM format.
USER     "It can generate a public/private key set" = { _assert, ... }:
USER       _assert.is-string pk-rsa.public-key-pem
USER     ;
USER 
USER     # Asserts that the plugin can build a self-signed X.509 certificate
USER     # signed by the RSA key.
USER     "It can generate a x509 self-signed certificate" = { _assert, ... }:
USER     let
USER       x509 = pk-rsa.x509 {
USER         subject-name = { CN = "subject"; };
USER         issuer-name = { CN = "issuer"; };
USER         serial = 1;
USER         start-date = "2026-01-09T21:29:36Z";
USER         expiry-date = "2036-01-09T21:29:36Z";
USER       };
USER     in
USER       # Derivation which outputs the public certificate of the CA
USER       # safe to write into the nix store.
USER       _assert.strings.has-prefix "-----BEGIN CERTIFICATE-----" x509.certificate-pem
USER     ;
USER 
USER     /**
USER       Asserts that a private key stored by the nix-crypto plugin can be exported
USER       using `nix-crypto-service export secret`, and that the public key derived
USER       from the exported private key matches the public key computed by the plugin.
USER 
USER       The `NIX_CRYPTO_STORE` environment variable must point to the same sled store used
USER       by the nix-crypto plugin so that `nix-crypto-service` can locate the key.
USER     */
USER     "It can export the private key" = { _assert, ... }:
USER     let
USER       # The public key pem as computed by the nix plugin
USER       expected-public-key-pem = pk-rsa.public-key-pem;
USER       # The identity of the key, used to locate it in the store
USER       key-identity = pk-rsa.identity;
USER     in
USER       _assert.bash-script
USER       ''
USER         PRIVATE_KEY_FILE=$(mktemp)
USER         EXPECTED_PUBLIC_KEY_FILE=$(mktemp)
USER         RANDOM_FILE=$(mktemp)
USER         SIGNATURE_FILE=$(mktemp)
USER 
USER         # Write the expected public key pem to a temp file
USER         cat > "$EXPECTED_PUBLIC_KEY_FILE" << 'EOF'
USER         ${expected-public-key-pem}
USER         EOF
USER 
USER         # Export the private key using nix-crypto-service
USER         "${nix-crypto-service}" export secret \
USER           --sled-store "$NIX_CRYPTO_STORE" \
USER           --identity-type openssl-pkey \
USER           --openssl-pkey-type rsa \
USER           --openssl-pkey-id "${key-identity}" \
USER           --output-file "$PRIVATE_KEY_FILE" \
USER           --log-file "$NIX_CRYPTO_LOG" \
USER           --log-level debug
USER 
USER         # Generate a random value to sign
USER         dd if=/dev/urandom of="$RANDOM_FILE" bs=32 count=1 2>/dev/null
USER 
USER         # Sign the random value using the exported private key
USER         openssl dgst -sha256 -sign "$PRIVATE_KEY_FILE" -out "$SIGNATURE_FILE" "$RANDOM_FILE"
USER 
USER         # Verify the signature using the expected public key
USER         if ! openssl dgst -sha256 -verify "$EXPECTED_PUBLIC_KEY_FILE" -signature "$SIGNATURE_FILE" "$RANDOM_FILE"; then
USER           exit 1
USER         fi
USER         exit 0
USER       ''
USER     ;
USER 
USER     /**
USER       Asserts that a private key stored by the nix-crypto plugin can be exported
USER       in encrypted form using `export-decryptable-pkey`, that the passphrase used
USER       to encrypt it can be retrieved using `nix-crypto-service export secret` with
USER       `--identity-type openssl-symmetric-key`, and that the decrypted key can be
USER       used to sign data.
USER 
USER       The encryption is AES-128-CBC with PBKDF2-HMAC-SHA256 key derivation,
USER       compatible with `openssl enc -aes-128-cbc -pbkdf2`.
USER 
USER       The `NIX_CRYPTO_STORE` environment variable must point to the same sled store
USER       used by the nix-crypto plugin so that `nix-crypto-service` can locate the
USER       symmetric key.
USER     */
USER     "It can export decryptable key" = { _assert, ... }:
USER       _assert.bash-script
USER       ''
USER         ENCRYPTED_PEM_FILE=$(mktemp)
USER         PASSPHRASE_FILE=$(mktemp)
USER         DECRYPTED_KEY_FILE=$(mktemp)
USER         RANDOM_FILE=$(mktemp)
USER         SIGNATURE_FILE=$(mktemp)
USER 
USER         # Write the encrypted PEM (produced at nix evaluation time) to a temp file
USER         cat > "$ENCRYPTED_PEM_FILE" << 'EOF'
USER         ${encrypted-pk-rsa.ciphertext-base64}
USER         EOF
USER 
USER         # Retrieve the passphrase used to encrypt the private key
USER         "${nix-crypto-service}" export secret \
USER           --sled-store "$NIX_CRYPTO_STORE" \
USER           --identity-type openssl-symmetric-key \
USER           --openssl-symmetric-key-id "${encrypted-pk-rsa.key-id}" \
USER           --openssl-symmetric-key-derivation "${symmetric-key-params.key-derivation}" \
USER           --openssl-symmetric-key-iterations "${toString symmetric-key-params.iterations}" \
USER           --output-file "$PASSPHRASE_FILE" \
USER           --log-file "$NIX_CRYPTO_LOG" \
USER           --log-level debug
USER 
USER         # Decrypt the encrypted PEM using the passphrase.
USER         # The key and IV are derived from the passphrase and salt using
USER         # PBKDF2-HMAC-SHA256, matching the derivation done in decryptable.rs.
USER         openssl enc -d -base64 -aes-128-cbc -pbkdf2 \
USER           -iter ${toString symmetric-key-params.iterations} \
USER           -pass file:"$PASSPHRASE_FILE" \
USER           -in "$ENCRYPTED_PEM_FILE" \
USER           -out "$DECRYPTED_KEY_FILE"
USER 
USER         # Generate a random value to sign
USER         dd if=/dev/urandom of="$RANDOM_FILE" bs=32 count=1 2>/dev/null
USER 
USER         # Sign the random value using the decrypted private key
USER         if ! openssl dgst -sha256 -sign "$DECRYPTED_KEY_FILE" -out "$SIGNATURE_FILE" "$RANDOM_FILE"; then
USER           exit 1
USER         fi
USER         exit 0
USER       ''
USER     ;
USER 
USER     /**
USER       Asserts that a private key can be encrypted with another private key using
USER       `export-encrypted-pkey-pkey`, and that the encrypted payload can be decrypted
USER       using the exported private key.
USER 
USER       The `NIX_CRYPTO_STORE` environment variable must point to the same sled store
USER       used by the nix-crypto plugin so that `nix-crypto-service` can locate the keys.
USER     */
USER     "It can export and decrypt a private key encrypted with another private key" = { _assert, ... }:
USER     let
USER       # The identity of the key used for encryption, to locate it in the store
USER       key-identity = pk-rsa.identity;
USER       # The expected public key of the credential-key, to verify decryption
USER       expected-public-key-pem = credential-key.public-key-pem;
USER     in
USER       _assert.bash-script
USER       ''
USER         WORKDIR=$(mktemp -d)
USER         echo "Workdir: $WORKDIR"
USER         PRIVATE_KEY_FILE="$WORKDIR/private_key_file"
USER         EXPECTED_PUBLIC_KEY_FILE="$WORKDIR/expected_public_key_file"
USER         ENCRYPTED_FILE="$WORKDIR/encrypted_file"
USER         ENCRYPTED_KEY_PEM="$WORKDIR/encrypted_key_pem"
USER         ENCRYPTED_DATA_PEM="$WORKDIR/encrypted_data_pem"
USER         SYMMETRIC_KEY_FILE="$WORKDIR/symmetric_key_file"
USER         DECRYPTED_KEY_FILE="$WORKDIR/decrypted_key_file"
USER         RANDOM_FILE="$WORKDIR/random_file"
USER         SIGNATURE_FILE="$WORKDIR/signature_file"
USER 
USER         # Write the expected public key pem to a temp file
USER         cat > "$EXPECTED_PUBLIC_KEY_FILE" << 'EOF'
USER         ${expected-public-key-pem}
USER         EOF
USER 
USER         # Export the pk-rsa private key using nix-crypto-service
USER         "${nix-crypto-service}" export secret \
USER           --sled-store "$NIX_CRYPTO_STORE" \
USER           --identity-type openssl-pkey \
USER           --openssl-pkey-type rsa \
USER           --openssl-pkey-id "${key-identity}" \
USER           --output-file "$PRIVATE_KEY_FILE" \
USER           --log-file "$NIX_CRYPTO_LOG" \
USER           --log-level debug
USER 
USER         # Write the encrypted payload to a file
USER         cat > "$ENCRYPTED_FILE" << 'EOF'
USER         ${encrypted-credential.ciphertext-base64}
USER         EOF
USER 
USER         # Split into the two PEM blocks
USER         awk '/-----BEGIN ENCRYPTED KEY-----/,/-----END ENCRYPTED KEY-----/ {print > "'"$ENCRYPTED_KEY_PEM"'"}' "$ENCRYPTED_FILE"
USER         awk '/-----BEGIN ENCRYPTED DATA-----/,/-----END ENCRYPTED DATA-----/ {print > "'"$ENCRYPTED_DATA_PEM"'"}' "$ENCRYPTED_FILE"
USER         # Extact the encrypted key and convert it to binary
USER         ENCRYPTED_KEY_BIN="$WORKDIR/encrypted_key_bin"
USER         sed '0,/-----BEGIN ENCRYPTED KEY-----/d; /-----END ENCRYPTED KEY-----/,$d' "$ENCRYPTED_KEY_PEM" | tr -d '\n' | base64 -d | tee "$ENCRYPTED_KEY_BIN"
USER 
USER         # Decrypt the symmetric key (ENCRYPTED KEY PEM block)
USER         openssl pkeyutl -decrypt \
USER           -inkey "$PRIVATE_KEY_FILE" \
USER           -in "$ENCRYPTED_KEY_BIN" \
USER           -out "$SYMMETRIC_KEY_FILE" \
USER           -pkeyopt rsa_padding_mode:oaep
USER 
USER         # Extract the base64 content from the ENCRYPTED DATA PEM block
USER         IV_FILE="$WORKDIR/iv_file"
USER         IV_AND_CIPHERTEXT_FILE="$WORKDIR/iv_and_ciphertext"
USER         sed '0,/-----BEGIN ENCRYPTED DATA-----/d; /-----END ENCRYPTED DATA-----/,$d' "$ENCRYPTED_DATA_PEM" | tr -d '\n' | tee "$IV_AND_CIPHERTEXT_FILE"
USER         IV_AND_CIPHERTEXT=$(cat "$IV_AND_CIPHERTEXT_FILE" | base64 -d)
USER 
USER         # Extract the IV
USER         IV=''${IV_AND_CIPHERTEXT:0:16}
USER         echo -n "$IV" | tee "$IV_FILE"
USER 
USER         # Extract the ciphertext
USER         CIPHERTEXT=''${IV_AND_CIPHERTEXT:16}
USER         TMP_KEY_FILE="$WORKDIR/tmp_key_file"
USER         xxd -p -c 64 "$SYMMETRIC_KEY_FILE" | head -c 64 | tee "$TMP_KEY_FILE"
USER         IN_CIPHERTEXT="$WORKDIR/in_ciphertext"
USER         echo -n "$CIPHERTEXT" | tee "$IN_CIPHERTEXT"
USER 
USER         # Decrypt the ciphertext using AES-256-CBC
USER         openssl enc -d -aes-256-cbc \
USER           -K "$TMP_KEY_FILE" \
USER           -iv "$IV_FILE" \
USER           -in "$IN_CIPHERTEXT" \
USER           -out "$DECRYPTED_KEY_FILE"
USER 
USER         # Generate a random value to sign
USER         dd if=/dev/urandom of="$RANDOM_FILE" bs=32 count=1 2>/dev/null
USER 
USER         # Sign the random value using the decrypted private key
USER         if ! openssl dgst -sha256 -sign "$DECRYPTED_KEY_FILE" -out "$SIGNATURE_FILE" "$RANDOM_FILE"; then
USER           exit 1
USER         fi
USER 
USER         # Verify the signature using the expected public key
USER         if ! openssl dgst -sha256 -verify "$EXPECTED_PUBLIC_KEY_FILE" -signature "$SIGNATURE_FILE" "$RANDOM_FILE"; then
USER           exit 1
USER         fi
USER         exit 0
USER       ''
USER     ;
USER   }
USER ```
