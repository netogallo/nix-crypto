USER     /// `OpensslPrivateKeyIdentity` credential type, making it callable from C++.
USER     pub fn cxx_export_decryptable_openssl_pkey(
USER         &self,
USER         symmetric_key: OpensslSymmetricKeyIdentity,
USER         credential: OpensslPrivateKeyIdentity,
USER     ) -> Result<String, Error> {
USER         export_decryptable(
USER             &self.0,
USER             &symmetric_key,
USER             &OpensslPrivateKeyIdentityWrapper(&credential),
USER         )
USER     }
USER 
USER     /// Export an openssl private key credential encrypted with the given asymmetric key,
USER     /// returning a PEM-formatted string containing the RSA-OAEP encrypted symmetric key
USER     /// and the AES-256-CBC encrypted credential.
USER     ///
USER     /// This is a monomorphic wrapper around `export_encrypted` for the
USER     /// `OpensslPrivateKeyIdentity` type on both type arguments, making it callable from C++.
USER     pub fn cxx_export_encrypted_openssl_pkey_pkey(
USER         &self,
USER         key: OpensslPrivateKeyIdentity,
USER         credential: OpensslPrivateKeyIdentity,
USER     ) -> Result<String, Error> {
USER         self.0.export_encrypted(
USER             &key,
USER             &OpensslPrivateKeyIdentityWrapper(&credential),
USER         )
USER     }
