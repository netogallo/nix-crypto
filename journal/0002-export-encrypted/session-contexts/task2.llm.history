ASSISTANT #include "nix_crypto_plugin/include/openssl_primops.hh"
ASSISTANT 
ASSISTANT #include "nix_crypto_plugin/src/cxx_bridge.rs.h"
ASSISTANT #include "nix_crypto_plugin/include/nix_crypto.hh"
ASSISTANT 
ASSISTANT using namespace nix;
ASSISTANT 
ASSISTANT static OpensslPrivateKeyIdentity openssl_get_private_key_identity(
ASSISTANT     EvalState& state,
ASSISTANT     const PosIdx pos,
ASSISTANT     Value& key_args
ASSISTANT ) {
ASSISTANT 
ASSISTANT     state.forceAttrs(key_args, pos, "while evaluating the openssl key args passed to builtins.openssl.public-key-pem");
ASSISTANT 
ASSISTANT     auto key_type = state.forceStringNoCtx(
ASSISTANT         *state.getAttr(
ASSISTANT             state.symbols.create("key-type"),
ASSISTANT             key_args.attrs(),
ASSISTANT             "in the openssl key parameters"
ASSISTANT         )->value,
ASSISTANT         pos,
ASSISTANT         "while reading the 'key-type' parameter"
ASSISTANT     );
ASSISTANT 
ASSISTANT     auto key_id = state.forceStringNoCtx(
ASSISTANT         *state.getAttr(
ASSISTANT             state.symbols.create("key-identity"),
ASSISTANT             key_args.attrs(),
ASSISTANT             "in the openssl key parameters"
ASSISTANT         )->value,
ASSISTANT         pos,
ASSISTANT         "while reading the 'key-identity' parameter"
ASSISTANT     );
ASSISTANT 
ASSISTANT     return { key_type.data(), key_id.data() };
ASSISTANT }
ASSISTANT 
ASSISTANT static OpensslSymmetricKeyIdentity openssl_get_symmetric_key_identity(
ASSISTANT     EvalState& state,
ASSISTANT     const PosIdx pos,
ASSISTANT     Value& key_args
ASSISTANT ) {
ASSISTANT     state.forceAttrs(key_args, pos, "while evaluating the openssl symmetric key args passed to builtins.openssl.export-decryptable-pkey");
ASSISTANT 
ASSISTANT     auto key_id = state.forceStringNoCtx(
ASSISTANT         *state.getAttr(
ASSISTANT             state.symbols.create("key-id"),
ASSISTANT             key_args.attrs(),
ASSISTANT             "in the openssl symmetric key parameters"
ASSISTANT         )->value,
ASSISTANT         pos,
ASSISTANT         "while reading the 'key-id' parameter"
ASSISTANT     );
ASSISTANT 
ASSISTANT     auto key_derivation = state.forceStringNoCtx(
ASSISTANT         *state.getAttr(
ASSISTANT             state.symbols.create("key-derivation"),
ASSISTANT             key_args.attrs(),
ASSISTANT             "in the openssl symmetric key parameters"
ASSISTANT         )->value,
ASSISTANT         pos,
ASSISTANT         "while reading the 'key-derivation' parameter"
ASSISTANT     );
ASSISTANT 
ASSISTANT     auto iterations = state.forceInt(
ASSISTANT         *state.getAttr(
ASSISTANT             state.symbols.create("iterations"),
ASSISTANT             key_args.attrs(),
ASSISTANT             "in the openssl symmetric key parameters"
ASSISTANT         )->value,
ASSISTANT         pos,
ASSISTANT         "while reading the 'iterations' parameter"
ASSISTANT     ).value;
ASSISTANT 
ASSISTANT     return {
ASSISTANT         .key_id = rust::String(key_id.data()),
ASSISTANT         .key_derivation = rust::String(key_derivation.data()),
ASSISTANT         .iterations = static_cast<uint32_t>(iterations),
ASSISTANT     };
ASSISTANT }
ASSISTANT 
ASSISTANT /// @breif A nix primop that allows generating x509 certificates.
ASSISTANT ///
ASSISTANT /// This function is a wrapepr around openssl to generate x509
ASSISTANT /// certificates. All keys involved in the certificate (private keys
ASSISTANT /// and signing keys) are provided as key references. This allows
ASSISTANT /// the certificate to be generated without needing to expose
ASSISTANT /// any keys in nix code.
ASSISTANT static void primop_openssl_public_key_pem(EvalState& state, const PosIdx pos, Value** args, Value& result) {
ASSISTANT 
ASSISTANT     try {
ASSISTANT         auto pem = primops->opensslPublicKeyPem(
ASSISTANT             std::move(openssl_get_private_key_identity(state, pos, *args[0]))
ASSISTANT         );
ASSISTANT         result.mkString(pem);
ASSISTANT     } catch (rust::Error& e) {
ASSISTANT         state.error<EvalError>(e.what())
ASSISTANT             .atPos(pos)
ASSISTANT             .debugThrow();
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT const std::string K_KEY_USAGE_CRITICAL = "critical";
ASSISTANT const std::string K_KEY_USAGE_CRL_SIGN = "crl-sign";
ASSISTANT const std::string K_KEY_USAGE_KEY_CERT_SIGN = "key-cert-sign";
ASSISTANT 
ASSISTANT static rust::Vec<X509KeyUsage> tryGetKeyUsage(EvalState& state, const PosIdx pos, const std::string& key, Value& attrs) {
ASSISTANT 
ASSISTANT     auto attr = attrs.attrs()->get(state.symbols.create(key));
ASSISTANT 
ASSISTANT     if(!attr || !attr->value) {
ASSISTANT         return {};
ASSISTANT     }
ASSISTANT 
ASSISTANT     auto& value = *attr->value;
ASSISTANT     state.forceValue(value, pos);
ASSISTANT 
ASSISTANT     // Nulls are also treated as the attribute being absent
ASSISTANT     if(value.type() == nNull) {
ASSISTANT         return {};
ASSISTANT     }
ASSISTANT 
ASSISTANT     state.forceAttrs(
ASSISTANT         value,
ASSISTANT         pos,
ASSISTANT         std::format("expected the 'x509 key constraints' extension to be an attribute set as the attribute '{}' of the parameters.", key)
ASSISTANT     );
ASSISTANT 
ASSISTANT     auto criticalAttr = value.attrs()->get(state.symbols.create(K_KEY_USAGE_CRITICAL));
ASSISTANT     bool critical = false;
ASSISTANT 
ASSISTANT     if(criticalAttr) {
ASSISTANT         critical = state.forceBool(
ASSISTANT             *criticalAttr->value,
ASSISTANT             pos,
ASSISTANT             std::format("the value of the '{}' attribute provided for the 'x509 key usage' must be a bool", K_KEY_USAGE_CRITICAL)
ASSISTANT         );
ASSISTANT     }
ASSISTANT 
ASSISTANT     auto keyCertSignAttr = value.attrs()->get(state.symbols.create(K_KEY_USAGE_KEY_CERT_SIGN));
ASSISTANT     bool keyCertSign = false;
ASSISTANT 
ASSISTANT     if(keyCertSignAttr) {
ASSISTANT         keyCertSign = state.forceBool(
ASSISTANT             *keyCertSignAttr->value,
ASSISTANT             pos,
ASSISTANT             std::format("the value of the '{}' attribute provided for the 'x509 key usage' must be a bool", K_KEY_USAGE_KEY_CERT_SIGN)
ASSISTANT         );
ASSISTANT     }
ASSISTANT 
ASSISTANT     auto crlSignAttr = value.attrs()->get(state.symbols.create(K_KEY_USAGE_CRL_SIGN));
ASSISTANT     auto crlSign = false;
ASSISTANT 
ASSISTANT     if(crlSignAttr) {
ASSISTANT         crlSign = state.forceBool(
ASSISTANT             *crlSignAttr->value,
ASSISTANT             pos,
ASSISTANT             std::format("the value of the '{}' attribute provided for the 'x509 key usage' must be a bool", K_KEY_USAGE_CRL_SIGN)
ASSISTANT         );
ASSISTANT     }
ASSISTANT 
ASSISTANT     return {
ASSISTANT         { .critical = critical
ASSISTANT         , .key_cert_sign = keyCertSign
ASSISTANT         , .crl_sign = crlSign
ASSISTANT         }
ASSISTANT     };
ASSISTANT }
ASSISTANT 
ASSISTANT const std::string K_BUILD_PARAMS_CRITICAL = "critical";
ASSISTANT const std::string K_BUILD_PARAMS_CA = "ca";
ASSISTANT 
ASSISTANT static rust::Vec<X509BasicConstraints> tryGetBasicConstraints(EvalState& state, const PosIdx pos, const std::string& key, Value& attrs) {
ASSISTANT 
ASSISTANT     auto attr = attrs.attrs()->get(state.symbols.create(key));
ASSISTANT 
ASSISTANT     if(!attr) {
ASSISTANT         return {};
ASSISTANT     }
ASSISTANT 
ASSISTANT     auto& value = *attr->value;
ASSISTANT     state.forceValue(value, pos);
ASSISTANT 
ASSISTANT     // Nulls are treated as if the value were absent
ASSISTANT     if (value.type() == nNull) {
ASSISTANT         return {};
ASSISTANT     }
ASSISTANT 
ASSISTANT     state.forceAttrs(
ASSISTANT         value,
ASSISTANT         pos,
ASSISTANT         std::format("expected the 'x509 basic constraints' extension, provided under the attribute {}, to be an attribute set.", key)
ASSISTANT     );
ASSISTANT 
ASSISTANT     auto criticalAttr = value.attrs()->get(state.symbols.create(K_BUILD_PARAMS_CRITICAL));
ASSISTANT     bool critical = false;
ASSISTANT 
ASSISTANT     if(criticalAttr) {
ASSISTANT         critical = state.forceBool(
ASSISTANT             *criticalAttr->value,
ASSISTANT             pos,
ASSISTANT             std::format("the value of the '{}' attribute provided for the 'x509 basic constraints' must be a bool", K_BUILD_PARAMS_CRITICAL)
ASSISTANT         );
ASSISTANT     }
ASSISTANT 
ASSISTANT     auto caAttr = value.attrs()->get(state.symbols.create(K_BUILD_PARAMS_CA));
ASSISTANT     bool ca = false;
ASSISTANT 
ASSISTANT     if(caAttr) {
ASSISTANT         ca = state.forceBool(
ASSISTANT             *caAttr->value,
ASSISTANT             pos,
ASSISTANT             std::format("the value of the '{}' attribute provided for the 'x509 basic constraints' must be a bool", K_BUILD_PARAMS_CA)
ASSISTANT         );
ASSISTANT     }
ASSISTANT 
ASSISTANT     return { X509BasicConstraints { .critical = critical, .ca = ca } };
ASSISTANT }
ASSISTANT     
ASSISTANT 
ASSISTANT static rust::Vec<X509NameItem> asX509Name(EvalState& state, const PosIdx pos, Value& attrs) {
ASSISTANT 
ASSISTANT     state.forceAttrs(attrs, pos, "expected the 'x509 name' to be represented as an attribute set of strings");
ASSISTANT     rust::Vec<X509NameItem> result;
ASSISTANT     result.reserve(attrs.attrs()->size());
ASSISTANT 
ASSISTANT     for(auto attr : *attrs.attrs()) {
ASSISTANT         auto attrName = rust::String(std::string(state.symbols[attr.name]));
ASSISTANT         auto attrValue = rust::String(
ASSISTANT             state.forceString(
ASSISTANT                 *attr.value,
ASSISTANT                 pos,
ASSISTANT                 std::format("expected the attributes of the 'X509 name' to be strings. The attribute '{}' is not a string.", attrName.data())
ASSISTANT             ).data()
ASSISTANT         );
ASSISTANT         result.emplace_back(attrName, attrValue);
ASSISTANT     }
ASSISTANT 
ASSISTANT     return result;
ASSISTANT }
