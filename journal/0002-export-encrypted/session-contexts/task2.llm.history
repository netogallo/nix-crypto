USER static OpensslPrivateKeyIdentity openssl_get_private_key_identity(
USER     EvalState& state,
USER     const PosIdx pos,
USER     Value& key_args
USER ) {
USER 
USER     state.forceAttrs(key_args, pos, "while evaluating the openssl key args passed to builtins.openssl.public-key-pem");
USER 
USER     auto key_type = state.forceStringNoCtx(
USER         *state.getAttr(
USER             state.symbols.create("key-type"),
USER             key_args.attrs(),
USER             "in the openssl key parameters"
USER         )->value,
USER         pos,
USER         "while reading the 'key-type' parameter"
USER     );
USER 
USER     auto key_id = state.forceStringNoCtx(
USER         *state.getAttr(
USER             state.symbols.create("key-identity"),
USER             key_args.attrs(),
USER             "in the openssl key parameters"
USER         )->value,
USER         pos,
USER         "while reading the 'key-identity' parameter"
USER     );
USER 
USER     return { key_type.data(), key_id.data() };
USER }
USER 
USER static OpensslSymmetricKeyIdentity openssl_get_symmetric_key_identity(
USER     EvalState& state,
USER     const PosIdx pos,
USER     Value& key_args
USER ) {
USER     state.forceAttrs(key_args, pos, "while evaluating the openssl symmetric key args passed to builtins.openssl.export-decryptable-pkey");
USER 
USER     auto key_id = state.forceStringNoCtx(
USER         *state.getAttr(
USER             state.symbols.create("key-id"),
USER             key_args.attrs(),
USER             "in the openssl symmetric key parameters"
USER         )->value,
USER         pos,
USER         "while reading the 'key-id' parameter"
USER     );
USER 
USER     auto key_derivation = state.forceStringNoCtx(
USER         *state.getAttr(
USER             state.symbols.create("key-derivation"),
USER             key_args.attrs(),
USER             "in the openssl symmetric key parameters"
USER         )->value,
USER         pos,
USER         "while reading the 'key-derivation' parameter"
USER     );
USER 
USER     auto iterations = state.forceInt(
USER         *state.getAttr(
USER             state.symbols.create("iterations"),
USER             key_args.attrs(),
USER             "in the openssl symmetric key parameters"
USER         )->value,
USER         pos,
USER         "while reading the 'iterations' parameter"
USER     ).value;
USER 
USER     return {
USER         .key_id = rust::String(key_id.data()),
USER         .key_derivation = rust::String(key_derivation.data()),
USER         .iterations = static_cast<uint32_t>(iterations),
USER     };
USER }
USER 
USER /// @breif A nix primop that allows generating x509 certificates.
USER ///
USER /// This function is a wrapepr around openssl to generate x509
USER /// certificates. All keys involved in the certificate (private keys
USER /// and signing keys) are provided as key references. This allows
USER /// the certificate to be generated without needing to expose
USER /// any keys in nix code.
USER static void primop_openssl_public_key_pem(EvalState& state, const PosIdx pos, Value** args, Value& result) {
USER 
USER     try {
USER         auto pem = primops->opensslPublicKeyPem(
USER             std::move(openssl_get_private_key_identity(state, pos, *args[0]))
USER         );
USER         result.mkString(pem);
USER     } catch (rust::Error& e) {
USER         state.error<EvalError>(e.what())
USER             .atPos(pos)
USER             .debugThrow();
USER     }
USER }
USER 
USER const std::string K_KEY_USAGE_CRITICAL = "critical";
USER const std::string K_KEY_USAGE_CRL_SIGN = "crl-sign";
USER const std::string K_KEY_USAGE_KEY_CERT_SIGN = "key-cert-sign";
USER 
USER static rust::Vec<X509KeyUsage> tryGetKeyUsage(EvalState& state, const PosIdx pos, const std::string& key, Value& attrs) {
USER 
USER     auto attr = attrs.attrs()->get(state.symbols.create(key));
USER 
USER     if(!attr || !attr->value) {
USER         return {};
USER     }
USER 
USER     auto& value = *attr->value;
USER     state.forceValue(value, pos);
USER 
USER     // Nulls are also treated as the attribute being absent
USER     if(value.type() == nNull) {
USER         return {};
USER     }
USER 
USER     state.forceAttrs(
USER         value,
USER         pos,
USER         std::format("expected the 'x509 key constraints' extension to be an attribute set as the attribute '{}' of the parameters.", key)
USER     );
USER 
USER     auto criticalAttr = value.attrs()->get(state.symbols.create(K_KEY_USAGE_CRITICAL));
USER     bool critical = false;
USER 
USER     if(criticalAttr) {
USER         critical = state.forceBool(
USER             *criticalAttr->value,
USER             pos,
USER             std::format("the value of the '{}' attribute provided for the 'x509 key usage' must be a bool", K_KEY_USAGE_CRITICAL)
USER         );
USER     }
USER 
USER     auto keyCertSignAttr = value.attrs()->get(state.symbols.create(K_KEY_USAGE_KEY_CERT_SIGN));
USER     bool keyCertSign = false;
USER 
USER     if(keyCertSignAttr) {
USER         keyCertSign = state.forceBool(
USER             *keyCertSignAttr->value,
USER             pos,
USER             std::format("the value of the '{}' attribute provided for the 'x509 key usage' must be a bool", K_KEY_USAGE_KEY_CERT_SIGN)
USER         );
USER     }
USER 
USER     auto crlSignAttr = value.attrs()->get(state.symbols.create(K_KEY_USAGE_CRL_SIGN));
USER     auto crlSign = false;
USER 
USER     if(crlSignAttr) {
USER         crlSign = state.forceBool(
USER             *crlSignAttr->value,
USER             pos,
USER             std::format("the value of the '{}' attribute provided for the 'x509 key usage' must be a bool", K_KEY_USAGE_CRL_SIGN)
USER         );
USER     }
USER 
USER     return {
USER         { .critical = critical
USER         , .key_cert_sign = keyCertSign
USER         , .crl_sign = crlSign
USER         }
USER     };
USER }
USER 
USER const std::string K_BUILD_PARAMS_CRITICAL = "critical";
USER const std::string K_BUILD_PARAMS_CA = "ca";
USER 
USER static rust::Vec<X509BasicConstraints> tryGetBasicConstraints(EvalState& state, const PosIdx pos, const std::string& key, Value& attrs) {
USER 
USER     auto attr = attrs.attrs()->get(state.symbols.create(key));
USER 
USER     if(!attr) {
USER         return {};
USER     }
USER 
USER     auto& value = *attr->value;
USER     state.forceValue(value, pos);
USER 
USER     // Nulls are treated as if the value were absent
USER     if (value.type() == nNull) {
USER         return {};
USER     }
USER 
USER     state.forceAttrs(
USER         value,
USER         pos,
USER         std::format("expected the 'x509 basic constraints' extension, provided under the attribute {}, to be an attribute set.", key)
USER     );
USER 
USER     auto criticalAttr = value.attrs()->get(state.symbols.create(K_BUILD_PARAMS_CRITICAL));
USER     bool critical = false;
USER 
USER     if(criticalAttr) {
USER         critical = state.forceBool(
USER             *criticalAttr->value,
USER             pos,
USER             std::format("the value of the '{}' attribute provided for the 'x509 basic constraints' must be a bool", K_BUILD_PARAMS_CRITICAL)
USER         );
USER     }
USER 
USER     auto caAttr = value.attrs()->get(state.symbols.create(K_BUILD_PARAMS_CA));
USER     bool ca = false;
USER 
USER     if(caAttr) {
USER         ca = state.forceBool(
USER             *caAttr->value,
USER             pos,
USER             std::format("the value of the '{}' attribute provided for the 'x509 basic constraints' must be a bool", K_BUILD_PARAMS_CA)
USER         );
USER     }
USER 
USER     return { X509BasicConstraints { .critical = critical, .ca = ca } };
USER }
USER     
USER 
USER static rust::Vec<X509NameItem> asX509Name(EvalState& state, const PosIdx pos, Value& attrs) {
USER 
USER     state.forceAttrs(attrs, pos, "expected the 'x509 name' to be represented as an attribute set of strings");
USER     rust::Vec<X509NameItem> result;
USER     result.reserve(attrs.attrs()->size());
USER 
USER     for(auto attr : *attrs.attrs()) {
USER         auto attrName = rust::String(std::string(state.symbols[attr.name]));
USER         auto attrValue = rust::String(
USER             state.forceString(
USER                 *attr.value,
USER                 pos,
USER                 std::format("expected the attributes of the 'X509 name' to be strings. The attribute '{}' is not a string.", attrName.data())
USER             ).data()
USER         );
USER         result.emplace_back(attrName, attrValue);
USER     }
USER 
USER     return result;
USER }
USER 
USER const std::string K_SUBJECT_PUBLIC_KEY = "subject-public-key";
USER const std::string K_SIGNING_PRIVATE_KEY_IDENTITY = "signing-private-key-identity";
USER const std::string K_SUBJECT_NAME = "subject-name";
USER const std::string K_ISSUER_NAME = "issuer-name";
USER const std::string K_SERIAL = "serial";
USER const std::string K_START_DATE = "start-date";
USER const std::string K_EXPIRY_DATE = "expiry-date";
USER const std::string K_BASIC_CONSTRAINTS = "basic-constraints";
USER const std::string K_KEY_USAGE = "key-usage";
USER 
USER static X509BuildParams toX509Params(EvalState& state, const PosIdx pos, Value& params) {
USER 
USER     state.forceAttrs(params, pos, "while evaluating the openssl build parameters to build an X509 certificate.");
USER 
USER     auto subjectPublicKey = tryGetString(state, pos, K_SUBJECT_PUBLIC_KEY, params);
USER     auto signingKey = openssl_get_private_key_identity(
USER         state,
USER         pos,
USER         *state.getAttr(
USER             state.symbols.create(K_SIGNING_PRIVATE_KEY_IDENTITY),
USER             params.attrs(),
USER             std::format("while accessing the '{}' attribute.", K_SIGNING_PRIVATE_KEY_IDENTITY)
USER         )->value
USER     );
USER     auto subjectName =
USER         asX509Name(
USER             state,
USER             pos,
USER             *state.getAttr(
USER                 state.symbols.create(K_SUBJECT_NAME),
USER                 params.attrs(),
USER                 "A 'x509 subject name' must be provided as a attribute set of strings"
USER             )->value
USER         );
USER     auto issuerName =
USER         asX509Name(
USER             state,
USER             pos,
USER             *state.getAttr(
USER                 state.symbols.create(K_ISSUER_NAME),
USER                 params.attrs(),
USER                 "A 'x509 issuer name' must be provided as a attribute set of strings"
USER             )->value
USER         );
USER 
USER     int serial =
USER         state.forceInt(
USER             *state.getAttr(
USER                 state.symbols.create(K_SERIAL),
USER                 params.attrs(),
USER                 "A 'x509 serial' must be provided as an integer"
USER             )->value,
USER             pos,
USER             std::format("A 'X509' serial must be provided as an int under the attribute {}", K_SERIAL)
USER         ).value;
USER 
USER     auto startDate =
USER         state.forceString(
USER             *state.getAttr(
USER                 state.symbols.create(K_START_DATE),
USER                 params.attrs(),
USER                 "A starting date must be provided as a string formatted using the 'RFC 3339' standard."
USER             )->value,
USER             pos,
USER             std::format("A starting date must be provided as a string formatted using the 'RFC 3339' standard under the '{}' attribute", K_START_DATE)
USER         ).data();
USER 
USER     auto expiryDate =
USER         state.forceString(
USER             *state.getAttr(
USER                 state.symbols.create(K_EXPIRY_DATE),
USER                 params.attrs(),
USER                 "An expiry date must be provided as a string formatted using the 'RFC 3339' standard."
USER             )->value,
USER             pos,
USER             std::format("A expiry date must be provided as a string formatted using the 'RFC 3339' standard under the '{}' attribute", K_START_DATE)
USER         ).data();
USER 
USER     auto basicConstraints = tryGetBasicConstraints(state, pos, K_BASIC_CONSTRAINTS, params);
USER 
USER     auto keyUsage = tryGetKeyUsage(state, pos, K_KEY_USAGE, params);
USER 
USER     return {
USER         .subject_public_key = std::move(subjectPublicKey),
USER         .signing_private_key_identity = std::move(signingKey),
USER         .issuer_name = std::move(issuerName),
USER         .subject_name = std::move(subjectName),
USER         .serial = static_cast<uint32_t>(serial),
USER         .start_date = rust::String(startDate),
USER         .expiry_date = rust::String(expiryDate),
USER         .extension_key_usage = std::move(keyUsage),
USER         .extension_basic_constraints = std::move(basicConstraints)
USER     };
USER }
USER 
USER static void primop_openssl_x509_pem(EvalState& state, const PosIdx pos, Value** args, Value& result) {
USER     try {
USER         auto pem = primops->opensslX509Pem(
USER             toX509Params(state, pos, *args[0])
USER         );
USER         result.mkString(pem);
USER     } catch(rust::Error& e) {
USER         state.error<EvalError>(e.what())
USER             .atPos(pos)
USER             .debugThrow();
USER     }
USER }
USER 
USER static void primop_openssl_export_decryptable_pkey(EvalState& state, const PosIdx pos, Value** args, Value& result) {
USER     try {
USER         auto pem = primops->opensslExportDecryptableOpensslPkey(
USER             openssl_get_symmetric_key_identity(state, pos, *args[0]),
USER             openssl_get_private_key_identity(state, pos, *args[1])
USER         );
USER         result.mkString(pem);
USER     } catch(rust::Error& e) {
USER         state.error<EvalError>(e.what())
USER             .atPos(pos)
USER             .debugThrow();
USER     }
USER }
USER 
USER constexpr const int OPENSSL_PRIMOPS_COUNT = 3;
USER constexpr const char* K_X509_PEM = "x509-pem";
USER constexpr const char* K_EXPORT_DECRYPTABLE_PKEY = "export-decryptable-pkey";
USER 
USER void primop_openssl(EvalState& state, const PosIdx, Value**, Value& result) {
USER 
USER     auto attrs = state.buildBindings(OPENSSL_PRIMOPS_COUNT);
USER 
USER     auto openssl_public_key_pem = state.symbols.create("public-key-pem");
USER     attrs.alloc(openssl_public_key_pem).mkPrimOp(new PrimOp {
USER         .name = "public-key-pem",
USER         .args = {},
USER         .arity = 1,
USER         .doc = {},
USER         .fun = primop_openssl_public_key_pem,
USER         .experimentalFeature = {},
USER     });
USER 
USER     auto opensslX509Pem = state.symbols.create(K_X509_PEM);
USER     attrs.alloc(opensslX509Pem).mkPrimOp(new PrimOp { 
USER         .name = K_X509_PEM,
USER         .args = {},
USER         .arity = 1,
USER         .doc = {},
USER         .fun = primop_openssl_x509_pem,
USER         .experimentalFeature = {},
USER     });
USER 
USER     auto opensslExportDecryptablePkey = state.symbols.create(K_EXPORT_DECRYPTABLE_PKEY);
USER     attrs.alloc(opensslExportDecryptablePkey).mkPrimOp(new PrimOp {
USER         .name = K_EXPORT_DECRYPTABLE_PKEY,
USER         .args = {},
USER         .arity = 2,
USER         .doc = {},
USER         .fun = primop_openssl_export_decryptable_pkey,
USER         .experimentalFeature = {},
USER     });
USER 
USER     result.mkAttrs(attrs);
USER }
