USER // This module will get parsed by the cxx:builder. Avoid anything
USER // other than definitions strictly needed for the C++ bridge, as
USER // any changes here incurr long re-compilation. For utilities
USER // related to the CXX bridge, use the cxx_support module. Function
USER // implementations for the functions in this module should be placed
USER // in cxx_api
USER use crate::cxx_api::*;
USER 
USER #[cxx::bridge]
USER pub mod ffi {
USER     /// This struct defines a key identity for openssl. An identity
USER     /// is simply an object that is able to reference a particular key.
USER     /// In order to avoid exposing private keys in nix code (so they cannot
USER     /// land in the store), nix code will provide an identity (rather than
USER     /// the private key) to indicate what key is to be used to sign/encrypt
USER     /// values.
USER     pub struct OpensslPrivateKeyIdentity {
USER         pub key_type: String,
USER         pub key_id : String
USER     }
USER 
USER     /// This struct defines a symmetric key identity for openssl. It contains
USER     /// all the information needed to derive and reference a symmetric key
USER     /// used for encrypting credentials via `export_decryptable`.
USER     pub struct OpensslSymmetricKeyIdentity {
USER         pub key_id: String,
USER         pub key_derivation: String,
USER         pub iterations: u32,
USER     }
USER 
USER     pub struct X509NameItem {
USER         pub entry_name: String,
USER         pub entry_value: String
USER     }
USER 
USER     pub struct X509KeyUsage {
USER         pub critical: bool,
USER         pub key_cert_sign: bool,
USER         pub crl_sign: bool
USER     }
USER 
USER     pub struct X509BasicConstraints {
USER         pub critical: bool,
USER         pub ca: bool
USER     }
USER 
USER     /// This struct identifies a X509Certificate. Note that
USER     /// each parameter has additional constraints. The expectation
USER     /// is that the same set of parameters will result in the same
USER     /// certificate accross multiple invocations.
USER     pub struct X509BuildParams {
USER         /// The public key asociated to the private key of
USER         /// the certificate's subject. The value should be one
USER         /// of the following:
USER         /// * A Vec containing a *single* element which must be
USER         ///   the key as a PEM encoded String
USER         /// * An *empty* Vec. In this case, the certificate will
USER         ///   be a "self-signed" certificate, meaning the public
USER         ///   key associated to the signing key will be the
USER         ///   certificate's subject's private key.
USER         ///
USER         /// Todo: Ideally, this should be an 'Option<String>' but
USER         /// it seems that is not supported by the CXX crate.
USER         pub subject_public_key: Vec<String>,
USER         /// The private key that will be used to sign the certificate.
USER         pub signing_private_key_identity: OpensslPrivateKeyIdentity,
USER         /// The name components of the certificate. Note that for
USER         /// identity purposes, the order in which they are defined
USER         /// does not matter. Furthermore, duplicate keys are not
USER         /// allowed.
USER         pub issuer_name: Vec<X509NameItem>,
USER         pub subject_name: Vec<X509NameItem>,
USER         /// The serial of the certificate
USER         pub serial: u32,
USER         /// The starting day of the certificate's validity. This must
USER         /// be a string in the "RFC3339" format. Note that this is required
USER         /// as "now" cannot be used to mantain the function pure.
USER         pub start_date: String,
USER         /// The expiry date of the certificate. This must
USER         /// be a string in the "RFC3339" format. Note that this is required
USER         /// as "now" cannot be used to mantain the function pure.
USER         pub expiry_date: String,
USER         /// This controls the parameters related to the
USER         /// 'openssl::x509::extension::KeyUsage' extension.
USER         /// The value for this field can either be (1) An
USER         /// empty vector which will forego this extension
USER         /// for the certificate or (2) A single value with
USER         /// the parameters for the 'openssl::x509::extension::KeyUsage'
USER         /// extension.
USER         /// Todo: this should be an optional but it is not yet supported
USER         /// by the 'cxx' crate.
USER         pub extension_key_usage: Vec<X509KeyUsage>,
USER         /// This controls the parameters passed to the
USER         /// 'openssl::x509::extension::BasicConstraints' extension.
USER         /// The value for this field should either be (1) an empty
USER         /// 'Vec' which will forego this extension or (2) a single
USER         /// value containing the parameters that will be passed
USER         /// to the 'openssl::x509::extension::BasicConstraints'
USER         /// extension.
USER         /// Todo: replace with an 'Option' once this is supported
USER         /// by the 'cxx' crate.
USER         pub extension_basic_constraints: Vec<X509BasicConstraints>
USER     }
