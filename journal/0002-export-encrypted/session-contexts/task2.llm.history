USER     /// Export an openssl private key credential encrypted with the given symmetric key,
USER     /// returning a PEM-formatted string containing the AES-128-CBC encrypted private key.
USER     ///
USER     /// This is a monomorphic wrapper around `export_decryptable` for the
USER     /// `OpensslPrivateKeyIdentity` credential type, making it callable from C++.
USER     pub fn cxx_export_decryptable_openssl_pkey(
USER         &self,
USER         symmetric_key: OpensslSymmetricKeyIdentity,
USER         credential: OpensslPrivateKeyIdentity,
USER     ) -> Result<String, Error> {
USER         export_decryptable(
USER             &self.0,
USER             &symmetric_key,
USER             &OpensslPrivateKeyIdentityWrapper(&credential),
USER         )
USER     }
USER }
