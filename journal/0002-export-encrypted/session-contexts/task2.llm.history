ASSISTANT pub fn nix_crypto_with_settings(params: &CxxString) -> Box<CxxNixCrypto> {
ASSISTANT 
ASSISTANT     let utf8_error = "Unexpected error in CryptoNix. The arguments supplied are not a valid utf-8 string. Please report this bug!";
ASSISTANT 
ASSISTANT     let nix_crypto = match params.to_str() {
ASSISTANT         Ok(rust_params) => {
ASSISTANT             CryptoNix::with_args(rust_params)
ASSISTANT         },
ASSISTANT         Err(_err) =>
ASSISTANT             CryptoNix::with_error(Error::CxxError(utf8_error.to_string()))
ASSISTANT     };
ASSISTANT     Box::new(CxxNixCrypto(nix_crypto))
ASSISTANT }
