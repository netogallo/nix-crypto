USER nix-crypto-core/src/openssl/pkey.rs
USER ```
USER use openssl::pkey::{PKey, Public, Private};
USER use openssl::rsa;
USER 
USER // Imports from this crate
USER use crate::error::{Error};
USER use crate::foundations::{IsCryptoStoreKeyDerivable};
USER use crate::store::{IsCryptoStoreKey, StoreHasher};
USER use crate::support::{Exportable};
USER 
USER #[repr(u8)]
USER pub enum Type {
USER     RsaKey = 0
USER }
USER 
USER impl From<u8> for Type {
USER 
USER     fn from(value: u8) -> Type {
USER 
USER         if value == Type::RsaKey as u8 {
USER             return Type::RsaKey;
USER         }
USER         
USER         panic!("The value {} is not a vaild RSA key type", value)
USER     }
USER }
USER 
USER impl From<Type> for u8 {
USER 
USER     fn from(value: Type) -> u8 {
USER         value as u8
USER     }
USER }
USER 
USER impl TryFrom<&str> for Type {
USER     type Error = Error;
USER 
USER     fn try_from(value: &str) -> Result<Type, Error> {
USER 
USER         let error_message = format!("The value {value} is not a known openssl private key type.");
USER 
USER         match value {
USER             "rsa" => Ok(Type::RsaKey),
USER             _ => Error::fail_with(error_message)
USER         }
USER     }
USER }
USER 
USER impl TryFrom<&String> for Type {
USER     type Error = Error;
USER 
USER     fn try_from(value: &String) -> Result<Type, Error> {
USER         Type::try_from(value.as_str())
USER     }
USER }
USER 
USER /// CryptoNix wrapper type around 'PKey'. The main purpose
USER /// of this struct is to provide an API that can be used
USER /// in C++ code.
USER pub struct Key {
USER     pub pkey: PKey<Private>
USER }
USER 
USER impl Key {
USER 
USER     pub fn key_to_pem(&self) -> Result<Vec<u8>, Error> {
USER         let result = self.pkey.private_key_to_pem_pkcs8()?;
USER         Ok(result)
USER     }
USER 
USER     pub fn key_from_pem(pem_bytes: &[u8]) -> Result<Self, Error> {
USER         let pkey = PKey::private_key_from_pem(pem_bytes)?;
USER         Ok(Self::from_openssl_pkey(pkey))
USER     }
USER 
USER     pub fn from_openssl_pkey(pkey: PKey<Private>) -> Self {
USER         Key { pkey: pkey }
USER     }
USER 
USER     pub fn new(key_type : Type) -> Result<Key, Error> {
USER 
USER         match key_type {
USER             Type::RsaKey => {
USER                 let rsa = rsa::Rsa::generate(4096)?;
USER                 Ok(Key::from_openssl_pkey(PKey::from_rsa(rsa)?))
USER             }
USER         }
USER     }
USER 
USER     pub fn public_pem(self: &Self) -> Result<String, Error> {
USER         let pem = self.pkey.public_key_to_pem()?;
USER         let result = String::from_utf8(pem)?;
USER         Ok(result)
USER     }
USER 
USER     pub fn public_key(&self) -> Result<PKey<Public>, Error> {
USER         let pem = self.pkey.public_key_to_pem()?;
USER         let result = PKey::public_key_from_pem(&pem)?;
USER         Ok(result)
USER     }
USER }
USER 
USER impl Exportable for Key {
USER     fn export(&self) -> Result<Vec<u8>, Error> {
USER         self.key_to_pem()
USER     }
USER }
USER 
USER /// This trait allows defining structs meant to be used as
USER /// identities for openssl private keys (in the context of
USER /// assymetric cryptography). They idea is that they contain
USER /// all the context needed to both uniquely reference a key
USER /// and generate the key if no reference currently exits.
USER pub trait IsOpensslPrivateKeyIdentity {
USER     fn key_type(&self) -> &String;
USER     fn key_id(&self) -> &String;
USER }
USER 
USER /// This struct serves as a wrapper to allow instances of the
USER /// `IsCrytpoStoreKey` and `IsCryptoStoreKeyDerivable` to be
USER /// implemented for any instance of `IsOpensslPrivatekeyIdentity`
USER /// without using blanket implementations.
USER pub struct OpensslPrivateKeyIdentityWrapper<'a, T>(pub &'a T);
USER 
USER impl<'a,T : IsOpensslPrivateKeyIdentity> IsCryptoStoreKey for OpensslPrivateKeyIdentityWrapper<'a, T> {
USER     type Value = Key;
USER 
USER     /// Derive a key for the store using the wrapped `IsOpensslPrivateKeyIdentity` instance.
USER     /// The key is derived by hashing all of the fields together.
USER     fn to_store_key_raw(&self, mut hasher: StoreHasher) -> Vec<u8> {
USER         let identity = self.0;
USER         hasher.update(identity.key_type().as_bytes());
USER         hasher.update(identity.key_id().as_bytes());
USER         Vec::from(hasher.finish())
USER     }
USER 
USER     /// Make a byte representation of the Openssl private key by converting
USER     /// it to pem format and then encoding the resulting string into a
USER     /// byte array.
USER     fn to_store_value_raw(value: &Self::Value) -> Result<Vec<u8>, Error> {
USER         Key::key_to_pem(value)
USER     }
USER 
USER     /// Recover the openssl private key by parsing the pem string which
USER     /// contains the key.
USER     fn from_store_value_raw(bytes: &Vec<u8>) -> Result<Self::Value, Error> {
USER         Key::key_from_pem(&bytes[..])
USER     }
USER }
USER 
USER impl<'a, T : IsOpensslPrivateKeyIdentity> IsCryptoStoreKeyDerivable for OpensslPrivateKeyIdentityWrapper<'a, T> {
USER 
USER     fn derive(&self) -> Result<Key, Error> {
USER         let key_type = Type::try_from(self.0.key_type())?;
USER         Key::new(key_type)
USER     }
USER }
USER ```
