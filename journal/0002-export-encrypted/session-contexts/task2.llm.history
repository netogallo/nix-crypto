ASSISTANT // This module will get parsed by the cxx:builder. Avoid anything
ASSISTANT // other than definitions strictly needed for the C++ bridge, as
ASSISTANT // any changes here incurr long re-compilation. For utilities
ASSISTANT // related to the CXX bridge, use the cxx_support module. Function
ASSISTANT // implementations for the functions in this module should be placed
ASSISTANT // in cxx_api
ASSISTANT use crate::cxx_api::*;
ASSISTANT 
ASSISTANT #[cxx::bridge]
ASSISTANT pub mod ffi {
ASSISTANT     /// This struct defines a key identity for openssl. An identity
ASSISTANT     /// is simply an object that is able to reference a particular key.
ASSISTANT     /// In order to avoid exposing private keys in nix code (so they cannot
ASSISTANT     /// land in the store), nix code will provide an identity (rather than
ASSISTANT     /// the private key) to indicate what key is to be used to sign/encrypt
ASSISTANT     /// values.
ASSISTANT     pub struct OpensslPrivateKeyIdentity {
ASSISTANT         pub key_type: String,
ASSISTANT         pub key_id : String
ASSISTANT     }
ASSISTANT 
ASSISTANT     /// This struct defines a symmetric key identity for openssl. It contains
ASSISTANT     /// all the information needed to derive and reference a symmetric key
ASSISTANT     /// used for encrypting credentials via `export_decryptable`.
ASSISTANT     pub struct OpensslSymmetricKeyIdentity {
ASSISTANT         pub key_id: String,
ASSISTANT         pub key_derivation: String,
ASSISTANT         pub iterations: u32,
ASSISTANT     }
ASSISTANT 
ASSISTANT     pub struct X509NameItem {
ASSISTANT         pub entry_name: String,
ASSISTANT         pub entry_value: String
ASSISTANT     }
ASSISTANT 
ASSISTANT     pub struct X509KeyUsage {
ASSISTANT         pub critical: bool,
ASSISTANT         pub key_cert_sign: bool,
ASSISTANT         pub crl_sign: bool
ASSISTANT     }
ASSISTANT 
ASSISTANT     pub struct X509BasicConstraints {
ASSISTANT         pub critical: bool,
ASSISTANT         pub ca: bool
ASSISTANT     }
ASSISTANT 
ASSISTANT     /// This struct identifies a X509Certificate. Note that
ASSISTANT     /// each parameter has additional constraints. The expectation
ASSISTANT     /// is that the same set of parameters will result in the same
ASSISTANT     /// certificate accross multiple invocations.
ASSISTANT     pub struct X509BuildParams {
ASSISTANT         /// The public key asociated to the private key of
ASSISTANT         /// the certificate's subject. The value should be one
ASSISTANT         /// of the following:
ASSISTANT         /// * A Vec containing a *single* element which must be
ASSISTANT         ///   the key as a PEM encoded String
ASSISTANT         /// * An *empty* Vec. In this case, the certificate will
ASSISTANT         ///   be a "self-signed" certificate, meaning the public
ASSISTANT         ///   key associated to the signing key will be the
ASSISTANT         ///   certificate's subject's private key.
ASSISTANT         ///
ASSISTANT         /// Todo: Ideally, this should be an 'Option<String>' but
ASSISTANT         /// it seems that is not supported by the CXX crate.
ASSISTANT         pub subject_public_key: Vec<String>,
ASSISTANT         /// The private key that will be used to sign the certificate.
ASSISTANT         pub signing_private_key_identity: OpensslPrivateKeyIdentity,
ASSISTANT         /// The name components of the certificate. Note that for
ASSISTANT         /// identity purposes, the order in which they are defined
ASSISTANT         /// does not matter. Furthermore, duplicate keys are not
ASSISTANT         /// allowed.
ASSISTANT         pub issuer_name: Vec<X509NameItem>,
ASSISTANT         pub subject_name: Vec<X509NameItem>,
ASSISTANT         /// The serial of the certificate
ASSISTANT         pub serial: u32,
ASSISTANT         /// The starting day of the certificate's validity. This must
ASSISTANT         /// be a string in the "RFC3339" format. Note that this is required
ASSISTANT         /// as "now" cannot be used to mantain the function pure.
ASSISTANT         pub start_date: String,
ASSISTANT         /// The expiry date of the certificate. This must
ASSISTANT         /// be a string in the "RFC3339" format. Note that this is required
ASSISTANT         /// as "now" cannot be used to mantain the function pure.
ASSISTANT         pub expiry_date: String,
ASSISTANT         /// This controls the parameters related to the
ASSISTANT         /// 'openssl::x509::extension::KeyUsage' extension.
ASSISTANT         /// The value for this field can either be (1) An
ASSISTANT         /// empty vector which will forego this extension
ASSISTANT         /// for the certificate or (2) A single value with
ASSISTANT         /// the parameters for the 'openssl::x509::extension::KeyUsage'
ASSISTANT         /// extension.
ASSISTANT         /// Todo: this should be an optional but it is not yet supported
ASSISTANT         /// by the 'cxx' crate.
ASSISTANT         pub extension_key_usage: Vec<X509KeyUsage>,
ASSISTANT         /// This controls the parameters passed to the
ASSISTANT         /// 'openssl::x509::extension::BasicConstraints' extension.
ASSISTANT         /// The value for this field should either be (1) an empty
ASSISTANT         /// 'Vec' which will forego this extension or (2) a single
ASSISTANT         /// value containing the parameters that will be passed
ASSISTANT         /// to the 'openssl::x509::extension::BasicConstraints'
ASSISTANT         /// extension.
ASSISTANT         /// Todo: replace with an 'Option' once this is supported
ASSISTANT         /// by the 'cxx' crate.
ASSISTANT         pub extension_basic_constraints: Vec<X509BasicConstraints>
ASSISTANT     }
