USER /// CXX wrapper type for "CryptoNix". This is meant to expose
USER /// the nix-crypto interface that will be accesible in C++
USER pub struct CxxNixCrypto(CryptoNix);
USER 
USER /// Create a 'CxxNixCrypto' instance. This function accepts
USER /// a 'CxxString' with the parameters for nix-crypto. It
USER /// will process the parameters as appropiate and construct
USER /// an instance of cryptonix configured with the given parameters.
USER pub fn nix_crypto_with_settings(params: &CxxString) -> Box<CxxNixCrypto> {
USER 
USER     let utf8_error = "Unexpected error in CryptoNix. The arguments supplied are not a valid utf-8 string. Please report this bug!";
USER 
USER     let nix_crypto = match params.to_str() {
USER         Ok(rust_params) => {
USER             CryptoNix::with_args(rust_params)
USER         },
USER         Err(_err) =>
USER             CryptoNix::with_error(Error::CxxError(utf8_error.to_string()))
USER     };
USER     Box::new(CxxNixCrypto(nix_crypto))
USER }
