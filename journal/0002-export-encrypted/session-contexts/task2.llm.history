USER │/// Format the current UTC time as an RFC3339 string using only `std::time`.
USER │fn current_time_rfc3339() -> String {
USER │    let secs = SystemTime::now()
USER │        .duration_since(UNIX_EPOCH)
USER │        .map(|d| d.as_secs())
USER │        .unwrap_or(0);
USER │
USER │    let s = secs % 60;
USER │    let m = (secs / 60) % 60;
USER │    let h = (secs / 3600) % 24;
USER │    let days = secs / 86400;
USER │
