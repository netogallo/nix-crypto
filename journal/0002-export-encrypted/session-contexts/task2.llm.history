USER nix-crypto-core/src/foundations.rs
USER ```
USER use crate::args::{CryptoNixArgs, CryptoNixMode, SledModeConfig};
USER use crate::error::*;
USER use crate::logger::{Logger, LogLevel};
USER use crate::store::*;
USER 
USER pub struct CryptoNix {
USER     store: Box<dyn CryptoStore>,
USER     logger: Logger,
USER }
USER 
USER /// This trait is meant to represent store keys which can be
USER /// used to derive the value which they intent to represent.
USER /// Many store keys have that property as they are usually
USER /// compromise a full spec of parameters that can be used
USER /// to derive a valid instance of the underlying value.
USER pub trait IsCryptoStoreKeyDerivable : IsCryptoStoreKey {
USER 
USER     fn derive(&self) -> Result<<Self as IsCryptoStoreKey>::Value, Error>;
USER }
USER 
USER impl CryptoNix {
USER 
USER     /// Get a byte Vector which uniquely represents the given
USER     /// `IsCryptoStoreKey` instance.
USER     fn to_store_key_raw<Key: IsCryptoStoreKey>(&self, key: &Key) -> Vec<u8> {
USER         let hasher = StoreHasher::init(self.salt());
USER         key.to_store_key_raw(hasher)
USER     }
USER 
USER     /// Try getting a value from the 'CryptoStore' which is associated
USER     /// with the 'key' parameter. If the value does not exist in the
USER     /// store, 'Nothing' is returned. Otherwise the value gets returned.
USER     /// This function might raise 'Error' if there is a fundamental issue
USER     /// with the store which prevents it from being read.
USER     pub fn get<K: IsCryptoStoreKey>(
USER         &self,
USER         key: &K
USER     ) -> Result<Option<<K as IsCryptoStoreKey>::Value>, Error> {
USER 
USER         let raw_key = self.to_store_key_raw(key);
USER         let identity = self.logger.to_log_identifier(&raw_key);
USER         let fn_name = "foundations::CryptoNix::get";
USER 
USER         match self.store.get_raw(&raw_key[..])? {
USER             Some(raw_value) => {
USER                 self.logger.log(
USER                     LogLevel::Debug,
USER                     "identity present",
USER                     &[
USER                         ("identity", &identity),
USER                         ("fn", &fn_name)
USER                     ],
USER                 );
USER                 Ok(Some(<K as IsCryptoStoreKey>::from_store_value_raw(&raw_value)?))
USER             },
USER             None => {
USER                 self.logger.log(
USER                     LogLevel::Debug,
USER                     "identity absent",
USER                     &[
USER                         ("identity", &identity),
USER                         ("fn", &fn_name)
USER                     ],
USER                 );
USER                 Ok(None)
USER             },
USER         }
USER     }
USER 
USER     pub fn get_or_derive<K: IsCryptoStoreKeyDerivable>(
USER         &self,
USER         key: &K
USER     ) -> Result<<K as IsCryptoStoreKey>::Value, Error> {
USER 
USER         match self.get(key)? {
USER             Some(raw_value) => Ok(raw_value),
USER             None => {
USER                 self.logger.log(
USER                     LogLevel::Debug,
USER                     "deriving value",
USER                     &[
USER                         ("fn", "foundations::CryptoNix::get_or_derive")
USER                     ],
USER                 );
USER                 let value = key.derive()?;
USER                 self.put(key, &value)?;
USER                 Ok(value)
USER             }
USER         }
USER     }
USER 
USER     pub fn put<K: IsCryptoStoreKey>(
USER         &self,
USER         key: &K,
USER         value: &<K as IsCryptoStoreKey>::Value
USER     ) -> Result<(), Error> {
USER 
USER         self.store.put_raw(
USER             &self.to_store_key_raw(key)[..],
USER             <K as IsCryptoStoreKey>::to_store_value_raw(value)?
USER         )
USER     }
USER 
USER     pub fn salt(&self) -> Vec<u8> {
USER         self.store.salt()
USER     }
USER 
USER     /// Construct a `CryptoNix` instance from a sled store configuration
USER     /// and a logger.
USER     pub fn from_sled_config(config: &SledModeConfig, logger: Logger) -> CryptoNix {
USER         match SledStore::open(&config.store_path) {
USER             Ok(store) => CryptoNix { store: Box::new(store), logger },
USER             Err(err) => Self::with_error(err),
USER         }
USER     }
USER 
USER     fn from_parsed_args(args: CryptoNixArgs) -> CryptoNix {
USER         match args.mode {
USER             CryptoNixMode::SledMode(sled) => Self::from_sled_config(&sled, args.logger),
USER             CryptoNixMode::ErrorMode(err) => Self::with_error(err),
USER         }
USER     }
USER 
USER     /// Parse the arguments and build a CryptoNix instance
USER     /// based on said arguments. If the arguments cannot be parsed,
USER     /// an instance will be constructed which will fail on every
USER     /// operation. CryptoNix, in general, uses this approach to allow
USER     /// enabling the plugin systemwide and not having nix crash
USER     /// if invoked w/o parameters.
USER     pub fn with_args(args: &str) -> CryptoNix {
USER         Self::from_parsed_args(CryptoNixArgs::from_args(args))
USER     }
USER 
USER     pub fn with_error(error: Error) -> CryptoNix {
USER         CryptoNix {
USER             store: Box::new(ErrorStore::from_error(error)),
USER             logger: Logger::dummy(),
USER         }
USER     }
USER }
USER ```
USER 
USER nix-crypto-core/src/openssl.rs
USER ```
USER use openssl::bn::{BigNum};
USER use openssl::hash::{MessageDigest};
USER use openssl::pkey::{PKey, Public};
USER use openssl::x509::{X509Builder};
USER use openssl::x509::extension::{AuthorityKeyIdentifier, SubjectKeyIdentifier};
USER 
USER use crate::error::{Error};
USER use crate::foundations::{CryptoNix, IsCryptoStoreKeyDerivable};
USER use crate::support::{Exportable};
USER 
USER pub mod export;
USER pub mod pkey;
USER pub mod decryptable;
USER 
USER /// This module defines traits which describe the fields expected from
USER /// CXX types. The reason why this is needed is because the "cxx" crate
USER /// needs types to be defined in the same module in order for the fields
USER /// of the type to be visible in C++. Since theese types are built with
USER /// C++ code and then passed to rust code they cannot be opaque and cannot
USER /// be defined in this crate as this crate is meant to contain all the core
USER /// logic of nix-crypto as a rust library which should not have any dependencies
USER /// on the nix libraries.
USER pub mod ffi {
USER 
USER     use openssl::asn1::{Asn1Time};
USER     use openssl::pkey::*;
USER     use openssl::x509::*;
USER     use openssl::x509::extension::*;
USER     use time::{UtcDateTime};
USER     use time::format_description::well_known::{Rfc3339};
USER 
USER     // Modules from this crate
USER     use crate::error::*;
USER 
USER     pub use crate::openssl::pkey::{IsOpensslPrivateKeyIdentity};
USER 
USER     pub trait IsX509NameItem {
USER         fn entry_name(&self) -> &String;
USER         fn entry_value(&self) -> &String;
USER     }
USER 
USER     pub trait IsX509KeyUsage {
USER         fn critical(&self) -> bool;
USER         fn key_cert_sign(&self) -> bool;
USER         fn crl_sign(&self) -> bool;
USER     }
USER 
USER     pub trait IsX509BasicConstraints {
USER         fn critical(&self) -> bool; 
USER         fn ca(&self) -> bool;
USER     }
USER 
USER     pub trait IsX509BuildParams {
USER         type PrivateKeyIdentity : IsOpensslPrivateKeyIdentity;
USER         type NameItem : IsX509NameItem;
USER         type KeyUsage : IsX509KeyUsage;
USER         type BasicConstraints : IsX509BasicConstraints;
USER 
USER         fn subject_public_key(&self) -> Option<&String>;
USER         fn signing_private_key_identity(&self) -> &Self::PrivateKeyIdentity;
USER         fn issuer_name(&self) -> &Vec<Self::NameItem>;
USER         fn subject_name(&self) -> &Vec<Self::NameItem>;
USER         fn serial(&self) -> u32;
USER         fn start_date(&self) -> &String;
USER         fn expiry_date(&self) -> &String;
USER         fn extension_key_usage(&self) -> Option<&Self::KeyUsage>;
USER         fn extension_basic_constraints(&self) -> Option<&Self::BasicConstraints>;
USER     }
USER 
USER     fn name_from_entries<T : IsX509NameItem>(entries: &Vec<T>) -> Result<X509Name, Error> {
USER         let mut builder = X509NameBuilder::new()?;
USER         for entry in entries.iter() {
USER             builder.append_entry_by_text(
USER                 entry.entry_name().as_str(),
USER                 entry.entry_value().as_str()
USER             )?;
USER         }
USER     
USER         Ok(builder.build())
USER     }
USER 
USER     fn parse_date_rfc3339(date: &str) -> Result<Asn1Time, Error> {
USER         let utc = UtcDateTime::parse(date, &Rfc3339)?;
USER         Ok(Asn1Time::from_unix(utc.unix_timestamp())?)
USER     }
USER 
USER     
USER     pub fn as_key_usage_extension<T: IsX509KeyUsage>(key_usage: &T) -> Result<X509Extension, Error> {
USER     
USER         let mut builder = KeyUsage::new();
USER     
USER         if key_usage.critical() {
USER             builder.critical();
USER         }
USER     
USER         if key_usage.key_cert_sign() {
USER             builder.key_cert_sign();
USER         }
USER     
USER         if key_usage.crl_sign() {
USER             builder.crl_sign();
USER         }
USER     
USER         Ok(builder.build()?)
USER     }
USER     
USER     pub fn as_basic_constraints_extension<T: IsX509BasicConstraints>(basic_constraints: &T) -> Result<X509Extension, Error> {
USER     
USER         let mut builder = BasicConstraints::new();
USER     
USER         if basic_constraints.critical() {
USER             builder.critical();
USER         }
USER     
USER         if basic_constraints.ca() {
USER             builder.ca();
USER         }
USER     
USER         Ok(builder.build()?)
USER     }
USER 
USER     
USER     pub fn get_subject_public_key<T: IsX509BuildParams>(params: &T) -> Result<Option<PKey<Public>>, Error> {
USER     
USER         match params.subject_public_key() {
USER             Some(pem) => {
USER                 let result = PKey::public_key_from_pem(pem.as_bytes())?;
USER                 Ok(Some(result))
USER             },
USER             None => Ok(None)
USER         }
USER     }
USER     
USER     pub fn build_issuer_name<T: IsX509BuildParams>(params: &T) -> Result<X509Name, Error> {
USER         name_from_entries(&params.issuer_name())
USER     }
USER     
USER     pub fn build_subject_name<T: IsX509BuildParams>(params: &T) -> Result<X509Name, Error> {
USER         name_from_entries(&params.subject_name())
USER     }
USER     
USER     pub fn start_date_as_asn1<T: IsX509BuildParams>(params: &T) -> Result<Asn1Time, Error> {
USER         parse_date_rfc3339(&params.start_date())
USER     }
USER     
USER     pub fn expiry_date_as_asn1<T: IsX509BuildParams>(params: &T) -> Result<Asn1Time, Error> {
USER         parse_date_rfc3339(&params.expiry_date())
USER     }
USER     
USER     /// Convert the key usage declarations specified in the CXX struct
USER     /// into a 'X509Extension' which can be applied when building
USER     /// a 'X509' certificate.
USER     pub fn build_key_usage_ext<T: IsX509BuildParams>(params: &T) -> Result<Option<X509Extension>, Error> {
USER         params.extension_key_usage()
USER             .map(|e : &T::KeyUsage| as_key_usage_extension(e))
USER             .transpose()
USER     }
USER     
USER     /// Convert the basic constraints that have been declared in the
USER     /// CXX call into a 'X509Extension', which can be applied when building
USER     /// a 'X509' certificate.
USER     pub fn build_basic_constraints_ext<T: IsX509BuildParams>(params: &T) -> Result<Option<X509Extension>, Error> {
USER         params.extension_basic_constraints()
USER             .map(|e : &T::BasicConstraints| as_basic_constraints_extension(e))
USER             .transpose()
USER     }
USER }
USER 
USER pub mod x509 {
USER     use openssl::x509::{X509};
USER 
USER     use crate::error::{Error};
USER 
USER     /// This is a wrapper tipe for the 'X509' type defined in the
USER     /// 'openssl' crate. The main purpose of this type is to
USER     /// expose methods which can be invoked from C++ code.
USER     pub struct X509Certificate {
USER         pub certificate: X509
USER     }
USER 
USER     impl X509Certificate {
USER 
USER         pub fn new(cert: X509) -> Self {
USER             X509Certificate { certificate: cert }
USER         }
USER 
USER         pub fn public_pem(&self) -> Result<String, Error> {
USER             let pem = self.certificate.to_pem()?;
USER             let result = String::from_utf8(pem)?;
USER             Ok(result)
USER         }
USER     }
USER }
USER 
USER impl CryptoNix {
USER 
USER     /// Get the Openssl private key which corresponds to the
USER     /// given 'OpensslPrivateKeyIdentity'. If there is no key
USER     /// associated with that identity, a fresh key will be
USER     /// generated and saved to the store.
USER     pub fn openssl_private_key<T : pkey::IsOpensslPrivateKeyIdentity>(
USER         &self,
USER         key_identity: &T
USER     ) -> Result<pkey::Key, Error> {
USER         self.get_or_derive(&pkey::OpensslPrivateKeyIdentityWrapper(key_identity))
USER     }
USER 
USER     /// Construct an X509 certificate. This function accepts a 'X50BuildParams'
USER     /// which describe how the certificate is to be built in the context of
USER     /// nix-crypto.
USER     pub fn openssl_x509_certificate<T : ffi::IsX509BuildParams>(
USER         &self,
USER         params: &T
USER     ) -> Result<x509::X509Certificate, Error> {
USER 
USER         let signing_key = self.openssl_private_key(params.signing_private_key_identity())?;
USER 
USER         let subject_key: PKey<Public> = match ffi::get_subject_public_key(params)? {
USER 
USER             // Subject has been explicitly provided
USER             Some(sub) => sub,
USER 
USER             // No subject provided, certificate will be self-sigend
USER             None => signing_key.public_key()?
USER         };
USER 
USER         let mut builder = X509Builder::new()?;
USER         let issuer_name = ffi::build_issuer_name(params)?;
USER         let subject_name = ffi::build_subject_name(params)?;
USER 
USER         builder.set_pubkey(&subject_key)?;
USER         builder.set_issuer_name(&issuer_name)?;
USER         builder.set_subject_name(&subject_name)?;
USER 
USER         let serial = BigNum::from_u32(params.serial())?.to_asn1_integer()?;
USER         builder.set_serial_number(&serial)?;
USER 
USER         let start_date = ffi::start_date_as_asn1(params)?;
USER         let expiry_date = ffi::expiry_date_as_asn1(params)?;
USER         builder.set_not_before(&start_date)?;
USER         builder.set_not_after(&expiry_date)?;
USER 
USER         ffi::build_key_usage_ext(params)?
USER             .map(|e| builder.append_extension(e))
USER             .transpose()?;
USER 
USER         ffi::build_basic_constraints_ext(params)?
USER             .map(|e| builder.append_extension(e))
USER             .transpose()?;
USER 
USER         builder.append_extension(
USER             SubjectKeyIdentifier::new().build(&builder.x509v3_context(None, None))?,
USER         )?;
USER 
USER         builder.append_extension(
USER             AuthorityKeyIdentifier::new()
USER                 .keyid(true)
USER                 .build(&builder.x509v3_context(None, None))?,
USER         )?;
USER 
USER         builder.sign(&signing_key.pkey, MessageDigest::sha256())?;
USER 
USER         Ok(x509::X509Certificate::new(builder.build()))
USER     }
USER 
USER     /// Export a credential encrypted with a symmetric key, returning a
USER     /// PEM-formatted string. All logic is delegated to the `decryptable` module.
USER     pub fn export_decryptable<K, C>(
USER         &self,
USER         key: &K,
USER         credential: &C,
USER     ) -> Result<String, Error>
USER     where
USER         K: decryptable::IsOpensslSymmetricKeyIdentity,
USER         C: IsCryptoStoreKeyDerivable,
USER         C::Value: Exportable,
USER     {
USER         decryptable::export_decryptable(self, key, credential)
USER     }
USER 
USER     /// Retrieve (or derive and store) the random passphrase for the symmetric
USER     /// key identified by `key`. Returns the passphrase string which is used as
USER     /// input to the key derivation function.
USER     ///
USER     /// Calling this method multiple times with the same `key` and store will
USER     /// always return the same passphrase, because the value is stored on the
USER     /// first call and reused thereafter.
USER     pub fn openssl_symmetric_key_passphrase<K: decryptable::IsOpensslSymmetricKeyIdentity>(
USER         &self,
USER         key: &K,
USER     ) -> Result<String, Error> {
USER         decryptable::get_symmetric_key_passphrase(self, key)
USER     }
USER 
USER     
USER     /// This function allows exporting private store credentials in an
USER     /// encrypted form. This allows safely writing the encrypted credentials
USER     /// to the nix store which can be decrypted by a system which controls
USER     /// the key used for the encryption.
USER     pub fn export_encrypted<K, C>(
USER         &self,
USER         key: &K,
USER         credential: &C,
USER     ) -> Result<String, Error>
USER     where
USER         K: pkey::IsOpensslPrivateKeyIdentity,
USER         C: IsCryptoStoreKeyDerivable,
USER         C::Value: Exportable,
USER     {
USER         export::export_encrypted(self, key, credential)
USER     }
USER }
USER ```
