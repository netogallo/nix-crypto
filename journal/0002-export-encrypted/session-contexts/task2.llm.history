USER │/// Uses the algorithm from <http://howardhinnant.github.io/date_algorithms.html>.
USER │fn days_to_ymd(days: u64) -> (u64, u64, u64) {
USER │    let z = days + 719468;
USER │    let era = z / 146097;
USER │    let doe = z % 146097;
USER │    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
USER │    let y = yoe + era * 400;
USER │    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
USER │    let mp = (5 * doy + 2) / 153;
USER │    let d = doy - (153 * mp + 2) / 5 + 1;
USER │    let m = if mp < 10 { mp + 3 } else { mp - 9 };
