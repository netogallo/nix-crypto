ASSISTANT static void primop_openssl_x509_pem(EvalState& state, const PosIdx pos, Value** args, Value& result) {
ASSISTANT     try {
ASSISTANT         auto pem = primops->opensslX509Pem(
ASSISTANT             toX509Params(state, pos, *args[0])
ASSISTANT         );
ASSISTANT         result.mkString(pem);
ASSISTANT     } catch(rust::Error& e) {
ASSISTANT         state.error<EvalError>(e.what())
ASSISTANT             .atPos(pos)
ASSISTANT             .debugThrow();
ASSISTANT     }
ASSISTANT }
