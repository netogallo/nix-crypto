USER use openssl::encrypt::Encrypter;
USER use openssl::pkey::PKey;
USER use openssl::rsa::Padding;
USER use openssl::symm::{encrypt, Cipher};
USER use openssl::rand::rand_bytes;
USER use base64::engine::general_purpose::STANDARD;
USER use base64::Engine;
USER 
USER use crate::error::Error;
USER use crate::foundations::{CryptoNix, IsCryptoStoreKeyDerivable};
USER use crate::store::{IsCryptoStoreKey, StoreHasher};
USER use crate::support::Exportable;
USER use crate::openssl::pkey::{IsOpensslPrivateKeyIdentity, Key, OpensslPrivateKeyIdentityWrapper};
USER 
USER // The result of asymmetric encryption, storing the RSA-OAEP encrypted
USER // symmetric key and the IV-prepended AES-256-CBC ciphertext.
USER struct AsymmetricEncryptionResult {
USER     encrypted_key: Vec<u8>,
USER     iv_and_ciphertext: Vec<u8>,
USER }
USER 
USER struct AsymmetricEncryptionRequest<Cred>
USER where
USER     Cred: IsCryptoStoreKeyDerivable,
USER     Cred::Value: Exportable,
USER {
USER     store_key: Vec<u8>,
USER     pkey: Key,
USER     credential: Cred::Value,
USER }
USER 
USER impl<C> IsCryptoStoreKey for AsymmetricEncryptionRequest<C>
USER where
USER     C: IsCryptoStoreKeyDerivable,
USER     C::Value: Exportable,
USER {
USER     type Value = AsymmetricEncryptionResult;
USER 
USER     fn to_store_key_raw(&self, _hasher: StoreHasher) -> Vec<u8> {
USER         self.store_key.clone()
USER     }
USER 
USER     fn to_store_value_raw(value: &Self::Value) -> Result<Vec<u8>, Error> {
USER         let key_len = value.encrypted_key.len() as u32;
USER         let mut result = Vec::new();
USER         result.extend_from_slice(&key_len.to_be_bytes());
USER         result.extend_from_slice(&value.encrypted_key);
USER         result.extend_from_slice(&value.iv_and_ciphertext);
USER         Ok(result)
USER     }
USER 
USER     fn from_store_value_raw(value: &Vec<u8>) -> Result<Self::Value, Error> {
USER         if value.len() < 4 {
USER             return Err(Error::CryptoNixError(
USER                 "AsymmetricEncryptionResult: stored value too short".to_string()
USER             ));
USER         }
USER         let key_len = u32::from_be_bytes([value[0], value[1], value[2], value[3]]) as usize;
USER         if value.len() < 4 + key_len {
USER             return Err(Error::CryptoNixError(
USER                 "AsymmetricEncryptionResult: stored value truncated".to_string()
USER             ));
USER         }
USER         let encrypted_key = value[4..4 + key_len].to_vec();
USER         let iv_and_ciphertext = value[4 + key_len..].to_vec();
USER         Ok(AsymmetricEncryptionResult { encrypted_key, iv_and_ciphertext })
USER     }
USER }
USER 
USER impl<C> IsCryptoStoreKeyDerivable for AsymmetricEncryptionRequest<C>
USER where
USER     C: IsCryptoStoreKeyDerivable,
USER     C::Value: Exportable,
USER {
USER     fn derive(&self) -> Result<AsymmetricEncryptionResult, Error> {
USER         // Export the credential to bytes.
USER         let credential_bytes = self.credential.export()?;
USER 
USER         // Generate a random 256-bit (32 byte) AES symmetric key.
USER         let mut sym_key = vec![0u8; 32];
USER         rand_bytes(&mut sym_key)?;
USER 
USER         // Generate a random 128-bit (16 byte) IV for AES-256-CBC.
USER         let mut iv = vec![0u8; 16];
USER         rand_bytes(&mut iv)?;
USER 
USER         // Encrypt the credential bytes with AES-256-CBC.
USER         let cipher = Cipher::aes_256_cbc();
USER         let ciphertext = encrypt(cipher, &sym_key, Some(&iv), &credential_bytes)?;
USER 
USER         // Prepend the IV to the ciphertext.
USER         let mut iv_and_ciphertext = iv;
USER         iv_and_ciphertext.extend_from_slice(&ciphertext);
USER 
USER         // Encrypt the symmetric key with RSA-OAEP using the asymmetric public key.
USER         let pkey_ref = PKey::from_rsa(self.pkey.pkey.rsa()?)?;
USER         let mut encrypter = Encrypter::new(&pkey_ref)?;
USER         encrypter.set_rsa_padding(Padding::PKCS1_OAEP)?;
USER 
USER         let buffer_len = encrypter.encrypt_len(&sym_key)?;
USER         let mut encrypted_key = vec![0u8; buffer_len];
USER         let actual_len = encrypter.encrypt(&sym_key, &mut encrypted_key)?;
USER         encrypted_key.truncate(actual_len);
USER 
USER         Ok(AsymmetricEncryptionResult {
USER             encrypted_key,
USER             iv_and_ciphertext,
USER         })
USER     }
USER }
USER 
USER /// Encode a byte slice as a PEM block with the given label.
USER fn encode_pem(label: &str, data: &[u8]) -> String {
USER     let encoded = STANDARD.encode(data);
USER     // Split base64 into 64-character lines as per PEM convention.
USER     let lines: Vec<&str> = encoded
USER         .as_bytes()
USER         .chunks(64)
USER         .map(|chunk| std::str::from_utf8(chunk).unwrap())
USER         .collect();
USER     format!(
USER         "-----BEGIN {}-----\n{}\n-----END {}-----\n",
USER         label,
USER         lines.join("\n"),
USER         label
USER     )
USER }
USER 
USER pub fn export_encrypted<K, C>(
USER     crypto_nix: &CryptoNix,
USER     key: &K,
USER     credential: &C,
USER ) -> Result<String, Error>
USER where
USER     K: IsOpensslPrivateKeyIdentity,
USER     C: IsCryptoStoreKeyDerivable,
USER     C::Value: Exportable,
USER {
USER     // Resolve the asymmetric key using get_or_derive.
USER     let pkey_wrapper = OpensslPrivateKeyIdentityWrapper(key);
USER     let pkey = crypto_nix.get_or_derive(&pkey_wrapper)?;
USER 
USER     // Resolve the credential using get_or_derive.
USER     let resolved_credential = crypto_nix.get_or_derive(credential)?;
USER 
USER     // Compute the store key by hashing the asymmetric key identity and
USER     // credential identity together using StoreHasher.
USER     let mut hasher = StoreHasher::init(crypto_nix.salt());
USER     hasher.update(b"asymmetric_encryption");
USER     hasher.update_with_identity(&pkey_wrapper);
USER     hasher.update_with_identity(credential);
USER     let store_key = Vec::from(hasher.finish());
USER 
USER     // Construct the AsymmetricEncryptionKey struct.
USER     let asym_enc_key = AsymmetricEncryptionRequest::<C> {
USER         store_key,
USER         pkey,
USER         credential: resolved_credential,
USER     };
USER 
USER     // Get or compute the AsymmetricEncryptionResult.
USER     let result = crypto_nix.get_or_derive(&asym_enc_key)?;
USER 
USER     // PEM-encode the encrypted symmetric key.
USER     let encrypted_key_pem = encode_pem("ENCRYPTED KEY", &result.encrypted_key);
USER 
USER     // PEM-encode the IV-prepended ciphertext.
USER     let encrypted_data_pem = encode_pem("ENCRYPTED DATA", &result.iv_and_ciphertext);
USER 
USER     // Concatenate and return.
USER     Ok(format!("{}{}", encrypted_key_pem, encrypted_data_pem))
USER }
USER ```
