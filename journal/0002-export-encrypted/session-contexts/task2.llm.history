ASSISTANT const std::string K_SUBJECT_PUBLIC_KEY = "subject-public-key";
ASSISTANT const std::string K_SIGNING_PRIVATE_KEY_IDENTITY = "signing-private-key-identity";
ASSISTANT const std::string K_SUBJECT_NAME = "subject-name";
ASSISTANT const std::string K_ISSUER_NAME = "issuer-name";
ASSISTANT const std::string K_SERIAL = "serial";
ASSISTANT const std::string K_START_DATE = "start-date";
ASSISTANT const std::string K_EXPIRY_DATE = "expiry-date";
ASSISTANT const std::string K_BASIC_CONSTRAINTS = "basic-constraints";
ASSISTANT const std::string K_KEY_USAGE = "key-usage";
ASSISTANT 
ASSISTANT static X509BuildParams toX509Params(EvalState& state, const PosIdx pos, Value& params) {
ASSISTANT 
ASSISTANT     state.forceAttrs(params, pos, "while evaluating the openssl build parameters to build an X509 certificate.");
ASSISTANT 
ASSISTANT     auto subjectPublicKey = tryGetString(state, pos, K_SUBJECT_PUBLIC_KEY, params);
ASSISTANT     auto signingKey = openssl_get_private_key_identity(
ASSISTANT         state,
ASSISTANT         pos,
ASSISTANT         *state.getAttr(
ASSISTANT             state.symbols.create(K_SIGNING_PRIVATE_KEY_IDENTITY),
ASSISTANT             params.attrs(),
ASSISTANT             std::format("while accessing the '{}' attribute.", K_SIGNING_PRIVATE_KEY_IDENTITY)
ASSISTANT         )->value
ASSISTANT     );
ASSISTANT     auto subjectName =
ASSISTANT         asX509Name(
ASSISTANT             state,
ASSISTANT             pos,
ASSISTANT             *state.getAttr(
ASSISTANT                 state.symbols.create(K_SUBJECT_NAME),
ASSISTANT                 params.attrs(),
ASSISTANT                 "A 'x509 subject name' must be provided as a attribute set of strings"
ASSISTANT             )->value
ASSISTANT         );
ASSISTANT     auto issuerName =
ASSISTANT         asX509Name(
ASSISTANT             state,
ASSISTANT             pos,
ASSISTANT             *state.getAttr(
ASSISTANT                 state.symbols.create(K_ISSUER_NAME),
ASSISTANT                 params.attrs(),
ASSISTANT                 "A 'x509 issuer name' must be provided as a attribute set of strings"
ASSISTANT             )->value
ASSISTANT         );
ASSISTANT 
ASSISTANT     int serial =
ASSISTANT         state.forceInt(
ASSISTANT             *state.getAttr(
ASSISTANT                 state.symbols.create(K_SERIAL),
ASSISTANT                 params.attrs(),
ASSISTANT                 "A 'x509 serial' must be provided as an integer"
ASSISTANT             )->value,
ASSISTANT             pos,
ASSISTANT             std::format("A 'X509' serial must be provided as an int under the attribute {}", K_SERIAL)
ASSISTANT         ).value;
ASSISTANT 
ASSISTANT     auto startDate =
ASSISTANT         state.forceString(
ASSISTANT             *state.getAttr(
ASSISTANT                 state.symbols.create(K_START_DATE),
ASSISTANT                 params.attrs(),
ASSISTANT                 "A starting date must be provided as a string formatted using the 'RFC 3339' standard."
ASSISTANT             )->value,
ASSISTANT             pos,
ASSISTANT             std::format("A starting date must be provided as a string formatted using the 'RFC 3339' standard under the '{}' attribute", K_START_DATE)
ASSISTANT         ).data();
ASSISTANT 
ASSISTANT     auto expiryDate =
ASSISTANT         state.forceString(
ASSISTANT             *state.getAttr(
ASSISTANT                 state.symbols.create(K_EXPIRY_DATE),
ASSISTANT                 params.attrs(),
ASSISTANT                 "An expiry date must be provided as a string formatted using the 'RFC 3339' standard."
ASSISTANT             )->value,
ASSISTANT             pos,
ASSISTANT             std::format("A expiry date must be provided as a string formatted using the 'RFC 3339' standard under the '{}' attribute", K_START_DATE)
ASSISTANT         ).data();
ASSISTANT 
ASSISTANT     auto basicConstraints = tryGetBasicConstraints(state, pos, K_BASIC_CONSTRAINTS, params);
ASSISTANT 
ASSISTANT     auto keyUsage = tryGetKeyUsage(state, pos, K_KEY_USAGE, params);
ASSISTANT 
ASSISTANT     return {
ASSISTANT         .subject_public_key = std::move(subjectPublicKey),
ASSISTANT         .signing_private_key_identity = std::move(signingKey),
ASSISTANT         .issuer_name = std::move(issuerName),
ASSISTANT         .subject_name = std::move(subjectName),
ASSISTANT         .serial = static_cast<uint32_t>(serial),
ASSISTANT         .start_date = rust::String(startDate),
ASSISTANT         .expiry_date = rust::String(expiryDate),
ASSISTANT         .extension_key_usage = std::move(keyUsage),
ASSISTANT         .extension_basic_constraints = std::move(basicConstraints)
ASSISTANT     };
ASSISTANT }
