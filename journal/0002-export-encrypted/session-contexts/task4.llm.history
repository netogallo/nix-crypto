USER /// This enum is meant to represent the rust types which can
USER /// be represented as primitive values in nix.
USER pub enum NixValue {
USER     NixIntValue(i32),
USER     NixStringValue(String),
USER     NixAttrsValue(NixAttrs)
USER }
USER 
USER /// This data structure is meant to represent data in such
USER /// a way that it can be represented as a Nix attribute set.
USER pub struct NixAttrs {
USER     nix_values : HashMap<String, NixValue>
USER }
USER 
USER impl NixAttrs {
USER 
USER     pub fn from_hash_map(nix_values: HashMap<String, NixValue>) -> NixAttrs {
USER         NixAttrs { nix_values }
USER     }
USER }
USER 
USER impl From<HashMap<String, NixValue>> for NixAttrs {
USER     fn from(value: HashMap<String, NixValue>) -> NixAttrs {
USER         NixAttrs::from_hash_map(value)
USER     }
USER }
USER 
USER impl From<String> for NixValue {
