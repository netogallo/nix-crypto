USER use ctor::{ctor,dtor};
USER use cxx_bridge::ffi::{init_primops, destroy_primops};
USER 
USER mod cxx_api;
USER mod cxx_bridge;
USER mod cxx_support;
USER 
USER #[ctor]
USER fn init() {
USER     init_primops();
USER }
USER 
USER #[dtor]
USER fn exit() {
USER     destroy_primops();
USER }
