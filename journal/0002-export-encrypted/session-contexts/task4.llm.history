ASSISTANT In Rust, you can define an enum with values like this:
ASSISTANT 
ASSISTANT ```rust
ASSISTANT enum MyEnum {
ASSISTANT     Variant1,          // Unit variant (no value)
ASSISTANT     Variant2(i32),     // Tuple variant (with a single value)
ASSISTANT     Variant3 { field1: String, field2: u32 }, // Struct variant (with named fields)
ASSISTANT }
ASSISTANT ```
ASSISTANT 
ASSISTANT Here's a complete example file demonstrating different ways to define enums with values:
ASSISTANT 
ASSISTANT example_enum.rs
ASSISTANT ```
ASSISTANT enum SimpleEnum {
ASSISTANT     A,
ASSISTANT     B,
ASSISTANT     C,
ASSISTANT }
ASSISTANT 
ASSISTANT enum TupleEnum {
ASSISTANT     Empty,
ASSISTANT     Single(i32),
ASSISTANT     Double(i32, String),
ASSISTANT     Triple(i32, String, bool),
ASSISTANT }
ASSISTANT 
ASSISTANT enum StructEnum {
ASSISTANT     Empty,
ASSISTANT     WithFields { name: String, value: i32 },
ASSISTANT     WithOptional { required: u32, optional: Option<String> },
ASSISTANT }
ASSISTANT 
ASSISTANT fn main() {
ASSISTANT     // Simple enum usage
ASSISTANT     let simple = SimpleEnum::A;
ASSISTANT 
ASSISTANT     // Tuple enum usage
ASSISTANT     let tuple_single = TupleEnum::Single(42);
ASSISTANT     let tuple_double = TupleEnum::Double(10, "hello".to_string());
ASSISTANT 
ASSISTANT     // Struct enum usage
ASSISTANT     let struct_variant = StructEnum::WithFields {
ASSISTANT         name: "test".to_string(),
ASSISTANT         value: 123,
ASSISTANT     };
ASSISTANT }
ASSISTANT ```
