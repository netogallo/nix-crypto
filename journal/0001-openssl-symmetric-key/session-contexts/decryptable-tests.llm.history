USER USER │    let z = days + 719468;
USER USER │    let era = z / 146097;
USER USER │    let doe = z % 146097;
USER USER │    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
USER USER │    let y = yoe + era * 400;
USER USER │    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
USER USER │    let mp = (5 * doy + 2) / 153;
USER USER │    let d = doy - (153 * mp + 2) / 5 + 1;
USER USER │    let m = if mp < 10 { mp + 3 } else { mp - 9 };
