USER crypto/openssl/main.nix
USER ```
USER /**
USER   OpenSSL cryptographic operations for nix-crypto.
USER */
USER { pkgs, prelude, private-key-spec-type, x509-params-type, export-decryptable-pkey-params-type, ... }@module:
USER let
USER   inherit (pkgs) lib;
USER   inherit (lib) types;
USER   inherit (builtins.crypto) openssl;
USER   type-checker = prelude.type-checker {
USER     file = "${./openssl.nix}";
USER   };
USER 
USER   /**
USER     Produces a deterministic key identity string from an attribute set.
USER     Keys are sorted alphabetically and joined as `key=value` pairs separated
USER     by `&`. For example, `{ vault = "openssl"; name = "my-key"; }` produces
USER     `"name=my-key&vault=openssl"`.
USER 
USER     This string is used by both the nix-crypto plugin (to store the key) and
USER     `nix-crypto-service` (to look it up). The sort order ensures the identity
USER     is stable regardless of the order in which `attrs` is defined in nix.
USER   */
USER   to-key-identity = attrs:
USER     let
USER       keys = lib.sort (a: b: a < b) (lib.attrNames attrs);
USER       mk-entry = k:
USER         let
USER           value = attrs.${k};
USER         in
USER           "${k}=${value}"
USER       ;
USER     in
USER       lib.concatStringsSep "&" (lib.map mk-entry keys)
USER   ;
USER 
USER   /**
USER     Build an X.509 certificate signed by the given private key.
USER     Returns an attribute set with:
USER     - `certificate-pem`: the certificate in PEM format.
USER   */
USER   x509 = { key-ref, x509-params }:
USER   let
USER     x509-params-all =
USER       x509-params
USER       // { signing-private-key-identity = key-ref; }
USER     ;
USER   in
USER     {
USER       certificate-pem = openssl.x509-pem x509-params-all;
USER     }
USER   ;
USER 
USER   /**
USER     Export a private key credential encrypted with the given symmetric key.
USER     Returns a PEM-formatted string containing the AES-128-CBC encrypted
USER     private key.
USER 
USER     The same inputs (symmetric-key-params, key-ref, store) will always
USER     produce identical output, as the salt and IV are persisted in the store
USER     on the first call and reused thereafter.
USER   */
USER   export-decryptable-pkey = { key-ref, symmetric-key-params }:
USER     openssl.export-decryptable-pkey symmetric-key-params key-ref
USER   ;
USER 
USER   /**
USER     Retrieve or generate an OpenSSL private key.
USER     Accepts a `key-spec` with:
USER     - `attrs`: an attribute set of key-value pairs used to construct the key
USER       identity string (e.g. `{ vault = "openssl"; name = "my-key"; }`).
USER     - `type`: the key type string (e.g. `"rsa"`).
USER 
USER     Returns an attribute set with:
USER     - `identity`: the key identity string produced by `to-key-identity`. Exposed
USER       so that callers (e.g. `nix-crypto-service`) can locate the key in the
USER       sled store without reconstructing the identity manually.
USER     - `public-key-pem`: the public key in PEM format, computed by the nix plugin.
USER     - `x509`: a function to build X.509 certificates signed by this key.
USER     - `export-decryptable-pkey`: a function to export this private key encrypted
USER       with a symmetric key.
USER   */
USER   private-key-impl = key-spec:
USER   let
USER     key-ref = {
USER       key-identity = to-key-identity key-spec.attrs;
USER       key-type = key-spec.type;
USER     };
USER   in
USER     {
USER       identity = key-ref.key-identity;
USER       public-key-pem = openssl.public-key-pem key-ref;
USER       x509 =
USER         type-checker.function
USER         [ { name = "x509-params"; type = x509-params-type; } ]
USER         (x509-params: x509 { inherit key-ref x509-params; })
USER       ;
USER       export-decryptable-pkey =
USER         type-checker.function
USER         [ { name = "symmetric-key-params"; type = export-decryptable-pkey-params-type; } ]
USER         (symmetric-key-params: export-decryptable-pkey { inherit key-ref symmetric-key-params; })
USER       ;
USER     }
USER   ;
USER 
USER   private-key =
USER     type-checker.function
USER     [ { name = "key-spec"; type = private-key-spec-type; } ]
USER     private-key-impl
USER   ;
USER in
USER   { inherit private-key; }
USER ```
USER 
USER test/openssl.nix
USER ```
USER /**
USER   Test suite for OpenSSL functionality.
USER 
USER   Accepts the following arguments:
USER   - `pkgs`: the nixpkgs package set.
USER   - `nix-crypto-service`: path to the `nix-crypto-service` binary.
USER */
USER { pkgs, nix-crypto-service, ... }:
USER let
USER   crypto = pkgs.callPackage ../crypto/default.nix {};
USER   inherit (crypto) openssl;
USER 
USER   # Generates an RSA key or returns the existing one from the store.
USER   # The private key itself is not returned — only operations that can
USER   # be performed with it.
USER   pk-rsa = openssl.private-key { 
USER     attrs = {
USER       vault = "openssl";
USER       name = "openssl-test-key";
USER     };
USER     type = "rsa";
USER   };
USER in
USER   {
USER     # Asserts that the plugin can generate or retrieve a public key in PEM format.
USER     "It can generate a public/private key set" = { _assert, ... }:
USER       _assert.is-string pk-rsa.public-key-pem
USER     ;
USER 
USER     # Asserts that the plugin can build a self-signed X.509 certificate
USER     # signed by the RSA key.
USER     "It can generate a x509 self-signed certificate" = { _assert, ... }:
USER     let
USER       x509 = pk-rsa.x509 {
USER         subject-name = { CN = "subject"; };
USER         issuer-name = { CN = "issuer"; };
USER         serial = 1;
USER         start-date = "2026-01-09T21:29:36Z";
USER         expiry-date = "2036-01-09T21:29:36Z";
USER       };
USER     in
USER       # Derivation which outputs the public certificate of the CA
USER       # safe to write into the nix store.
USER       _assert.strings.has-prefix "-----BEGIN CERTIFICATE-----" x509.certificate-pem
USER     ;
USER 
USER     /**
USER       Asserts that a private key stored by the nix-crypto plugin can be exported
USER       using `nix-crypto-service export secret`, and that the public key derived
USER       from the exported private key matches the public key computed by the plugin.
USER 
USER       The `NIX_CRYPTO_STORE` environment variable must point to the same sled store used
USER       by the nix-crypto plugin so that `nix-crypto-service` can locate the key.
USER     */
USER     "It can export the private key" = { _assert, ... }:
USER     let
USER       # The public key pem as computed by the nix plugin
USER       expected-public-key-pem = pk-rsa.public-key-pem;
USER       # The identity of the key, used to locate it in the store
USER       key-identity = pk-rsa.identity;
USER     in
USER       _assert.bash-script
USER       ''
USER         PRIVATE_KEY_FILE=$(mktemp)
USER         EXPECTED_PUBLIC_KEY_FILE=$(mktemp)
USER         RANDOM_FILE=$(mktemp)
USER         SIGNATURE_FILE=$(mktemp)
USER 
USER         # Write the expected public key pem to a temp file
USER         cat > "$EXPECTED_PUBLIC_KEY_FILE" << 'EOF'
USER         ${expected-public-key-pem}
USER         EOF
USER 
USER         # Export the private key using nix-crypto-service
USER         "${nix-crypto-service}" export secret \
USER           --sled-store "$NIX_CRYPTO_STORE" \
USER           --identity-type openssl-pkey \
USER           --openssl-pkey-type rsa \
USER           --openssl-pkey-id "${key-identity}" \
USER           --output-file "$PRIVATE_KEY_FILE" \
USER           --log-file "$NIX_CRYPTO_LOG" \
USER           --log-level debug
USER 
USER         # Generate a random value to sign
USER         dd if=/dev/urandom of="$RANDOM_FILE" bs=32 count=1 2>/dev/null
USER 
USER         # Sign the random value using the exported private key
USER         openssl dgst -sha256 -sign "$PRIVATE_KEY_FILE" -out "$SIGNATURE_FILE" "$RANDOM_FILE"
USER 
USER         # Verify the signature using the expected public key
USER         if ! openssl dgst -sha256 -verify "$EXPECTED_PUBLIC_KEY_FILE" -signature "$SIGNATURE_FILE" "$RANDOM_FILE"; then
USER           exit 1
USER         fi
USER         exit 0
USER       ''
USER     ;
USER   }
USER ```
