USER │            Error::OpensslError(stack) => stack.fmt(f),
USER │            Error::CxxError(msg) => write!(f, "{}", msg),
USER │            Error::Utf8Error(msg) => msg.fmt(f),
USER │            Error::FromUtf8Error(msg) => msg.fmt(f),
USER │            Error::CryptoNixError(msg) => msg.fmt(f),
USER │            _ => write!(f, "Unknown error in the 'nix-crypto' Rust code.")
USER │        }
