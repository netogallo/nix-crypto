ASSISTANT // ============================================================================
ASSISTANT // Encryption helpers
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT const PEM_HEADER: &str = "-----BEGIN ENCRYPTED DATA-----";
ASSISTANT const PEM_FOOTER: &str = "-----END ENCRYPTED DATA-----";
ASSISTANT 
ASSISTANT /// Encrypt `plaintext` with AES-256-CBC and return a PEM-encoded string.
ASSISTANT ///
ASSISTANT /// The payload layout matches the OpenSSL `enc` format:
ASSISTANT ///   `Salted__` (8 bytes) | salt (8 bytes) | ciphertext
ASSISTANT /// The whole payload is Base64-encoded and wrapped in a PEM envelope.
ASSISTANT fn encrypt_to_pem(
ASSISTANT     key: &SymmetricKeyValue,
ASSISTANT     salt: &[u8],
ASSISTANT     iv: &[u8],
ASSISTANT     plaintext: &Vec<u8>
ASSISTANT ) -> Result<String, Error> {
ASSISTANT     let key = key.derive_aes_key(salt)?;
ASSISTANT     let cipher = Cipher::aes_256_cbc();
ASSISTANT     let ciphertext = encrypt(cipher, &key, Some(iv), plaintext)?;
ASSISTANT 
ASSISTANT     let mut payload = Vec::new();
ASSISTANT     payload.extend_from_slice(b"Salted__");
ASSISTANT     payload.extend_from_slice(salt);
ASSISTANT     payload.extend_from_slice(&ciphertext);
ASSISTANT 
ASSISTANT     let b64 = STANDARD.encode(&payload);
ASSISTANT 
ASSISTANT     // Wrap Base64 at 64 characters per line, as is standard for PEM
ASSISTANT     let pem_body = b64
ASSISTANT         .as_bytes()
ASSISTANT         .chunks(64)
ASSISTANT         .map(|chunk| std::str::from_utf8(chunk).unwrap())
ASSISTANT         .collect::<Vec<_>>()
ASSISTANT         .join("\n");
ASSISTANT 
ASSISTANT     Ok(format!("{}\n{}\n{}", PEM_HEADER, pem_body, PEM_FOOTER))
ASSISTANT }
ASSISTANT 
ASSISTANT // ============================================================================
ASSISTANT // export_decryptable
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT /// Export a credential encrypted with a symmetric key, returning a
ASSISTANT /// PEM-formatted string containing the AES-256-CBC encrypted credential.
ASSISTANT ///
ASSISTANT /// Calling this function multiple times with the same `key`, `credential`,
ASSISTANT /// and store will always produce identical output, because the salt and IV
ASSISTANT /// are stored in the `CryptoStore` on the first call and reused thereafter.
ASSISTANT pub fn export_decryptable<K, C>(
ASSISTANT     crypto_nix: &CryptoNix,
ASSISTANT     key: &K,
ASSISTANT     credential: &C,
ASSISTANT ) -> Result<String, Error>
ASSISTANT where
ASSISTANT     K: IsOpensslSymmetricKeyIdentity,
ASSISTANT     C: IsCryptoStoreKeyDerivable,
ASSISTANT     C::Value: Decryptable,
ASSISTANT {
ASSISTANT     // Step 1: Wrap the key in a SymmetricKeyIdentity and get or derive the
ASSISTANT     // symmetric key value (random_secret, derivation, iterations).
ASSISTANT     let symmetric_identity = SymmetricKeyIdentity(key);
ASSISTANT     let symmetric_key_value = crypto_nix.get_or_derive(&symmetric_identity)?;
ASSISTANT 
ASSISTANT     // Step 2: Get or derive the credential value
ASSISTANT     let credential_value = crypto_nix.get_or_derive(credential)?;
ASSISTANT 
ASSISTANT     // Encription parameters are unique per key/credential combination. This
ASSISTANT     // is important as the security of AES becomes weaker if the IV is
ASSISTANT     // reused on different plaintext inputs.
ASSISTANT     let encryption_params_key = EncryptionParamsKey::new(&symmetric_identity, credential);
ASSISTANT     let encryption_params = crypto_nix.get_or_derive(&encryption_params_key)?;
ASSISTANT 
ASSISTANT     // Step 4: Export the credential to plaintext bytes
ASSISTANT     let plaintext = credential_value.export()?;
ASSISTANT 
ASSISTANT     // Step 5: Encrypt and return as PEM
ASSISTANT     encrypt_to_pem(
ASSISTANT         &symmetric_key_value,
ASSISTANT         &encryption_params.salt,
ASSISTANT         &encryption_params.iv,
ASSISTANT         &plaintext
ASSISTANT     )
ASSISTANT }
ASSISTANT 
ASSISTANT // ============================================================================
ASSISTANT // get_symmetric_key_passphrase
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT /// Retrieve (or derive and store) the random passphrase for the symmetric key
ASSISTANT /// identified by `key`. Returns the `random_secret` string which is the
ASSISTANT /// passphrase used as input to the key derivation function.
ASSISTANT ///
ASSISTANT /// Calling this function multiple times with the same `key` and store will
ASSISTANT /// always return the same passphrase, because the `SymmetricKeyValue` is
ASSISTANT /// stored on the first call and reused thereafter.
ASSISTANT pub fn get_symmetric_key_passphrase<K: IsOpensslSymmetricKeyIdentity>(
ASSISTANT     crypto_nix: &CryptoNix,
ASSISTANT     key: &K,
ASSISTANT ) -> Result<String, Error> {
ASSISTANT     let symmetric_identity = SymmetricKeyIdentity(key);
ASSISTANT     let value = crypto_nix.get_or_derive(&symmetric_identity)?;
ASSISTANT     Ok(value.random_secret)
ASSISTANT }
ASSISTANT ```
