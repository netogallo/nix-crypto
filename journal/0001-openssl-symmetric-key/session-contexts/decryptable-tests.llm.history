USER #[repr(u8)]
USER #[derive(Debug, Clone, Copy, PartialEq, Eq)]
USER /// Enum that lists all the key derivation schemes supported
USER /// by Nix Crypto for exporting decryptable credentials.
USER pub enum KeyDerivation {
USER     PBKDF2 = 0
USER }
USER 
USER impl KeyDerivation {
USER 
USER     pub fn from_string(value: &String) -> Result<KeyDerivation, Error> {
USER         match value.to_lowercase().as_str() {
USER             "pbkdf2" => Ok(KeyDerivation::PBKDF2),
USER             _ => Error::fail_with(
USER                 format!("The given string '{}' is not a valid key derivation method.", value)
USER             )
USER         }
USER     }
USER 
USER     pub fn from_u8(value: u8) -> Result<KeyDerivation, Error> {
USER 
USER         if value == (KeyDerivation::PBKDF2 as u8) {
USER             Ok(KeyDerivation::PBKDF2)
USER         }
USER         else {
USER             Error::fail_with(format!("Cannot convert '{}' into a KeyDerivation", value))
USER         }
USER     }
USER }
USER 
USER // ============================================================================
USER // SymmetricKeyValue
USER // ============================================================================
USER 
USER /// The value stored in the `CryptoStore` for a symmetric key. Contains the
USER /// randomly generated secret, the key derivation scheme, and the iteration
USER /// count used for PBKDF2.
USER pub struct SymmetricKeyValue {
USER     pub random_secret: String,
USER     pub key_derivation: KeyDerivation,
USER     pub iterations: u32,
USER }
USER 
USER impl SymmetricKeyValue {
USER     /// Serialize to bytes as `<key_derivation>:<iterations>:<random_secret>`.
USER     fn to_bytes(&self) -> Vec<u8> {
USER         format!("{}:{}:{}", (self.key_derivation as u8).clone(), self.iterations, self.random_secret)
USER             .into_bytes()
USER     }
USER 
USER     /// Deserialize from bytes produced by `to_bytes`.
USER     fn from_bytes(bytes: &[u8]) -> Result<Self, Error> {
USER         let s = std::str::from_utf8(bytes)?;
USER 
USER         // Split into at most 3 parts so the random_secret can itself contain ':'
USER         let mut parts = s.splitn(3, ':');
USER 
USER         let key_derivation_u8 = parts
USER             .next()
USER             .ok_or_else(|| Error::from_message("Missing key_derivation in SymmetricKeyValue".to_string()))?
USER             .to_string()
USER             .parse::<u8>()
USER             .map_err(|_| Error::from_message("Invalid key derivaiton for value.".to_string()))?;
USER 
USER         let key_derivation = KeyDerivation::from_u8(key_derivation_u8)?;
USER 
USER         let iterations_str = parts
USER             .next()
USER             .ok_or_else(|| Error::from_message("Missing iterations in SymmetricKeyValue".to_string()))?;
USER 
USER         let iterations = iterations_str
USER             .parse::<u32>()
USER             .map_err(|_| Error::from_message(format!("Invalid iterations value: {}", iterations_str)))?;
USER 
USER         let random_secret = parts
USER             .next()
USER             .ok_or_else(|| Error::from_message("Missing random_secret in SymmetricKeyValue".to_string()))?
USER             .to_string();
USER 
USER         Ok(SymmetricKeyValue { random_secret, key_derivation, iterations })
USER     }
USER 
USER 
USER     /// Derive a 128-bit AES key from a passphrase using the specified
USER     /// key derivation method.
USER     fn derive_aes_key(&self, salt: &[u8]) -> Result<Vec<u8>, Error> {
USER 
USER         match self.key_derivation {
USER             KeyDerivation::PBKDF2 => {
USER                 let mut key = vec![0u8; 16];
USER                 pbkdf2_hmac(
USER                     self.random_secret.as_bytes(),
USER                     salt,
USER                     self.iterations as usize,
USER                     MessageDigest::sha256(),
USER                     &mut key,
USER                 )?;
USER                 Ok(key)
USER             }
USER         }
USER     }
USER }
USER 
USER // ============================================================================
USER // IsOpensslSymmetricKeyIdentity
USER // ============================================================================
USER 
USER /// Identifies an OpenSSL symmetric key. Implementors provide the key identity,
USER /// derivation scheme, and PBKDF2 iteration count. The underlying
USER /// `SymmetricKeyValue` (including the random secret) is derived and stored
USER /// automatically.
USER pub trait IsOpensslSymmetricKeyIdentity {
USER     fn key_id(&self) -> &String;
USER     fn key_derivation(&self) -> &String;
USER     fn iterations(&self) -> u32;
USER }
USER 
USER /// A newtype wrapper around a reference to an arbitrary `IsOpensslSymmetricKeyIdentity`
USER /// instance. The `IsCrytpoStoreKeyDerivable` trait for symmetric key identites
USER /// is implemented through this type.
USER struct SymmetricKeyIdentity<'a, T: IsOpensslSymmetricKeyIdentity>(pub &'a T);
USER 
USER impl<'a, T : IsOpensslSymmetricKeyIdentity> IsCryptoStoreKey
USER for SymmetricKeyIdentity<'a, T> {
USER     type Value = SymmetricKeyValue;
USER 
USER     fn to_store_key_raw(&self, mut hasher: StoreHasher) -> Vec<u8> {
USER         let identity = self.0;
USER         let iterations = identity.iterations();
USER         hasher.update(identity.key_id().as_bytes());
USER         hasher.update(identity.key_derivation().as_bytes());
USER         hasher.update(&iterations.to_be_bytes());
USER         Vec::from(hasher.finish())
USER     }
USER 
USER     fn to_store_value_raw(value: &SymmetricKeyValue) -> Result<Vec<u8>, Error> {
USER         Ok(value.to_bytes())
USER     }
USER 
USER 
USER     fn from_store_value_raw(value: &Vec<u8>) -> Result<SymmetricKeyValue, Error> {
USER         SymmetricKeyValue::from_bytes(value)
USER     }
USER }
USER 
USER impl<'a, T: IsOpensslSymmetricKeyIdentity> IsCryptoStoreKeyDerivable
USER for SymmetricKeyIdentity<'a, T> {
USER     fn derive(&self) -> Result<SymmetricKeyValue, Error> {
USER         let mut random_bytes = vec![0u8; 16];
USER         rand_bytes(&mut random_bytes)?;
USER         let random_secret = STANDARD.encode(&random_bytes);
USER 
USER         Ok(SymmetricKeyValue {
USER             random_secret,
USER             key_derivation: KeyDerivation::from_string(&self.0.key_derivation())?,
USER             iterations: self.0.iterations(),
USER         })
USER     }
USER }
USER 
USER // ============================================================================
USER // EncryptionParams
USER // ============================================================================
USER 
USER /// Stores the salt and IV used to encrypt a specific `(symmetric_key, credential)`
USER /// pair. By persisting these in the store we guarantee that calling
USER /// `export_decryptable` with the same key, credential, and store always
USER /// produces identical output.
USER pub struct EncryptionParams {
USER     pub salt: Vec<u8>,
USER     pub iv: Vec<u8>,
USER }
USER 
USER impl EncryptionParams {
USER     fn generate() -> Result<Self, Error> {
USER         let mut salt = vec![0u8; 8];
USER         let mut iv = vec![0u8; 16];
USER         rand_bytes(&mut salt)?;
USER         rand_bytes(&mut iv)?;
USER         Ok(EncryptionParams { salt, iv })
USER     }
USER 
USER     /// Serialize as `<salt_len_1_byte><salt><iv>`.
USER     fn to_bytes(&self) -> Vec<u8> {
USER         let mut bytes = Vec::new();
USER         bytes.push(self.salt.len() as u8);
USER         bytes.extend_from_slice(&self.salt);
USER         bytes.extend_from_slice(&self.iv);
USER         bytes
USER     }
USER 
USER     fn from_bytes(bytes: &[u8]) -> Result<Self, Error> {
USER         if bytes.is_empty() {
USER             return Err(Error::from_message("EncryptionParams bytes are empty".to_string()));
USER         }
USER 
USER         let salt_len = bytes[0] as usize;
USER 
USER         if bytes.len() < 1 + salt_len {
USER             return Err(Error::from_message("EncryptionParams bytes too short for salt".to_string()));
USER         }
USER 
USER         let salt = bytes[1..1 + salt_len].to_vec();
USER         let iv = bytes[1 + salt_len..].to_vec();
USER 
USER         Ok(EncryptionParams { salt, iv })
USER     }
USER }
USER 
USER /// The store key for `EncryptionParams`. It is derived by hashing the raw
USER /// store keys of both the symmetric key identity and the credential identity,
USER /// making it unique per `(key, credential)` pair.
USER struct EncryptionParamsKey<'a, TKey, TCred> {
USER     symmetric_key_identity: &'a TKey,
USER     credential_identity: &'a TCred,
USER }
USER 
USER impl<'a, TKey, TCred> EncryptionParamsKey<'a, TKey, TCred> {
USER     pub fn new(symmetric_key_identity: &'a TKey, credential_identity: &'a TCred) -> Self {
USER         EncryptionParamsKey { symmetric_key_identity, credential_identity }
USER     }
USER }
USER 
USER impl<'a, TKey, TCred> IsCryptoStoreKey
USER for EncryptionParamsKey<'a, TKey, TCred>
USER where TKey : IsCryptoStoreKey, TCred : IsCryptoStoreKey {
USER     type Value = EncryptionParams;
USER 
USER     fn to_store_key_raw(&self, mut hasher: StoreHasher) -> Vec<u8> {
USER         hasher.update(b"encryption_params");
USER         hasher.update_with_identity(self.symmetric_key_identity);
USER         hasher.update_with_identity(self.credential_identity);
USER         Vec::from(hasher.finish())
USER     }
USER 
USER     fn to_store_value_raw(value: &EncryptionParams) -> Result<Vec<u8>, Error> {
USER         Ok(value.to_bytes())
USER     }
USER 
USER     fn from_store_value_raw(value: &Vec<u8>) -> Result<EncryptionParams, Error> {
USER         EncryptionParams::from_bytes(value)
USER     }
USER }
USER 
USER impl<'a, TKey, TCred> IsCryptoStoreKeyDerivable for EncryptionParamsKey<'a, TKey, TCred>
USER where TKey : IsCryptoStoreKey, TCred : IsCryptoStoreKey {
USER     fn derive(&self) -> Result<EncryptionParams, Error> {
USER         EncryptionParams::generate()
USER     }
USER }
USER 
USER // ============================================================================
USER // Encryption helpers
USER // ============================================================================
USER 
USER const PEM_HEADER: &str = "-----BEGIN ENCRYPTED DATA-----";
USER const PEM_FOOTER: &str = "-----END ENCRYPTED DATA-----";
USER 
USER /// Encrypt `plaintext` with AES-128-CBC and return a PEM-encoded string.
USER ///
USER /// The payload layout matches the OpenSSL `enc` format:
USER ///   `Salted__` (8 bytes) | salt (8 bytes) | ciphertext
USER /// The whole payload is Base64-encoded and wrapped in a PEM envelope.
USER fn encrypt_to_pem(
USER     key: &SymmetricKeyValue,
USER     salt: &[u8],
USER     iv: &[u8],
USER     plaintext: &Vec<u8>
USER ) -> Result<String, Error> {
USER     let key = key.derive_aes_key(salt)?;
USER     let cipher = Cipher::aes_128_cbc();
USER     let ciphertext = encrypt(cipher, &key, Some(iv), plaintext)?;
USER 
USER     let mut payload = Vec::new();
USER     payload.extend_from_slice(b"Salted__");
USER     payload.extend_from_slice(salt);
USER     payload.extend_from_slice(&ciphertext);
USER 
USER     let b64 = STANDARD.encode(&payload);
USER 
USER     // Wrap Base64 at 64 characters per line, as is standard for PEM
USER     let pem_body = b64
USER         .as_bytes()
USER         .chunks(64)
USER         .map(|chunk| std::str::from_utf8(chunk).unwrap())
USER         .collect::<Vec<_>>()
USER         .join("\n");
USER 
USER     Ok(format!("{}\n{}\n{}", PEM_HEADER, pem_body, PEM_FOOTER))
USER }
USER 
USER // ============================================================================
USER // export_decryptable
USER // ============================================================================
USER 
USER /// Export a credential encrypted with a symmetric key, returning a
USER /// PEM-formatted string containing the AES-128-CBC encrypted credential.
USER ///
USER /// Calling this function multiple times with the same `key`, `credential`,
USER /// and store will always produce identical output, because the salt and IV
USER /// are stored in the `CryptoStore` on the first call and reused thereafter.
USER pub fn export_decryptable<K, C>(
USER     crypto_nix: &CryptoNix,
USER     key: &K,
USER     credential: &C,
USER ) -> Result<String, Error>
USER where
USER     K: IsOpensslSymmetricKeyIdentity,
USER     C: IsCryptoStoreKeyDerivable,
USER     C::Value: Decryptable,
USER {
USER     // Step 1: Wrap the key in a SymmetricKeyIdentity and get or derive the
USER     // symmetric key value (random_secret, derivation, iterations).
USER     let symmetric_identity = SymmetricKeyIdentity(key);
USER     let symmetric_key_value = crypto_nix.get_or_derive(&symmetric_identity)?;
USER 
USER     // Step 2: Get or derive the credential value
USER     let credential_value = crypto_nix.get_or_derive(credential)?;
USER 
USER     // Encription parameters are unique per key/credential combination. This
USER     // is important as the security of AES becomes weaker if the IV is
USER     // reused on different plaintext inputs.
USER     let encryption_params_key = EncryptionParamsKey::new(&symmetric_identity, credential);
USER     let encryption_params = crypto_nix.get_or_derive(&encryption_params_key)?;
USER 
USER     // Step 4: Export the credential to plaintext bytes
USER     let plaintext = credential_value.export()?;
USER 
USER     // Step 5: Encrypt and return as PEM
USER     encrypt_to_pem(
USER         &symmetric_key_value,
USER         &encryption_params.salt,
USER         &encryption_params.iv,
USER         &plaintext
USER     )
USER }
USER 
USER // ============================================================================
USER // get_symmetric_key_passphrase
USER // ============================================================================
USER 
USER /// Retrieve (or derive and store) the random passphrase for the symmetric key
USER /// identified by `key`. Returns the `random_secret` string which is the
USER /// passphrase used as input to the key derivation function.
USER ///
USER /// Calling this function multiple times with the same `key` and store will
USER /// always return the same passphrase, because the `SymmetricKeyValue` is
USER /// stored on the first call and reused thereafter.
USER pub fn get_symmetric_key_passphrase<K: IsOpensslSymmetricKeyIdentity>(
USER     crypto_nix: &CryptoNix,
USER     key: &K,
USER ) -> Result<String, Error> {
USER     let symmetric_identity = SymmetricKeyIdentity(key);
USER     let value = crypto_nix.get_or_derive(&symmetric_identity)?;
USER     Ok(value.random_secret)
USER }
USER ```
