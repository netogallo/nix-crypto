ASSISTANT // ============================================================================
ASSISTANT // EncryptionParams
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT /// Stores the salt and IV used to encrypt a specific `(symmetric_key, credential)`
ASSISTANT /// pair. By persisting these in the store we guarantee that calling
ASSISTANT /// `export_decryptable` with the same key, credential, and store always
ASSISTANT /// produces identical output.
ASSISTANT pub struct EncryptionParams {
ASSISTANT     pub salt: Vec<u8>,
ASSISTANT     pub iv: Vec<u8>,
ASSISTANT }
ASSISTANT 
ASSISTANT impl EncryptionParams {
ASSISTANT     fn generate() -> Result<Self, Error> {
ASSISTANT         let mut salt = vec![0u8; 8];
ASSISTANT         let mut iv = vec![0u8; 16];
ASSISTANT         rand_bytes(&mut salt)?;
ASSISTANT         rand_bytes(&mut iv)?;
ASSISTANT         Ok(EncryptionParams { salt, iv })
ASSISTANT     }
ASSISTANT 
ASSISTANT     /// Serialize as `<salt_len_1_byte><salt><iv>`.
ASSISTANT     fn to_bytes(&self) -> Vec<u8> {
ASSISTANT         let mut bytes = Vec::new();
ASSISTANT         bytes.push(self.salt.len() as u8);
ASSISTANT         bytes.extend_from_slice(&self.salt);
ASSISTANT         bytes.extend_from_slice(&self.iv);
ASSISTANT         bytes
ASSISTANT     }
ASSISTANT 
ASSISTANT     fn from_bytes(bytes: &[u8]) -> Result<Self, Error> {
ASSISTANT         if bytes.is_empty() {
ASSISTANT             return Err(Error::from_message("EncryptionParams bytes are empty".to_string()));
ASSISTANT         }
ASSISTANT 
ASSISTANT         let salt_len = bytes[0] as usize;
ASSISTANT 
ASSISTANT         if bytes.len() < 1 + salt_len {
ASSISTANT             return Err(Error::from_message("EncryptionParams bytes too short for salt".to_string()));
ASSISTANT         }
ASSISTANT 
ASSISTANT         let salt = bytes[1..1 + salt_len].to_vec();
ASSISTANT         let iv = bytes[1 + salt_len..].to_vec();
ASSISTANT 
ASSISTANT         Ok(EncryptionParams { salt, iv })
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT /// The store key for `EncryptionParams`. It is derived by hashing the raw
ASSISTANT /// store keys of both the symmetric key identity and the credential identity,
ASSISTANT /// making it unique per `(key, credential)` pair.
ASSISTANT struct EncryptionParamsKey<'a, TKey, TCred> {
ASSISTANT     symmetric_key_identity: &'a TKey,
ASSISTANT     credential_identity: &'a TCred,
ASSISTANT }
ASSISTANT 
ASSISTANT impl<'a, TKey, TCred> EncryptionParamsKey<'a, TKey, TCred> {
ASSISTANT     pub fn new(symmetric_key_identity: &'a TKey, credential_identity: &'a TCred) -> Self {
ASSISTANT         EncryptionParamsKey { symmetric_key_identity, credential_identity }
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT impl<'a, TKey, TCred> IsCryptoStoreKey
ASSISTANT for EncryptionParamsKey<'a, TKey, TCred>
ASSISTANT where TKey : IsCryptoStoreKey, TCred : IsCryptoStoreKey {
ASSISTANT     type Value = EncryptionParams;
ASSISTANT 
ASSISTANT     fn to_store_key_raw(&self, mut hasher: StoreHasher) -> Vec<u8> {
ASSISTANT         hasher.update(b"encryption_params");
ASSISTANT         hasher.update_with_identity(self.symmetric_key_identity);
ASSISTANT         hasher.update_with_identity(self.credential_identity);
ASSISTANT         Vec::from(hasher.finish())
ASSISTANT     }
ASSISTANT 
ASSISTANT     fn to_store_value_raw(value: &EncryptionParams) -> Result<Vec<u8>, Error> {
ASSISTANT         Ok(value.to_bytes())
ASSISTANT     }
ASSISTANT 
ASSISTANT     fn from_store_value_raw(value: &Vec<u8>) -> Result<EncryptionParams, Error> {
ASSISTANT         EncryptionParams::from_bytes(value)
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT impl<'a, TKey, TCred> IsCryptoStoreKeyDerivable for EncryptionParamsKey<'a, TKey, TCred>
ASSISTANT where TKey : IsCryptoStoreKey, TCred : IsCryptoStoreKey {
ASSISTANT     fn derive(&self) -> Result<EncryptionParams, Error> {
ASSISTANT         EncryptionParams::generate()
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT // ============================================================================
ASSISTANT // Encryption helpers
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT const PEM_HEADER: &str = "-----BEGIN ENCRYPTED DATA-----";
ASSISTANT const PEM_FOOTER: &str = "-----END ENCRYPTED DATA-----";
ASSISTANT 
ASSISTANT /// Encrypt `plaintext` with AES-256-CBC and return a PEM-encoded string.
ASSISTANT ///
ASSISTANT /// The payload layout matches the OpenSSL `enc` format:
ASSISTANT ///   `Salted__` (8 bytes) | salt (8 bytes) | ciphertext
ASSISTANT /// The whole payload is Base64-encoded and wrapped in a PEM envelope.
ASSISTANT fn encrypt_to_pem(
ASSISTANT     key: &SymmetricKeyValue,
ASSISTANT     salt: &[u8],
ASSISTANT     iv: &[u8],
ASSISTANT     plaintext: &Vec<u8>
ASSISTANT ) -> Result<String, Error> {
ASSISTANT     let key = key.derive_aes_key(salt)?;
ASSISTANT     let cipher = Cipher::aes_256_cbc();
ASSISTANT     let ciphertext = encrypt(cipher, &key, Some(iv), plaintext)?;
ASSISTANT 
ASSISTANT     let mut payload = Vec::new();
ASSISTANT     payload.extend_from_slice(b"Salted__");
ASSISTANT     payload.extend_from_slice(salt);
ASSISTANT     payload.extend_from_slice(&ciphertext);
ASSISTANT 
ASSISTANT     let b64 = STANDARD.encode(&payload);
ASSISTANT 
ASSISTANT     // Wrap Base64 at 64 characters per line, as is standard for PEM
ASSISTANT     let pem_body = b64
ASSISTANT         .as_bytes()
ASSISTANT         .chunks(64)
ASSISTANT         .map(|chunk| std::str::from_utf8(chunk).unwrap())
ASSISTANT         .collect::<Vec<_>>()
ASSISTANT         .join("\n");
ASSISTANT 
ASSISTANT     Ok(format!("{}\n{}\n{}", PEM_HEADER, pem_body, PEM_FOOTER))
ASSISTANT }
ASSISTANT 
ASSISTANT // ============================================================================
ASSISTANT // export_decryptable
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT /// Export a credential encrypted with a symmetric key, returning a
ASSISTANT /// PEM-formatted string containing the AES-256-CBC encrypted credential.
ASSISTANT ///
ASSISTANT /// Calling this function multiple times with the same `key`, `credential`,
ASSISTANT /// and store will always produce identical output, because the salt and IV
ASSISTANT /// are stored in the `CryptoStore` on the first call and reused thereafter.
ASSISTANT pub fn export_decryptable<K, C>(
ASSISTANT     crypto_nix: &CryptoNix,
ASSISTANT     key: &K,
ASSISTANT     credential: &C,
ASSISTANT ) -> Result<String, Error>
ASSISTANT where
ASSISTANT     K: IsOpensslSymmetricKeyIdentity,
ASSISTANT     C: IsCryptoStoreKeyDerivable,
ASSISTANT     C::Value: Decryptable,
ASSISTANT {
ASSISTANT     // Step 1: Wrap the key in a SymmetricKeyIdentity and get or derive the
ASSISTANT     // symmetric key value (random_secret, derivation, iterations).
ASSISTANT     let symmetric_identity = SymmetricKeyIdentity(key);
ASSISTANT     let symmetric_key_value = crypto_nix.get_or_derive(&symmetric_identity)?;
ASSISTANT 
ASSISTANT     // Step 2: Get or derive the credential value
ASSISTANT     let credential_value = crypto_nix.get_or_derive(credential)?;
ASSISTANT 
ASSISTANT     // Encription parameters are unique per key/credential combination. This
ASSISTANT     // is important as the security of AES becomes weaker if the IV is
ASSISTANT     // reused on different plaintext inputs.
ASSISTANT     let encryption_params_key = EncryptionParamsKey::new(&symmetric_identity, credential);
ASSISTANT     let encryption_params = crypto_nix.get_or_derive(&encryption_params_key)?;
ASSISTANT 
ASSISTANT     // Step 4: Export the credential to plaintext bytes
ASSISTANT     let plaintext = credential_value.export()?;
ASSISTANT 
ASSISTANT     // Step 5: Encrypt and return as PEM
ASSISTANT     encrypt_to_pem(
ASSISTANT         &symmetric_key_value,
ASSISTANT         &encryption_params.salt,
ASSISTANT         &encryption_params.iv,
ASSISTANT         &plaintext
ASSISTANT     )
ASSISTANT }
ASSISTANT 
ASSISTANT // ============================================================================
ASSISTANT // get_symmetric_key_passphrase
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT /// Retrieve (or derive and store) the random passphrase for the symmetric key
ASSISTANT /// identified by `key`. Returns the `random_secret` string which is the
ASSISTANT /// passphrase used as input to the key derivation function.
ASSISTANT ///
ASSISTANT /// Calling this function multiple times with the same `key` and store will
ASSISTANT /// always return the same passphrase, because the `SymmetricKeyValue` is
ASSISTANT /// stored on the first call and reused thereafter.
ASSISTANT pub fn get_symmetric_key_passphrase<K: IsOpensslSymmetricKeyIdentity>(
ASSISTANT     crypto_nix: &CryptoNix,
ASSISTANT     key: &K,
ASSISTANT ) -> Result<String, Error> {
ASSISTANT     let symmetric_identity = SymmetricKeyIdentity(key);
ASSISTANT     let value = crypto_nix.get_or_derive(&symmetric_identity)?;
ASSISTANT     Ok(value.random_secret)
ASSISTANT }
ASSISTANT ```
ASSISTANT 
