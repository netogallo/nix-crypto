USER USER //! # nix-crypto-service
USER USER //!
USER USER //! A CLI tool for managing cryptographic secrets stored by the nix-crypto plugin.
USER USER //!
USER USER //! ## Usage
USER USER //!
USER USER //! ### Export a secret
USER USER //!
USER USER //! Exports a private key from the sled store to a PEM file:
USER USER //!
USER USER //! ```text
USER USER //! nix-crypto-service export secret \
USER USER //!   --sled-store <path> \
USER USER //!   --identity-type openssl-pkey \
USER USER //!   --openssl-pkey-type rsa \
USER USER //!   --openssl-pkey-id <identity> \
USER USER //!   --output-file <path>
USER USER //! ```
USER USER //!
USER USER //! Exports a symmetric key passphrase from the sled store to a file:
USER USER //!
USER USER //! ```text
USER USER //! nix-crypto-service export secret \
USER USER //!   --sled-store <path> \
USER USER //!   --identity-type openssl-symmetric-key \
USER USER //!   --openssl-symmetric-key-id <id> \
USER USER //!   --openssl-symmetric-key-derivation pbkdf2 \
USER USER //!   --openssl-symmetric-key-iterations 600000 \
USER USER //!   --output-file <path>
USER USER //! ```
USER USER //!
USER USER //! If `--sled-store` is not provided, the store path is resolved from the
USER USER //! `NIX_CRYPTO_STORE` environment variable, which must be set to `sled:<path>`.
USER USER //!
USER USER //! ### Logging
USER USER //!
USER USER //! Logging is optional. If `--log-file` is provided, log entries are written
USER USER //! to the specified file in append mode. The minimum log level can be set with
USER USER //! `--log-level` (default: `info`).
USER USER //!
USER USER //! ## Argument parsing
USER USER //!
USER USER //! This binary uses [`docopt`] for argument parsing. Note that `docopt` in Rust
USER USER //! skips `argv[0]` (the binary name) when parsing arguments. As a result, the
USER USER //! usage patterns must include the literal `nix-crypto-service` token so that
USER USER //! patterns are matched correctly when invoked directly. When using
USER USER //! `cargo run nix-crypto-service --version`, cargo passes `nix-crypto-service`
USER USER //! as `argv[1]`, which is why that works while invoking the binary directly
USER USER //! with `--version` does not match the pattern.
USER USER 
USER USER use docopt::Docopt;
USER USER use serde::Deserialize;
USER USER 
USER USER mod common;
USER USER mod export;
USER USER 
USER USER use crate::common::{Error, NixCryptoArgs};
USER USER 
USER USER const USAGE: &str = "
USER USER Usage:
USER USER     nix-crypto-service --version
USER USER     nix-crypto-service export secret [--sled-store <sled_store>] --identity-type <identity_type> [--openssl-pkey-type <openssl_pkey_type>] [--openssl-pkey-id <openssl_pkey_id>] [--openssl-symmetric-key-id <openssl_symmetric_key_id>] [--openssl-symmetric-key-derivation <openssl_symmetric_key_derivation>] [--openssl-symmetric-key-iterations <openssl_symmetric_key_iterations>] --output-file <output_file> [--log-file <log_file>] [--log-level <log_level>]
USER USER     nix-crypto-service --help
USER USER 
USER USER Options:
USER USER     -h, --help                                                              Show this help message.
USER USER     -v, --version                                                           Show the version.
USER USER     --sled-store <sled_store>                                               Path to the sled store on the filesystem.
USER USER     --identity-type <identity_type>                                         The identity type being exported (openssl-pkey, openssl-symmetric-key).
USER USER     --openssl-pkey-type <openssl_pkey_type>                                 The openssl private key type (required when --identity-type is 'openssl-pkey').
USER USER     --openssl-pkey-id <openssl_pkey_id>                                     The openssl private key id (required when --identity-type is 'openssl-pkey').
USER USER     --openssl-symmetric-key-id <openssl_symmetric_key_id>                   The symmetric key id (required when --identity-type is 'openssl-symmetric-key').
USER USER     --openssl-symmetric-key-derivation <openssl_symmetric_key_derivation>   The key derivation scheme [default: pbkdf2].
USER USER     --openssl-symmetric-key-iterations <openssl_symmetric_key_iterations>   The number of key derivation iterations [default: 600000].
USER USER     --output-file <output_file>                                             The file to write the exported secret to.
USER USER     --log-file <log_file>                                                   Path to the log file. If absent, logging is disabled.
USER USER     --log-level <log_level>                                                 Minimum log level: debug, info, warn, error [default: info].
USER USER ";
USER USER 
USER USER #[derive(Debug, Deserialize)]
USER USER struct Args {
USER USER     flag_version: bool,
USER USER     cmd_export: bool,
USER USER     cmd_secret: bool,
USER USER     flag_sled_store: Option<String>,
USER USER     flag_identity_type: Option<String>,
USER USER     flag_openssl_pkey_type: Option<String>,
USER USER     flag_openssl_pkey_id: Option<String>,
USER USER     flag_openssl_symmetric_key_id: Option<String>,
USER USER     flag_openssl_symmetric_key_derivation: Option<String>,
USER USER     flag_openssl_symmetric_key_iterations: Option<String>,
USER USER     flag_output_file: Option<String>,
USER USER     flag_log_file: Option<String>,
USER USER     flag_log_level: Option<String>,
USER USER }
USER USER 
USER USER impl Args {
USER USER 
USER USER     pub fn to_nix_crypto_args(&self) -> Result<NixCryptoArgs, Error> {
USER USER         NixCryptoArgs::from_flags(
USER USER             self.flag_sled_store.clone(),
USER USER             self.flag_log_file.clone(),
USER USER             self.flag_log_level.clone(),
USER USER         )
USER USER     }
USER USER 
USER USER     pub fn main(&self) -> Result<(), Error> {
USER USER         if self.flag_version {
USER USER             println!("nix-crypto-service {}", env!("CARGO_PKG_VERSION"));
USER USER             return Ok(());
USER USER         }
USER USER 
USER USER         if self.cmd_export && self.cmd_secret {
USER USER             let export_args = export::resolve_args(
USER USER                 self.to_nix_crypto_args()?,
USER USER                 self.flag_identity_type.clone(),
USER USER                 self.flag_openssl_pkey_type.clone(),
USER USER                 self.flag_openssl_pkey_id.clone(),
USER USER                 self.flag_openssl_symmetric_key_id.clone(),
USER USER                 self.flag_openssl_symmetric_key_derivation.clone(),
USER USER                 self.flag_openssl_symmetric_key_iterations.clone(),
USER USER                 self.flag_output_file.clone(),
USER USER             )?;
USER USER 
USER USER             export::run_secret(export_args)?;
USER USER             return Ok(());
USER USER         }
USER USER 
USER USER         Err(Error::unknown_action())
USER USER     }
USER USER }
USER USER 
USER USER fn main() {
USER USER     let args: Args = Docopt::new(USAGE)
USER USER         .and_then(|d| Ok(d.argv(std::env::args())))
USER USER         .and_then(|d| d.deserialize())
USER USER         .unwrap_or_else(|e| e.exit());
USER USER 
USER USER     match args.main() {
USER USER         Ok(()) => return,
USER USER         Err(e) => {
USER USER             eprintln!("{}\n\nError:\n\n{}", USAGE, e.as_string());
USER USER             std::process::exit(1);
USER USER         }
USER USER     }
USER USER }
USER USER ```
USER USER 
USER USER journal/0001-openssl-symmetric-key/tasks/export-symmetric-key-test.md
USER USER ```
USER USER A test needs to be added to the test/openssl.nix file to validate that the `export-decryptable-key`
USER USER defined in the cyrpto/openssl/main.nix file works correctly. Follow the same structure of the existing
USER USER "It can export private key" but peform the following steps:
USER USER     1. Call the `export-decryptable-script` from nix code and export the `pk-rsa` key defined in the
USER USER     file as a pem string. The test should write that string to a temporary file.
USER USER     2. The test then uses the `nix-crypto-service` to dump the passphrase used to export the `pk-rsa` private key.
USER USER     See the file nix-crypto-service/src/main.rs to determine the right cli flags needed to perform
USER USER     this. Export this passphrase to a temporary file.
USER USER     3. Use the openssl binary program to decrypt the key exported in step 1 using the passphrase from
USER USER     step 2. Write the decrypted key to a temporary file.
USER USER     4. Use the openssl binary program to sign a value using the key from step 3. If openssl reports no
USER USER     errors you may assume that the test was successful.
USER USER ```
USER USER 
USER USER crypto/openssl/main.nix
USER USER ```
USER USER /**
USER USER   OpenSSL cryptographic operations for nix-crypto.
USER USER */
USER USER { pkgs, prelude, private-key-spec-type, x509-params-type, export-decryptable-pkey-params-type, ... }@module:
USER USER let
USER USER   inherit (pkgs) lib;
USER USER   inherit (lib) types;
USER USER   inherit (builtins.crypto) openssl;
USER USER   type-checker = prelude.type-checker {
USER USER     file = "${./openssl.nix}";
USER USER   };
USER USER 
USER USER   /**
USER USER     Produces a deterministic key identity string from an attribute set.
USER USER     Keys are sorted alphabetically and joined as `key=value` pairs separated
USER USER     by `&`. For example, `{ vault = "openssl"; name = "my-key"; }` produces
USER USER     `"name=my-key&vault=openssl"`.
USER USER 
USER USER     This string is used by both the nix-crypto plugin (to store the key) and
USER USER     `nix-crypto-service` (to look it up). The sort order ensures the identity
USER USER     is stable regardless of the order in which `attrs` is defined in nix.
USER USER   */
USER USER   to-key-identity = attrs:
USER USER     let
USER USER       keys = lib.sort (a: b: a < b) (lib.attrNames attrs);
USER USER       mk-entry = k:
USER USER         let
USER USER           value = attrs.${k};
USER USER         in
USER USER           "${k}=${value}"
USER USER       ;
USER USER     in
USER USER       lib.concatStringsSep "&" (lib.map mk-entry keys)
USER USER   ;
USER USER 
USER USER   /**
USER USER     Build an X.509 certificate signed by the given private key.
USER USER     Returns an attribute set with:
USER USER     - `certificate-pem`: the certificate in PEM format.
USER USER   */
USER USER   x509 = { key-ref, x509-params }:
USER USER   let
USER USER     x509-params-all =
USER USER       x509-params
USER USER       // { signing-private-key-identity = key-ref; }
USER USER     ;
USER USER   in
USER USER     {
USER USER       certificate-pem = openssl.x509-pem x509-params-all;
USER USER     }
USER USER   ;
USER USER 
USER USER   /**
USER USER     Export a private key credential encrypted with the given symmetric key.
USER USER     Returns a PEM-formatted string containing the AES-128-CBC encrypted
USER USER     private key.
USER USER 
USER USER     The same inputs (symmetric-key-params, key-ref, store) will always
USER USER     produce identical output, as the salt and IV are persisted in the store
USER USER     on the first call and reused thereafter.
USER USER   */
USER USER   export-decryptable-pkey = { key-ref, symmetric-key-params }:
USER USER     openssl.export-decryptable-pkey symmetric-key-params key-ref
USER USER   ;
USER USER 
USER USER   /**
USER USER     Retrieve or generate an OpenSSL private key.
USER USER     Accepts a `key-spec` with:
USER USER     - `attrs`: an attribute set of key-value pairs used to construct the key
USER USER       identity string (e.g. `{ vault = "openssl"; name = "my-key"; }`).
USER USER     - `type`: the key type string (e.g. `"rsa"`).
USER USER 
USER USER     Returns an attribute set with:
USER USER     - `identity`: the key identity string produced by `to-key-identity`. Exposed
USER USER       so that callers (e.g. `nix-crypto-service`) can locate the key in the
USER USER       sled store without reconstructing the identity manually.
USER USER     - `public-key-pem`: the public key in PEM format, computed by the nix plugin.
USER USER     - `x509`: a function to build X.509 certificates signed by this key.
USER USER     - `export-decryptable-pkey`: a function to export this private key encrypted
USER USER       with a symmetric key.
USER USER   */
USER USER   private-key-impl = key-spec:
USER USER   let
USER USER     key-ref = {
USER USER       key-identity = to-key-identity key-spec.attrs;
USER USER       key-type = key-spec.type;
USER USER     };
USER USER   in
USER USER     {
USER USER       identity = key-ref.key-identity;
USER USER       public-key-pem = openssl.public-key-pem key-ref;
USER USER       x509 =
USER USER         type-checker.function
USER USER         [ { name = "x509-params"; type = x509-params-type; } ]
USER USER         (x509-params: x509 { inherit key-ref x509-params; })
USER USER       ;
USER USER       export-decryptable-pkey =
USER USER         type-checker.function
USER USER         [ { name = "symmetric-key-params"; type = export-decryptable-pkey-params-type; } ]
USER USER         (symmetric-key-params: export-decryptable-pkey { inherit key-ref symmetric-key-params; })
USER USER       ;
USER USER     }
USER USER   ;
USER USER 
USER USER   private-key =
USER USER     type-checker.function
USER USER     [ { name = "key-spec"; type = private-key-spec-type; } ]
USER USER     private-key-impl
USER USER   ;
USER USER in
USER USER   { inherit private-key; }
USER USER ```
USER USER 
USER USER crypto/openssl/export-decryptable-pkey-params-type.nix
USER USER ```
USER USER { lib }:
USER USER let
USER USER   inherit (lib) types;
USER USER in
USER USER   types.submodule {
USER USER     options = {
USER USER       key-id = lib.mkOption {
USER USER         type = types.str;
USER USER         description = ''
USER USER           A unique identifier for the symmetric key. This is used to
USER USER           reference the key in the store. The same key-id will always
USER USER           refer to the same symmetric key within a given store.
USER USER         '';
USER USER       };
USER USER 
USER USER       key-derivation = lib.mkOption {
USER USER         type = types.enum [ "pbkdf2" ];
USER USER         default = "pbkdf2";
USER USER         description = ''
USER USER           The key derivation scheme to use when deriving the AES key
USER USER           from the random secret. Currently only `pbkdf2` is supported.
USER USER         '';
USER USER       };
USER USER 
USER USER       iterations = lib.mkOption {
USER USER         type = types.int;
USER USER         description = ''
USER USER           The number of iterations to use for the key derivation function.
USER USER           Higher values increase security but also increase computation time.
USER USER         '';
USER USER       };
USER USER     };
USER USER   }
USER USER ```
USER USER 
USER USER test/openssl.nix
USER USER ```
USER USER /**
USER USER   Test suite for OpenSSL functionality.
USER USER 
USER USER   Accepts the following arguments:
USER USER   - `pkgs`: the nixpkgs package set.
USER USER   - `nix-crypto-service`: path to the `nix-crypto-service` binary.
USER USER */
USER USER { pkgs, nix-crypto-service, ... }:
USER USER let
USER USER   crypto = pkgs.callPackage ../crypto/default.nix {};
USER USER   inherit (crypto) openssl;
USER USER 
USER USER   # Generates an RSA key or returns the existing one from the store.
USER USER   # The private key itself is not returned — only operations that can
USER USER   # be performed with it.
USER USER   pk-rsa = openssl.private-key { 
USER USER     attrs = {
USER USER       vault = "openssl";
USER USER       name = "openssl-test-key";
USER USER     };
USER USER     type = "rsa";
USER USER   };
USER USER in
USER USER   {
USER USER     # Asserts that the plugin can generate or retrieve a public key in PEM format.
USER USER     "It can generate a public/private key set" = { _assert, ... }:
USER USER       _assert.is-string pk-rsa.public-key-pem
USER USER     ;
USER USER 
USER USER     # Asserts that the plugin can build a self-signed X.509 certificate
USER USER     # signed by the RSA key.
USER USER     "It can generate a x509 self-signed certificate" = { _assert, ... }:
USER USER     let
USER USER       x509 = pk-rsa.x509 {
USER USER         subject-name = { CN = "subject"; };
USER USER         issuer-name = { CN = "issuer"; };
USER USER         serial = 1;
USER USER         start-date = "2026-01-09T21:29:36Z";
USER USER         expiry-date = "2036-01-09T21:29:36Z";
USER USER       };
USER USER     in
USER USER       # Derivation which outputs the public certificate of the CA
USER USER       # safe to write into the nix store.
USER USER       _assert.strings.has-prefix "-----BEGIN CERTIFICATE-----" x509.certificate-pem
USER USER     ;
USER USER 
USER USER     /**
USER USER       Asserts that a private key stored by the nix-crypto plugin can be exported
USER USER       using `nix-crypto-service export secret`, and that the public key derived
USER USER       from the exported private key matches the public key computed by the plugin.
USER USER 
USER USER       The `NIX_CRYPTO_STORE` environment variable must point to the same sled store used
USER USER       by the nix-crypto plugin so that `nix-crypto-service` can locate the key.
USER USER     */
USER USER     "It can export the private key" = { _assert, ... }:
USER USER     let
USER USER       # The public key pem as computed by the nix plugin
USER USER       expected-public-key-pem = pk-rsa.public-key-pem;
USER USER       # The identity of the key, used to locate it in the store
USER USER       key-identity = pk-rsa.identity;
USER USER     in
USER USER       _assert.bash-script
USER USER       ''
USER USER         PRIVATE_KEY_FILE=$(mktemp)
USER USER         EXPECTED_PUBLIC_KEY_FILE=$(mktemp)
USER USER         RANDOM_FILE=$(mktemp)
USER USER         SIGNATURE_FILE=$(mktemp)
USER USER 
USER USER         # Write the expected public key pem to a temp file
USER USER         cat > "$EXPECTED_PUBLIC_KEY_FILE" << 'EOF'
USER USER         ${expected-public-key-pem}
USER USER         EOF
USER USER 
USER USER         # Export the private key using nix-crypto-service
USER USER         "${nix-crypto-service}" export secret \
USER USER           --sled-store "$NIX_CRYPTO_STORE" \
USER USER           --identity-type openssl-pkey \
USER USER           --openssl-pkey-type rsa \
USER USER           --openssl-pkey-id "${key-identity}" \
USER USER           --output-file "$PRIVATE_KEY_FILE" \
USER USER           --log-file "$NIX_CRYPTO_LOG" \
USER USER           --log-level debug
USER USER 
USER USER         # Generate a random value to sign
USER USER         dd if=/dev/urandom of="$RANDOM_FILE" bs=32 count=1 2>/dev/null
USER USER 
USER USER         # Sign the random value using the exported private key
USER USER         openssl dgst -sha256 -sign "$PRIVATE_KEY_FILE" -out "$SIGNATURE_FILE" "$RANDOM_FILE"
USER USER 
USER USER         # Verify the signature using the expected public key
USER USER         if ! openssl dgst -sha256 -verify "$EXPECTED_PUBLIC_KEY_FILE" -signature "$SIGNATURE_FILE" "$RANDOM_FILE"; then
USER USER           exit 1
USER USER         fi
USER USER         exit 0
USER USER       ''
USER USER     ;
USER USER   }
USER USER ```
USER USER 
USER USER journal/0001-openssl-symmetric-key/technical-reports/export-decryptable.txt
USER USER ```
USER USER TECHNICAL IMPLEMENTATION REPORT: OPENSSL SYMMETRIC KEY SUPPORT
USER USER ===============================================================
USER USER 
USER USER 1. OVERVIEW
USER USER -----------
USER USER 
USER USER This report documents the implementation of two related features added to the
USER USER nix-crypto project:
USER USER 
USER USER   1. Export Decryptable: the ability to encrypt an OpenSSL private key with a
USER USER      symmetric key and expose the encrypted result as a PEM-formatted string
USER USER      through the Nix language via a new primop openssl.export-decryptable-pkey.
USER USER 
USER USER   2. Symmetric Key Passphrase Export: the ability to retrieve the raw passphrase
USER USER      (random secret) associated with a symmetric key identity from the credential
USER USER      store, via the nix-crypto-service CLI tool using the new flag
USER USER      --identity-type openssl-symmetric-key.
USER USER 
USER USER Both features are built on top of a new IsOpensslSymmetricKeyIdentity trait and
USER USER a new SymmetricKeyValue type introduced in nix-crypto-core. The design follows
USER USER the same pattern used for OpenSSL private keys: a trait defines the identity, a
USER USER private newtype wrapper implements IsCryptoStoreKey and
USER USER IsCryptoStoreKeyDerivable, and the CryptoNix struct exposes high-level methods
USER USER that delegate to free functions in the relevant submodule.
USER USER 
USER USER The session also included a significant refactoring of the nix-crypto-service
USER USER crate, extracting shared CryptoNix initialisation logic into a new common.rs
USER USER module.
USER USER 
USER USER 
USER USER 2. CORE LIBRARY CHANGES (nix-crypto-core)
USER USER ------------------------------------------
USER USER 
USER USER 2.1 nix-crypto-core/src/openssl/decryptable.rs
USER USER -----------------------------------------------
USER USER 
USER USER This file contains all cryptographic logic for symmetric key management and
USER USER credential encryption. The following types and functions were added.
USER USER 
USER USER 2.1.1 IsOpensslSymmetricKeyIdentity trait
USER USER 
USER USER     pub trait IsOpensslSymmetricKeyIdentity {
USER USER         fn key_id(&self) -> &String;
USER USER         fn key_derivation(&self) -> &String;
USER USER         fn iterations(&self) -> u32;
USER USER     }
USER USER 
USER USER This trait is the primary abstraction for identifying a symmetric key. Any type
USER USER implementing this trait can be used to look up or derive a symmetric key in the
USER USER credential store. The three fields map directly to the parameters exposed in
USER USER both the Nix layer and the CLI:
USER USER 
USER USER   - key_id: a unique string identifier for the key within the store.
USER USER   - key_derivation: the name of the key derivation function. Currently only
USER USER     "pbkdf2" is supported.
USER USER   - iterations: the number of iterations for the KDF.
USER USER 
USER USER 2.1.2 KeyDerivation enum
USER USER 
USER USER     pub enum KeyDerivation {
USER USER         PBKDF2 = 0
USER USER     }
USER USER 
USER USER A repr(u8) enum representing the supported key derivation schemes. It is
USER USER serialised as a single byte when persisting SymmetricKeyValue to the store.
USER USER Conversion from/to String and u8 is provided via from_string and from_u8.
USER USER 
USER USER 2.1.3 SymmetricKeyValue
USER USER 
USER USER     pub struct SymmetricKeyValue {
USER USER         pub random_secret: String,
USER USER         pub key_derivation: KeyDerivation,
USER USER         pub iterations: u32,
USER USER     }
USER USER 
USER USER This is the value stored in the CryptoStore for a symmetric key. It contains:
USER USER 
USER USER   - random_secret: a base64-encoded 16-byte random value generated by OpenSSL's
USER USER     rand_bytes. This is the passphrase used as input to the KDF.
USER USER   - key_derivation: the KeyDerivation variant used for this key.
USER USER   - iterations: the number of KDF iterations.
USER USER 
USER USER Serialisation format (to_bytes / from_bytes):
USER USER 
USER USER     "<key_derivation_u8>:<iterations>:<random_secret>"
USER USER 
USER USER The random_secret is placed last so that splitn(3, ':') can be used safely even
USER USER if the base64 string itself contains colons.
USER USER 
USER USER The derive_aes_key method uses pbkdf2_hmac with SHA-256 to derive a 32-byte AES
USER USER key from the random_secret and a provided salt.
USER USER 
USER USER 2.1.4 SymmetricKeyIdentity (private newtype)
USER USER 
USER USER     struct SymmetricKeyIdentity<'a, T: IsOpensslSymmetricKeyIdentity>(&'a T);
USER USER 
USER USER This private newtype wraps a reference to any IsOpensslSymmetricKeyIdentity
USER USER implementor. It implements IsCryptoStoreKey and IsCryptoStoreKeyDerivable,
USER USER allowing the CryptoNix::get_or_derive machinery to be used without exposing
USER USER SymmetricKeyValue publicly.
USER USER 
USER USER The store key is derived by hashing key_id, key_derivation, and iterations
USER USER together using StoreHasher.
USER USER 
USER USER The derive method generates 16 random bytes via rand_bytes, base64-encodes them
USER USER to produce random_secret, and constructs a SymmetricKeyValue.
USER USER 
USER USER 2.1.5 EncryptionParams and EncryptionParamsKey
USER USER 
USER USER     pub struct EncryptionParams {
USER USER         pub salt: Vec<u8>,
USER USER         pub iv: Vec<u8>,
USER USER     }
USER USER 
USER USER EncryptionParams stores the salt (8 bytes) and IV (16 bytes) used to encrypt a
USER USER specific (symmetric_key, credential) pair. By persisting these in the store,
USER USER calling export_decryptable with the same key, credential, and store always
USER USER produces identical ciphertext output. This is important for referential
USER USER transparency in the Nix evaluation model.
USER USER 
USER USER EncryptionParamsKey is a private struct that implements IsCryptoStoreKey for
USER USER EncryptionParams. Its store key is derived by hashing the string
USER USER "encryption_params" together with the raw store keys of both the symmetric key
USER USER identity and the credential identity, making it unique per (key, credential)
USER USER pair.
USER USER 
USER USER 2.1.6 encrypt_to_pem (private function)
USER USER 
USER USER This function encrypts a plaintext byte vector using AES-128-CBC and returns a
USER USER PEM-formatted string. The payload layout follows the OpenSSL enc format:
USER USER 
USER USER     "Salted__" (8 bytes) | salt (8 bytes) | ciphertext
USER USER 
USER USER The whole payload is base64-encoded and wrapped in a PEM envelope with the
USER USER header "-----BEGIN ENCRYPTED DATA-----" and footer
USER USER "-----END ENCRYPTED DATA-----". The base64 body is line-wrapped at 64
USER USER characters per line, as is standard for PEM.
USER USER 
USER USER 2.1.7 export_decryptable (public free function)
USER USER 
USER USER     pub fn export_decryptable<K, C>(
USER USER         crypto_nix: &CryptoNix,
USER USER         key: &K,
USER USER         credential: &C,
USER USER     ) -> Result<String, Error>
USER USER     where
USER USER         K: IsOpensslSymmetricKeyIdentity,
USER USER         C: IsCryptoStoreKeyDerivable,
USER USER         C::Value: Decryptable,
USER USER 
USER USER This is the main entry point for the export-decryptable feature. It:
USER USER 
USER USER   1. Wraps key in a SymmetricKeyIdentity and calls get_or_derive to obtain or
USER USER      generate the SymmetricKeyValue.
USER USER   2. Calls get_or_derive on the credential to obtain or generate the credential
USER USER      value.
USER USER   3. Constructs an EncryptionParamsKey from the symmetric key identity and the
USER USER      credential, and calls get_or_derive to obtain or generate the
USER USER      EncryptionParams (salt and IV).
USER USER   4. Calls credential_value.export() to obtain the plaintext bytes.
USER USER   5. Calls encrypt_to_pem to produce the final PEM string.
USER USER 
USER USER 2.1.8 get_symmetric_key_passphrase (public free function)
USER USER 
USER USER     pub fn get_symmetric_key_passphrase<K: IsOpensslSymmetricKeyIdentity>(
USER USER         crypto_nix: &CryptoNix,
USER USER         key: &K,
USER USER     ) -> Result<String, Error>
USER USER 
USER USER This free function wraps a reference to any IsOpensslSymmetricKeyIdentity in a
USER USER SymmetricKeyIdentity and calls get_or_derive to obtain the SymmetricKeyValue,
USER USER returning its random_secret field. This is the passphrase that would be used as
USER USER input to the KDF when decrypting a credential encrypted with this key.
USER USER 
USER USER Calling this function multiple times with the same key and store always returns
USER USER the same passphrase, because the SymmetricKeyValue is stored on the first call
USER USER and reused thereafter.
USER USER 
USER USER 2.2 nix-crypto-core/src/openssl.rs
USER USER ------------------------------------
USER USER 
USER USER Two new methods were added to the CryptoNix impl block in this file.
USER USER 
USER USER 2.2.1 export_decryptable
USER USER 
USER USER     pub fn export_decryptable<K, C>(
USER USER         &self,
USER USER         key: &K,
USER USER         credential: &C,
USER USER     ) -> Result<String, Error>
USER USER     where
USER USER         K: decryptable::IsOpensslSymmetricKeyIdentity,
USER USER         C: IsCryptoStoreKeyDerivable,
USER USER         C::Value: decryptable::Decryptable,
USER USER 
USER USER A method on CryptoNix that delegates to the free function
USER USER decryptable::export_decryptable. This follows the same pattern as
USER USER openssl_private_key, which delegates to the pkey submodule.
USER USER 
USER USER 2.2.2 openssl_symmetric_key_passphrase
USER USER 
USER USER     pub fn openssl_symmetric_key_passphrase<K: decryptable::IsOpensslSymmetricKeyIdentity>(
USER USER         &self,
USER USER         key: &K,
USER USER     ) -> Result<String, Error>
USER USER 
USER USER A method on CryptoNix that delegates to the free function
USER USER decryptable::get_symmetric_key_passphrase. This is the method called by
USER USER nix-crypto-service when exporting a symmetric key passphrase.
USER USER 
USER USER The decision to implement the logic as free functions in decryptable.rs and have
USER USER the CryptoNix methods delegate to them was made to avoid making SymmetricKeyIdentity
USER USER and SymmetricKeyValue public, while still keeping the CryptoNix API clean and
USER USER consistent.
USER USER 
USER USER 
USER USER 3. PLUGIN CHANGES (nix-crypto-plugin)
USER USER ---------------------------------------
USER USER 
USER USER 3.1 nix-crypto-plugin/src/cxx_bridge.rs
USER USER -----------------------------------------
USER USER 
USER USER A new CXX struct was added to the bridge:
USER USER 
USER USER     pub struct OpensslSymmetricKeyIdentity {
USER USER         pub key_id: String,
USER USER         pub key_derivation: String,
USER USER         pub iterations: u32,
USER USER     }
USER USER 
USER USER This struct is shared between Rust and C++ via the CXX bridge. It carries the
USER USER three fields of IsOpensslSymmetricKeyIdentity across the FFI boundary.
USER USER 
USER USER A new method was added to the CxxNixCrypto extern block:
USER USER 
USER USER     fn cxx_export_decryptable_openssl_pkey(
USER USER         self: &CxxNixCrypto,
USER USER         symmetric_key: OpensslSymmetricKeyIdentity,
USER USER         credential: OpensslPrivateKeyIdentity
USER USER     ) -> Result<String>;
USER USER 
USER USER This is a monomorphic CXX-callable wrapper around export_decryptable for the
USER USER specific case of encrypting an OpenSSL private key credential.
USER USER 
USER USER 3.2 nix-crypto-plugin/src/cxx_api.rs
USER USER --------------------------------------
USER USER 
USER USER IsOpensslSymmetricKeyIdentity was implemented for the CXX bridge struct
USER USER OpensslSymmetricKeyIdentity:
USER USER 
USER USER     impl IsOpensslSymmetricKeyIdentity for OpensslSymmetricKeyIdentity {
USER USER         fn key_id(&self) -> &String { &self.key_id }
USER USER         fn key_derivation(&self) -> &String { &self.key_derivation }
USER USER         fn iterations(&self) -> u32 { self.iterations }
USER USER     }
USER USER 
USER USER The method cxx_export_decryptable_openssl_pkey was implemented on CxxNixCrypto:
USER USER 
USER USER     pub fn cxx_export_decryptable_openssl_pkey(
USER USER         &self,
USER USER         symmetric_key: OpensslSymmetricKeyIdentity,
USER USER         credential: OpensslPrivateKeyIdentity,
USER USER     ) -> Result<String, Error> {
USER USER         export_decryptable(
USER USER             &self.0,
USER USER             &symmetric_key,
USER USER             &OpensslPrivateKeyIdentityWrapper(&credential),
USER USER         )
USER USER     }
USER USER 
USER USER This wraps the credential in an OpensslPrivateKeyIdentityWrapper (which
USER USER implements IsCryptoStoreKeyDerivable) before passing it to export_decryptable.
USER USER 
USER USER 3.3 nix-crypto-plugin/include/nix_crypto.hh
USER USER ---------------------------------------------
USER USER 
