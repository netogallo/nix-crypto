USER test/openssl.nix
USER ```
USER /**
USER   Test suite for OpenSSL functionality.
USER 
USER   Accepts the following arguments:
USER   - `pkgs`: the nixpkgs package set.
USER   - `nix-crypto-service`: path to the `nix-crypto-service` binary.
USER */
USER { pkgs, nix-crypto-service, ... }:
USER let
USER   crypto = pkgs.callPackage ../crypto/default.nix {};
USER   inherit (crypto) openssl;
USER 
USER   # Generates an RSA key or returns the existing one from the store.
USER   # The private key itself is not returned — only operations that can
USER   # be performed with it.
USER   pk-rsa = openssl.private-key { 
USER     attrs = {
USER       vault = "openssl";
USER       name = "openssl-test-key";
USER     };
USER     type = "rsa";
USER   };
USER in
USER   {
USER     # Asserts that the plugin can generate or retrieve a public key in PEM format.
USER     "It can generate a public/private key set" = { _assert, ... }:
USER       _assert.is-string pk-rsa.public-key-pem
USER     ;
USER 
USER     # Asserts that the plugin can build a self-signed X.509 certificate
USER     # signed by the RSA key.
USER     "It can generate a x509 self-signed certificate" = { _assert, ... }:
USER     let
USER       x509 = pk-rsa.x509 {
USER         subject-name = { CN = "subject"; };
USER         issuer-name = { CN = "issuer"; };
USER         serial = 1;
USER         start-date = "2026-01-09T21:29:36Z";
USER         expiry-date = "2036-01-09T21:29:36Z";
USER       };
USER     in
USER       # Derivation which outputs the public certificate of the CA
USER       # safe to write into the nix store.
USER       _assert.strings.has-prefix "-----BEGIN CERTIFICATE-----" x509.certificate-pem
USER     ;
USER 
USER     /**
USER       Asserts that a private key stored by the nix-crypto plugin can be exported
USER       using `nix-crypto-service export secret`, and that the public key derived
USER       from the exported private key matches the public key computed by the plugin.
USER 
USER       The `NIX_CRYPTO_STORE` environment variable must point to the same sled store used
USER       by the nix-crypto plugin so that `nix-crypto-service` can locate the key.
USER     */
USER     "It can export the private key" = { _assert, ... }:
USER     let
USER       # The public key pem as computed by the nix plugin
USER       expected-public-key-pem = pk-rsa.public-key-pem;
USER       # The identity of the key, used to locate it in the store
USER       key-identity = pk-rsa.identity;
USER     in
USER       _assert.bash-script
USER       ''
USER         PRIVATE_KEY_FILE=$(mktemp)
USER         EXPECTED_PUBLIC_KEY_FILE=$(mktemp)
USER         RANDOM_FILE=$(mktemp)
USER         SIGNATURE_FILE=$(mktemp)
USER 
USER         # Write the expected public key pem to a temp file
USER         cat > "$EXPECTED_PUBLIC_KEY_FILE" << 'EOF'
USER         ${expected-public-key-pem}
USER         EOF
USER 
USER         # Export the private key using nix-crypto-service
USER         "${nix-crypto-service}" export secret \
USER           --sled-store "$NIX_CRYPTO_STORE" \
USER           --identity-type openssl-pkey \
USER           --openssl-pkey-type rsa \
USER           --openssl-pkey-id "${key-identity}" \
USER           --output-file "$PRIVATE_KEY_FILE" \
USER           --log-file "$NIX_CRYPTO_LOG" \
USER           --log-level debug
USER 
USER         # Generate a random value to sign
USER         dd if=/dev/urandom of="$RANDOM_FILE" bs=32 count=1 2>/dev/null
USER 
USER         # Sign the random value using the exported private key
USER         openssl dgst -sha256 -sign "$PRIVATE_KEY_FILE" -out "$SIGNATURE_FILE" "$RANDOM_FILE"
USER 
USER         # Verify the signature using the expected public key
USER         if ! openssl dgst -sha256 -verify "$EXPECTED_PUBLIC_KEY_FILE" -signature "$SIGNATURE_FILE" "$RANDOM_FILE"; then
USER           exit 1
USER         fi
USER         exit 0
USER       ''
USER     ;
USER   }
USER ```
USER 
USER journal/0001-openssl-symmetric-key/technical-reports/export-decryptable.txt
USER ```
USER TECHNICAL IMPLEMENTATION REPORT: OPENSSL SYMMETRIC KEY SUPPORT
USER ===============================================================
USER 
USER 1. OVERVIEW
USER -----------
USER 
USER This report documents the implementation of two related features added to the
USER nix-crypto project:
USER 
USER   1. Export Decryptable: the ability to encrypt an OpenSSL private key with a
USER      symmetric key and expose the encrypted result as a PEM-formatted string
USER      through the Nix language via a new primop openssl.export-decryptable-pkey.
USER 
USER   2. Symmetric Key Passphrase Export: the ability to retrieve the raw passphrase
USER      (random secret) associated with a symmetric key identity from the credential
USER      store, via the nix-crypto-service CLI tool using the new flag
USER      --identity-type openssl-symmetric-key.
USER 
USER Both features are built on top of a new IsOpensslSymmetricKeyIdentity trait and
USER a new SymmetricKeyValue type introduced in nix-crypto-core. The design follows
USER the same pattern used for OpenSSL private keys: a trait defines the identity, a
USER private newtype wrapper implements IsCryptoStoreKey and
USER IsCryptoStoreKeyDerivable, and the CryptoNix struct exposes high-level methods
USER that delegate to free functions in the relevant submodule.
USER 
USER The session also included a significant refactoring of the nix-crypto-service
USER crate, extracting shared CryptoNix initialisation logic into a new common.rs
USER module.
USER 
USER 
USER 2. CORE LIBRARY CHANGES (nix-crypto-core)
USER ------------------------------------------
USER 
USER 2.1 nix-crypto-core/src/openssl/decryptable.rs
USER -----------------------------------------------
USER 
USER This file contains all cryptographic logic for symmetric key management and
USER credential encryption. The following types and functions were added.
USER 
USER 2.1.1 IsOpensslSymmetricKeyIdentity trait
USER 
USER     pub trait IsOpensslSymmetricKeyIdentity {
USER         fn key_id(&self) -> &String;
USER         fn key_derivation(&self) -> &String;
USER         fn iterations(&self) -> u32;
USER     }
USER 
USER This trait is the primary abstraction for identifying a symmetric key. Any type
USER implementing this trait can be used to look up or derive a symmetric key in the
USER credential store. The three fields map directly to the parameters exposed in
USER both the Nix layer and the CLI:
USER 
USER   - key_id: a unique string identifier for the key within the store.
USER   - key_derivation: the name of the key derivation function. Currently only
USER     "pbkdf2" is supported.
USER   - iterations: the number of iterations for the KDF.
USER 
USER 2.1.2 KeyDerivation enum
USER 
USER     pub enum KeyDerivation {
USER         PBKDF2 = 0
USER     }
USER 
USER A repr(u8) enum representing the supported key derivation schemes. It is
USER serialised as a single byte when persisting SymmetricKeyValue to the store.
USER Conversion from/to String and u8 is provided via from_string and from_u8.
USER 
USER 2.1.3 SymmetricKeyValue
USER 
USER     pub struct SymmetricKeyValue {
USER         pub random_secret: String,
USER         pub key_derivation: KeyDerivation,
USER         pub iterations: u32,
USER     }
USER 
USER This is the value stored in the CryptoStore for a symmetric key. It contains:
USER 
USER   - random_secret: a base64-encoded 16-byte random value generated by OpenSSL's
USER     rand_bytes. This is the passphrase used as input to the KDF.
USER   - key_derivation: the KeyDerivation variant used for this key.
USER   - iterations: the number of KDF iterations.
USER 
USER Serialisation format (to_bytes / from_bytes):
USER 
USER     "<key_derivation_u8>:<iterations>:<random_secret>"
USER 
USER The random_secret is placed last so that splitn(3, ':') can be used safely even
USER if the base64 string itself contains colons.
USER 
USER The derive_aes_key method uses pbkdf2_hmac with SHA-256 to derive a 32-byte AES
USER key from the random_secret and a provided salt.
USER 
USER 2.1.4 SymmetricKeyIdentity (private newtype)
USER 
USER     struct SymmetricKeyIdentity<'a, T: IsOpensslSymmetricKeyIdentity>(&'a T);
USER 
USER This private newtype wraps a reference to any IsOpensslSymmetricKeyIdentity
USER implementor. It implements IsCryptoStoreKey and IsCryptoStoreKeyDerivable,
USER allowing the CryptoNix::get_or_derive machinery to be used without exposing
USER SymmetricKeyValue publicly.
USER 
USER The store key is derived by hashing key_id, key_derivation, and iterations
USER together using StoreHasher.
USER 
USER The derive method generates 16 random bytes via rand_bytes, base64-encodes them
USER to produce random_secret, and constructs a SymmetricKeyValue.
USER 
USER 2.1.5 EncryptionParams and EncryptionParamsKey
USER 
USER     pub struct EncryptionParams {
USER         pub salt: Vec<u8>,
USER         pub iv: Vec<u8>,
USER     }
USER 
USER EncryptionParams stores the salt (8 bytes) and IV (16 bytes) used to encrypt a
USER specific (symmetric_key, credential) pair. By persisting these in the store,
USER calling export_decryptable with the same key, credential, and store always
USER produces identical ciphertext output. This is important for referential
USER transparency in the Nix evaluation model.
USER 
USER EncryptionParamsKey is a private struct that implements IsCryptoStoreKey for
USER EncryptionParams. Its store key is derived by hashing the string
USER "encryption_params" together with the raw store keys of both the symmetric key
USER identity and the credential identity, making it unique per (key, credential)
USER pair.
USER 
USER 2.1.6 encrypt_to_pem (private function)
USER 
USER This function encrypts a plaintext byte vector using AES-128-CBC and returns a
USER PEM-formatted string. The payload layout follows the OpenSSL enc format:
USER 
USER     "Salted__" (8 bytes) | salt (8 bytes) | ciphertext
USER 
USER The whole payload is base64-encoded and wrapped in a PEM envelope with the
USER header "-----BEGIN ENCRYPTED DATA-----" and footer
USER "-----END ENCRYPTED DATA-----". The base64 body is line-wrapped at 64
USER characters per line, as is standard for PEM.
USER 
USER 2.1.7 export_decryptable (public free function)
USER 
USER     pub fn export_decryptable<K, C>(
USER         crypto_nix: &CryptoNix,
USER         key: &K,
USER         credential: &C,
USER     ) -> Result<String, Error>
USER     where
USER         K: IsOpensslSymmetricKeyIdentity,
USER         C: IsCryptoStoreKeyDerivable,
USER         C::Value: Decryptable,
USER 
USER This is the main entry point for the export-decryptable feature. It:
USER 
USER   1. Wraps key in a SymmetricKeyIdentity and calls get_or_derive to obtain or
USER      generate the SymmetricKeyValue.
USER   2. Calls get_or_derive on the credential to obtain or generate the credential
USER      value.
USER   3. Constructs an EncryptionParamsKey from the symmetric key identity and the
USER      credential, and calls get_or_derive to obtain or generate the
USER      EncryptionParams (salt and IV).
USER   4. Calls credential_value.export() to obtain the plaintext bytes.
USER   5. Calls encrypt_to_pem to produce the final PEM string.
USER 
USER 2.1.8 get_symmetric_key_passphrase (public free function)
USER 
USER     pub fn get_symmetric_key_passphrase<K: IsOpensslSymmetricKeyIdentity>(
USER         crypto_nix: &CryptoNix,
USER         key: &K,
USER     ) -> Result<String, Error>
USER 
USER This free function wraps a reference to any IsOpensslSymmetricKeyIdentity in a
USER SymmetricKeyIdentity and calls get_or_derive to obtain the SymmetricKeyValue,
USER returning its random_secret field. This is the passphrase that would be used as
USER input to the KDF when decrypting a credential encrypted with this key.
USER 
USER Calling this function multiple times with the same key and store always returns
USER the same passphrase, because the SymmetricKeyValue is stored on the first call
USER and reused thereafter.
USER 
USER 2.2 nix-crypto-core/src/openssl.rs
USER ------------------------------------
USER 
USER Two new methods were added to the CryptoNix impl block in this file.
USER 
USER 2.2.1 export_decryptable
USER 
USER     pub fn export_decryptable<K, C>(
USER         &self,
USER         key: &K,
USER         credential: &C,
USER     ) -> Result<String, Error>
USER     where
USER         K: decryptable::IsOpensslSymmetricKeyIdentity,
USER         C: IsCryptoStoreKeyDerivable,
USER         C::Value: decryptable::Decryptable,
USER 
USER A method on CryptoNix that delegates to the free function
USER decryptable::export_decryptable. This follows the same pattern as
USER openssl_private_key, which delegates to the pkey submodule.
USER 
USER 2.2.2 openssl_symmetric_key_passphrase
USER 
USER     pub fn openssl_symmetric_key_passphrase<K: decryptable::IsOpensslSymmetricKeyIdentity>(
USER         &self,
USER         key: &K,
USER     ) -> Result<String, Error>
USER 
USER A method on CryptoNix that delegates to the free function
USER decryptable::get_symmetric_key_passphrase. This is the method called by
USER nix-crypto-service when exporting a symmetric key passphrase.
USER 
USER The decision to implement the logic as free functions in decryptable.rs and have
USER the CryptoNix methods delegate to them was made to avoid making SymmetricKeyIdentity
USER and SymmetricKeyValue public, while still keeping the CryptoNix API clean and
USER consistent.
USER 
USER 
USER 3. PLUGIN CHANGES (nix-crypto-plugin)
USER ---------------------------------------
USER 
USER 3.1 nix-crypto-plugin/src/cxx_bridge.rs
USER -----------------------------------------
USER 
USER A new CXX struct was added to the bridge:
USER 
USER     pub struct OpensslSymmetricKeyIdentity {
USER         pub key_id: String,
USER         pub key_derivation: String,
USER         pub iterations: u32,
USER     }
USER 
USER This struct is shared between Rust and C++ via the CXX bridge. It carries the
USER three fields of IsOpensslSymmetricKeyIdentity across the FFI boundary.
USER 
USER A new method was added to the CxxNixCrypto extern block:
USER 
USER     fn cxx_export_decryptable_openssl_pkey(
USER         self: &CxxNixCrypto,
USER         symmetric_key: OpensslSymmetricKeyIdentity,
USER         credential: OpensslPrivateKeyIdentity
USER     ) -> Result<String>;
USER 
USER This is a monomorphic CXX-callable wrapper around export_decryptable for the
USER specific case of encrypting an OpenSSL private key credential.
USER 
USER 3.2 nix-crypto-plugin/src/cxx_api.rs
USER --------------------------------------
USER 
USER IsOpensslSymmetricKeyIdentity was implemented for the CXX bridge struct
USER OpensslSymmetricKeyIdentity:
USER 
USER     impl IsOpensslSymmetricKeyIdentity for OpensslSymmetricKeyIdentity {
USER         fn key_id(&self) -> &String { &self.key_id }
USER         fn key_derivation(&self) -> &String { &self.key_derivation }
USER         fn iterations(&self) -> u32 { self.iterations }
USER     }
USER 
USER The method cxx_export_decryptable_openssl_pkey was implemented on CxxNixCrypto:
USER 
USER     pub fn cxx_export_decryptable_openssl_pkey(
USER         &self,
USER         symmetric_key: OpensslSymmetricKeyIdentity,
USER         credential: OpensslPrivateKeyIdentity,
USER     ) -> Result<String, Error> {
USER         export_decryptable(
USER             &self.0,
USER             &symmetric_key,
USER             &OpensslPrivateKeyIdentityWrapper(&credential),
USER         )
USER     }
USER 
USER This wraps the credential in an OpensslPrivateKeyIdentityWrapper (which
USER implements IsCryptoStoreKeyDerivable) before passing it to export_decryptable.
USER 
USER 3.3 nix-crypto-plugin/include/nix_crypto.hh
USER ---------------------------------------------
USER 
USER A new method was added to the CryptoNixPrimops class:
USER 
USER     std::string opensslExportDecryptableOpensslPkey(
USER         OpensslSymmetricKeyIdentity&& symmetric_key,
USER         OpensslPrivateKeyIdentity&& credential
USER     );
USER 
USER This method is called from the C++ primop implementation and delegates to the
USER CXX bridge method cxx_export_decryptable_openssl_pkey.
USER 
USER 3.4 nix-crypto-plugin/src/nix_crypto.cc
USER -----------------------------------------
USER 
USER The implementation of opensslExportDecryptableOpensslPkey was added:
USER 
USER     std::string CryptoNixPrimops::opensslExportDecryptableOpensslPkey(
USER         OpensslSymmetricKeyIdentity&& symmetric_key,
USER         OpensslPrivateKeyIdentity&& credential
USER     ) {
USER         return std::string(
USER             cryptoNix()->cxx_export_decryptable_openssl_pkey(
USER                 symmetric_key, credential
USER             ).c_str()
USER         );
USER     }
USER 
USER 3.5 nix-crypto-plugin/src/openssl_primops.cc
USER ----------------------------------------------
USER 
USER A new helper function was added to extract an OpensslSymmetricKeyIdentity from
USER a Nix attribute set:
USER 
USER     static OpensslSymmetricKeyIdentity openssl_get_symmetric_key_identity(
USER         EvalState& state,
USER         const PosIdx pos,
USER         Value& key_args
USER     )
USER 
USER This function forces the attribute set and reads the three fields key-id,
USER key-derivation, and iterations, constructing an OpensslSymmetricKeyIdentity.
USER 
USER A new primop function was added:
USER 
USER     static void primop_openssl_export_decryptable_pkey(
USER         EvalState& state,
USER         const PosIdx pos,
USER         Value** args,
USER         Value& result
USER     )
USER 
USER This primop has arity 2. The first argument is the symmetric key attribute set
USER and the second is the private key identity attribute set. It calls
USER openssl_get_symmetric_key_identity and openssl_get_private_key_identity
USER respectively, then delegates to primops->opensslExportDecryptableOpensslPkey.
USER 
USER The primop is registered under the name "export-decryptable-pkey" in the
USER openssl attribute set exposed by the crypto primop. OPENSSL_PRIMOPS_COUNT was
USER incremented from 2 to 3 to accommodate the new primop.
USER 
USER A build error was encountered and fixed: constexpr const std::string is not
USER valid for non-local variables in GCC 14. The two string constants K_X509_PEM
USER and K_EXPORT_DECRYPTABLE_PKEY were changed from constexpr const std::string to
USER constexpr const char*.
USER 
USER 
USER 4. NIX LAYER CHANGES (crypto/openssl/)
USER ----------------------------------------
USER 
USER 4.1 crypto/openssl/export-decryptable-pkey-params-type.nix (new file)
USER -----------------------------------------------------------------------
USER 
USER A new NixOS module type was defined for the parameters of export-decryptable-pkey:
USER 
USER     types.submodule {
USER       options = {
USER         key-id = lib.mkOption { type = types.str; ... };
USER         key-derivation = lib.mkOption {
USER           type = types.enum [ "pbkdf2" ];
USER           default = "pbkdf2";
USER           ...
USER         };
USER         iterations = lib.mkOption { type = types.int; ... };
USER       };
USER     }
USER 
USER This type enforces that callers provide a valid key-id, a supported
USER key-derivation scheme, and a positive integer number of iterations.
USER 
USER 4.2 crypto/openssl/default.nix
USER --------------------------------
USER 
USER The new export-decryptable-pkey-params-type was registered in the module scope:
USER 
USER     export-decryptable-pkey-params-type =
USER       self.callPackage ./export-decryptable-pkey-params-type.nix {};
USER 
USER 4.3 crypto/openssl/main.nix
USER -----------------------------
USER 
USER The export-decryptable-pkey-params-type was added as a module argument.
USER 
USER A private helper function export-decryptable-pkey was defined:
USER 
USER     export-decryptable-pkey = { key-ref, symmetric-key-params }:
USER       openssl.export-decryptable-pkey symmetric-key-params key-ref
USER     ;
USER 
USER This calls the Nix primop openssl.export-decryptable-pkey with the symmetric
USER key params as the first argument and the private key reference as the second,
USER matching the arity-2 primop signature.
USER 
USER The export-decryptable-pkey function was exposed on the private key attribute
USER set returned by private-key-impl, wrapped in a type-checker.function call that
USER validates the symmetric-key-params argument against
USER export-decryptable-pkey-params-type:
USER 
USER     export-decryptable-pkey =
USER       type-checker.function
USER       [ { name = "symmetric-key-params";
USER           type = export-decryptable-pkey-params-type; } ]
USER       (symmetric-key-params:
USER         export-decryptable-pkey { inherit key-ref symmetric-key-params; })
USER     ;
USER 
USER The identity field was also added to the private key attribute set:
USER 
USER     identity = key-ref.key-identity;
USER 
USER This exposes the key identity string directly so that callers such as
USER nix-crypto-service can locate the key in the sled store without reconstructing
USER the identity manually.
USER 
USER 
USER 5. SERVICE CHANGES (nix-crypto-service)
USER -----------------------------------------
USER 
USER 5.1 Refactoring: nix-crypto-service/src/common.rs (new file)
USER --------------------------------------------------------------
USER 
USER As part of this session, shared CryptoNix initialisation logic was extracted
USER from export.rs into a new common.rs module. This module defines:
USER 
USER 5.1.1 Error enum
USER 
USER     pub enum Error {
USER         ArgumentError(String),
USER         UnknownAction,
USER     }
USER 
USER A unified error type for the service crate. ArgumentError carries a descriptive
USER message. UnknownAction is returned when no recognised subcommand is matched.
USER The as_string method formats the error for display to the user.
USER 
USER 5.1.2 StoreArgs enum
USER 
USER     pub enum StoreArgs {
USER         SledStoreArgs { sled_store_directory: String },
USER     }
USER 
USER Represents the specification for initialising a credential store. Currently
USER only the Sled backend is supported. The resolve_sled_store associated function
USER resolves the store path from either the --sled-store CLI flag or the
USER NIX_CRYPTO_STORE environment variable (which must be in the format
USER "sled:<path>"). The to_config method converts StoreArgs into a SledModeConfig
USER for use with CryptoNix::from_sled_config.
USER 
USER 5.1.3 LogArgs struct
USER 
USER     pub struct LogArgs {
USER         pub log_file: Option<String>,
USER         pub log_level: Option<LogLevel>,
USER     }
USER 
USER Represents the specification for initialising the logger. The from_flags
USER associated function parses the --log-file and --log-level CLI flags. The init
USER method constructs a Logger, returning Logger::dummy() if no log file is
USER specified, or Logger::file() otherwise. The log level defaults to LogLevel::Info
USER if absent.
USER 
USER 5.1.4 NixCryptoArgs struct
USER 
USER     pub struct NixCryptoArgs {
USER         pub nix_crypto_store: StoreArgs,
USER         pub nix_crypto_log: LogArgs,
USER     }
USER 
USER Combines StoreArgs and LogArgs into a single struct that can be used to
USER initialise a CryptoNix instance. The from_flags associated function is the
USER primary constructor, accepting the three relevant CLI flags. The init method
USER calls nix_crypto_log.init() to obtain a Logger and nix_crypto_store.to_config()
USER to obtain a SledModeConfig, then calls CryptoNix::from_sled_config.
USER 
USER 5.2 nix-crypto-service/src/export.rs
USER --------------------------------------
USER 
USER The export.rs module was refactored to use NixCryptoArgs from common.rs,
USER removing the duplicated store and logger resolution logic. The following
USER changes were made:
USER 
USER 5.2.1 New IdentityType variant
USER 
USER     OpensslSymmetricKey {
USER         key_id: String,
USER         key_derivation: String,
USER         iterations: u32,
USER     }
USER 
USER Added alongside the existing OpensslPkey variant to represent a symmetric key
USER identity for the export secret subcommand.
USER 
USER 5.2.2 OpensslSymmetricKeyIdentity struct
USER 
USER A private struct implementing IsOpensslSymmetricKeyIdentity was defined locally
USER in export.rs:
USER 
USER     struct OpensslSymmetricKeyIdentity {
USER         key_id: String,
USER         key_derivation: String,
USER         iterations: u32,
USER     }
USER 
USER This is used in run_secret to call crypto_nix.openssl_symmetric_key_passphrase.
USER 
USER 5.2.3 resolve_identity_type
USER 
USER The resolve_identity_type function was extended to handle the new
USER "openssl-symmetric-key" identity type. It reads the three new flags:
USER 
USER   - --openssl-symmetric-key-id (required)
USER   - --openssl-symmetric-key-derivation (optional, defaults to "pbkdf2")
USER   - --openssl-symmetric-key-iterations (optional, defaults to 600000)
USER 
USER The iterations flag is parsed as a u32, with a descriptive error returned if
USER the value is not a valid positive integer.
USER 
USER 5.2.4 resolve_args
USER 
USER The resolve_args function signature was updated to accept NixCryptoArgs instead
USER of individual store and logger flags, and to accept the three new symmetric key
USER flags.
USER 
USER 5.2.5 run_secret
USER 
USER The run_secret function was extended with a new match arm for
USER IdentityType::OpensslSymmetricKey. It:
USER 
USER   1. Constructs an OpensslSymmetricKeyIdentity from the resolved fields.
USER   2. Calls crypto_nix.openssl_symmetric_key_passphrase to retrieve the
USER      passphrase from the store (or derive and store it on first use).
USER   3. Writes the passphrase as a plain string to the output file specified by
USER      --output-file.
USER   4. Prints a success message to stdout.
USER 
USER 5.3 nix-crypto-service/src/main.rs
USER ------------------------------------
USER 
USER The main.rs module was updated to:
USER 
USER   1. Declare the new common module and import NixCryptoArgs and Error from it.
USER   2. Add three new CLI flags to the USAGE string and Args struct:
USER        --openssl-symmetric-key-id
USER        --openssl-symmetric-key-derivation
USER        --openssl-symmetric-key-iterations
USER   3. Implement to_nix_crypto_args on Args, which calls NixCryptoArgs::from_flags
USER      with the sled store, log file, and log level flags.
USER   4. Move the subcommand dispatch logic into an Args::main method, which returns
USER      Result<(), Error> and is called from the top-level main function.
USER   5. Pass the three new symmetric key flags through to export::resolve_args.
USER 
USER 
USER 6. DATA FLOW SUMMARY
USER ---------------------
USER 
USER 6.1 Export Decryptable (Nix primop path)
USER 
USER   Nix code calls:
USER     private-key.export-decryptable-pkey { key-id = ...; key-derivation = ...;
USER                                            iterations = ...; }
USER 
USER   This calls the Nix primop:
USER     openssl.export-decryptable-pkey symmetric-key-params key-ref
USER 
USER   The primop (arity 2) is handled by primop_openssl_export_decryptable_pkey in
USER   openssl_primops.cc, which:
USER     1. Reads the symmetric key identity from args[0] via
USER        openssl_get_symmetric_key_identity.
USER     2. Reads the private key identity from args[1] via
USER        openssl_get_private_key_identity.
USER     3. Calls primops->opensslExportDecryptableOpensslPkey.
USER 
USER   CryptoNixPrimops::opensslExportDecryptableOpensslPkey delegates to:
USER     cryptoNix()->cxx_export_decryptable_openssl_pkey(symmetric_key, credential)
USER 
USER   CxxNixCrypto::cxx_export_decryptable_openssl_pkey calls:
USER     export_decryptable(&self.0, &symmetric_key,
USER                        &OpensslPrivateKeyIdentityWrapper(&credential))
USER 
USER   decryptable::export_decryptable:
USER     1. get_or_derive(SymmetricKeyIdentity(key)) -> SymmetricKeyValue
USER     2. get_or_derive(OpensslPrivateKeyIdentityWrapper(credential)) -> Key
USER     3. get_or_derive(EncryptionParamsKey(sym_id, cred)) -> EncryptionParams
USER     4. credential_value.export() -> Vec<u8> (PEM bytes of private key)
USER     5. encrypt_to_pem(sym_key_value, salt, iv, plaintext) -> PEM String
USER 
USER   The resulting PEM string is returned up the call stack and set as a Nix
USER   string value.
USER 
USER 6.2 Symmetric Key Passphrase Export (CLI path)
USER 
USER   User invokes:
USER     nix-crypto-service export secret \
USER       --identity-type openssl-symmetric-key \
USER       --openssl-symmetric-key-id <id> \
USER       --openssl-symmetric-key-derivation pbkdf2 \
USER       --openssl-symmetric-key-iterations 600000 \
USER       --output-file <path>
USER 
USER   Args::main calls export::resolve_args, which calls resolve_identity_type,
USER   producing IdentityType::OpensslSymmetricKey { key_id, key_derivation,
USER   iterations }.
USER 
USER   export::run_secret:
USER     1. Calls args.nix_crypto_args.init() to construct a CryptoNix instance.
USER     2. Constructs OpensslSymmetricKeyIdentity { key_id, key_derivation,
USER        iterations }.
USER     3. Calls crypto_nix.openssl_symmetric_key_passphrase(&identity).
USER     4. Delegates to decryptable::get_symmetric_key_passphrase, which calls
USER        get_or_derive(SymmetricKeyIdentity(key)) and returns
USER        symmetric_key_value.random_secret.
USER     5. Writes the passphrase string to the output file.
USER 
USER 
USER 7. SECURITY NOTES
USER ------------------
USER 
USER   - The random_secret is generated using OpenSSL's rand_bytes, which is a
USER     cryptographically secure random number generator.
USER   - The random_secret is 16 bytes (128 bits) of entropy, base64-encoded to a
USER     24-character string.
USER   - The AES key is derived from random_secret using PBKDF2-HMAC-SHA256 with a
USER     configurable iteration count. The default is 600,000 iterations, which is
USER     consistent with current NIST recommendations for PBKDF2 with SHA-256.
USER   - A unique salt and IV are generated for each (symmetric_key, credential)
USER     pair and persisted in the store. This ensures that the same plaintext
USER     encrypted with the same key always produces the same ciphertext (required
USER     for Nix referential transparency), while preventing IV reuse across
USER     different (key, credential) pairs.
USER   - The passphrase (random_secret) written to disk by nix-crypto-service is
USER     sensitive. The caller is responsible for ensuring the output file has
USER     appropriate permissions.
USER   - Private keys are never exposed in the Nix language. The export-decryptable-pkey
USER     primop returns an encrypted PEM string, not the raw private key.
USER 
USER 
