ASSISTANT 
ASSISTANT /// The value stored in the `CryptoStore` for a symmetric key. Contains the
ASSISTANT /// randomly generated secret, the key derivation scheme, and the iteration
ASSISTANT /// count used for PBKDF2.
ASSISTANT pub struct SymmetricKeyValue {
ASSISTANT     pub random_secret: String,
ASSISTANT     pub key_derivation: KeyDerivation,
ASSISTANT     pub iterations: u32,
ASSISTANT }
ASSISTANT 
ASSISTANT impl SymmetricKeyValue {
ASSISTANT     /// Serialize to bytes as `<key_derivation>:<iterations>:<random_secret>`.
ASSISTANT     fn to_bytes(&self) -> Vec<u8> {
ASSISTANT         format!("{}:{}:{}", (self.key_derivation as u8).clone(), self.iterations, self.random_secret)
ASSISTANT             .into_bytes()
ASSISTANT     }
ASSISTANT 
ASSISTANT     /// Deserialize from bytes produced by `to_bytes`.
ASSISTANT     fn from_bytes(bytes: &[u8]) -> Result<Self, Error> {
ASSISTANT         let s = std::str::from_utf8(bytes)?;
ASSISTANT 
ASSISTANT         // Split into at most 3 parts so the random_secret can itself contain ':'
ASSISTANT         let mut parts = s.splitn(3, ':');
ASSISTANT 
ASSISTANT         let key_derivation_u8 = parts
ASSISTANT             .next()
ASSISTANT             .ok_or_else(|| Error::from_message("Missing key_derivation in SymmetricKeyValue".to_string()))?
ASSISTANT             .to_string()
ASSISTANT             .parse::<u8>()
ASSISTANT             .map_err(|_| Error::from_message("Invalid key derivaiton for value.".to_string()))?;
ASSISTANT 
ASSISTANT         let key_derivation = KeyDerivation::from_u8(key_derivation_u8)?;
ASSISTANT 
ASSISTANT         let iterations_str = parts
ASSISTANT             .next()
ASSISTANT             .ok_or_else(|| Error::from_message("Missing iterations in SymmetricKeyValue".to_string()))?;
ASSISTANT 
ASSISTANT         let iterations = iterations_str
ASSISTANT             .parse::<u32>()
ASSISTANT             .map_err(|_| Error::from_message(format!("Invalid iterations value: {}", iterations_str)))?;
ASSISTANT 
ASSISTANT         let random_secret = parts
ASSISTANT             .next()
ASSISTANT             .ok_or_else(|| Error::from_message("Missing random_secret in SymmetricKeyValue".to_string()))?
ASSISTANT             .to_string();
ASSISTANT 
ASSISTANT         Ok(SymmetricKeyValue { random_secret, key_derivation, iterations })
ASSISTANT     }
ASSISTANT 
ASSISTANT 
ASSISTANT     /// Derive a 256-bit AES key from a passphrase using the specified
ASSISTANT     /// key derivation method.
ASSISTANT     fn derive_aes_key(&self, salt: &[u8]) -> Result<Vec<u8>, Error> {
ASSISTANT 
ASSISTANT         match self.key_derivation {
ASSISTANT             KeyDerivation::PBKDF2 => {
ASSISTANT                 let mut key = vec![0u8; 32];
ASSISTANT                 pbkdf2_hmac(
ASSISTANT                     self.random_secret.as_bytes(),
ASSISTANT                     salt,
ASSISTANT                     self.iterations as usize,
ASSISTANT                     MessageDigest::sha256(),
ASSISTANT                     &mut key,
ASSISTANT                 )?;
ASSISTANT                 Ok(key)
ASSISTANT             }
ASSISTANT         }
ASSISTANT     }
ASSISTANT }
