USER USER crypto/openssl/main.nix
USER USER ```
USER USER /**
USER USER   OpenSSL cryptographic operations for nix-crypto.
USER USER */
USER USER { pkgs, prelude, private-key-spec-type, x509-params-type, export-decryptable-pkey-params-type, ... }@module:
USER USER let
USER USER   inherit (pkgs) lib;
USER USER   inherit (lib) types;
USER USER   inherit (builtins.crypto) openssl;
USER USER   type-checker = prelude.type-checker {
USER USER     file = "${./openssl.nix}";
USER USER   };
USER USER 
USER USER   /**
USER USER     Produces a deterministic key identity string from an attribute set.
USER USER     Keys are sorted alphabetically and joined as `key=value` pairs separated
USER USER     by `&`. For example, `{ vault = "openssl"; name = "my-key"; }` produces
USER USER     `"name=my-key&vault=openssl"`.
USER USER 
USER USER     This string is used by both the nix-crypto plugin (to store the key) and
USER USER     `nix-crypto-service` (to look it up). The sort order ensures the identity
USER USER     is stable regardless of the order in which `attrs` is defined in nix.
USER USER   */
USER USER   to-key-identity = attrs:
USER USER     let
USER USER       keys = lib.sort (a: b: a < b) (lib.attrNames attrs);
USER USER       mk-entry = k:
USER USER         let
USER USER           value = attrs.${k};
USER USER         in
USER USER           "${k}=${value}"
USER USER       ;
USER USER     in
USER USER       lib.concatStringsSep "&" (lib.map mk-entry keys)
USER USER   ;
USER USER 
USER USER   /**
USER USER     Build an X.509 certificate signed by the given private key.
USER USER     Returns an attribute set with:
USER USER     - `certificate-pem`: the certificate in PEM format.
USER USER   */
USER USER   x509 = { key-ref, x509-params }:
USER USER   let
USER USER     x509-params-all =
USER USER       x509-params
USER USER       // { signing-private-key-identity = key-ref; }
USER USER     ;
USER USER   in
USER USER     {
USER USER       certificate-pem = openssl.x509-pem x509-params-all;
USER USER     }
USER USER   ;
USER USER 
USER USER   /**
USER USER     Export a private key credential encrypted with the given symmetric key.
USER USER     Returns a PEM-formatted string containing the AES-128-CBC encrypted
USER USER     private key.
USER USER 
USER USER     The same inputs (symmetric-key-params, key-ref, store) will always
USER USER     produce identical output, as the salt and IV are persisted in the store
USER USER     on the first call and reused thereafter.
USER USER   */
USER USER   export-decryptable-pkey = { key-ref, symmetric-key-params }:
USER USER     openssl.export-decryptable-pkey symmetric-key-params key-ref
USER USER   ;
USER USER 
USER USER   /**
USER USER     Retrieve or generate an OpenSSL private key.
USER USER     Accepts a `key-spec` with:
USER USER     - `attrs`: an attribute set of key-value pairs used to construct the key
USER USER       identity string (e.g. `{ vault = "openssl"; name = "my-key"; }`).
USER USER     - `type`: the key type string (e.g. `"rsa"`).
USER USER 
USER USER     Returns an attribute set with:
USER USER     - `identity`: the key identity string produced by `to-key-identity`. Exposed
USER USER       so that callers (e.g. `nix-crypto-service`) can locate the key in the
USER USER       sled store without reconstructing the identity manually.
USER USER     - `public-key-pem`: the public key in PEM format, computed by the nix plugin.
USER USER     - `x509`: a function to build X.509 certificates signed by this key.
USER USER     - `export-decryptable-pkey`: a function to export this private key encrypted
USER USER       with a symmetric key.
USER USER   */
USER USER   private-key-impl = key-spec:
USER USER   let
USER USER     key-ref = {
USER USER       key-identity = to-key-identity key-spec.attrs;
USER USER       key-type = key-spec.type;
USER USER     };
USER USER   in
USER USER     {
USER USER       identity = key-ref.key-identity;
USER USER       public-key-pem = openssl.public-key-pem key-ref;
USER USER       x509 =
USER USER         type-checker.function
USER USER         [ { name = "x509-params"; type = x509-params-type; } ]
USER USER         (x509-params: x509 { inherit key-ref x509-params; })
USER USER       ;
USER USER       export-decryptable-pkey =
USER USER         type-checker.function
USER USER         [ { name = "symmetric-key-params"; type = export-decryptable-pkey-params-type; } ]
USER USER         (symmetric-key-params: export-decryptable-pkey { inherit key-ref symmetric-key-params; })
USER USER       ;
USER USER     }
USER USER   ;
USER USER 
USER USER   private-key =
USER USER     type-checker.function
USER USER     [ { name = "key-spec"; type = private-key-spec-type; } ]
USER USER     private-key-impl
USER USER   ;
USER USER in
USER USER   { inherit private-key; }
USER USER ```
