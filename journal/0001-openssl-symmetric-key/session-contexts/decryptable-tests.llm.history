ASSISTANT /**
ASSISTANT   Test suite for OpenSSL functionality.
ASSISTANT 
ASSISTANT   Accepts the following arguments:
ASSISTANT   - `pkgs`: the nixpkgs package set.
ASSISTANT   - `nix-crypto-service`: path to the `nix-crypto-service` binary.
ASSISTANT */
ASSISTANT { pkgs, nix-crypto-service, ... }:
ASSISTANT let
ASSISTANT   crypto = pkgs.callPackage ../crypto/default.nix {};
ASSISTANT   inherit (crypto) openssl;
ASSISTANT 
ASSISTANT   # Generates an RSA key or returns the existing one from the store.
ASSISTANT   # The private key itself is not returned — only operations that can
ASSISTANT   # be performed with it.
ASSISTANT   pk-rsa = openssl.private-key { 
ASSISTANT     attrs = {
ASSISTANT       vault = "openssl";
ASSISTANT       name = "openssl-test-key";
ASSISTANT     };
ASSISTANT     type = "rsa";
ASSISTANT   };
ASSISTANT 
ASSISTANT   # Symmetric key parameters used to encrypt the private key.
ASSISTANT   # The same parameters must be passed to nix-crypto-service when
ASSISTANT   # retrieving the passphrase.
ASSISTANT   symmetric-key-params = {
ASSISTANT     key-id = "openssl-test-symmetric-key";
ASSISTANT     key-derivation = "pbkdf2";
ASSISTANT     iterations = 600000;
ASSISTANT   };
ASSISTANT 
ASSISTANT   # The encrypted PEM string produced by the nix-crypto plugin.
ASSISTANT   encrypted-pkey-pem = pk-rsa.export-decryptable-pkey symmetric-key-params;
ASSISTANT in
ASSISTANT   {
ASSISTANT     # Asserts that the plugin can generate or retrieve a public key in PEM format.
ASSISTANT     "It can generate a public/private key set" = { _assert, ... }:
ASSISTANT       _assert.is-string pk-rsa.public-key-pem
ASSISTANT     ;
ASSISTANT 
ASSISTANT     # Asserts that the plugin can build a self-signed X.509 certificate
ASSISTANT     # signed by the RSA key.
ASSISTANT     "It can generate a x509 self-signed certificate" = { _assert, ... }:
ASSISTANT     let
ASSISTANT       x509 = pk-rsa.x509 {
ASSISTANT         subject-name = { CN = "subject"; };
ASSISTANT         issuer-name = { CN = "issuer"; };
ASSISTANT         serial = 1;
ASSISTANT         start-date = "2026-01-09T21:29:36Z";
ASSISTANT         expiry-date = "2036-01-09T21:29:36Z";
ASSISTANT       };
ASSISTANT     in
ASSISTANT       # Derivation which outputs the public certificate of the CA
ASSISTANT       # safe to write into the nix store.
ASSISTANT       _assert.strings.has-prefix "-----BEGIN CERTIFICATE-----" x509.certificate-pem
ASSISTANT     ;
ASSISTANT 
ASSISTANT     /**
ASSISTANT       Asserts that a private key stored by the nix-crypto plugin can be exported
ASSISTANT       using `nix-crypto-service export secret`, and that the public key derived
ASSISTANT       from the exported private key matches the public key computed by the plugin.
ASSISTANT 
ASSISTANT       The `NIX_CRYPTO_STORE` environment variable must point to the same sled store used
ASSISTANT       by the nix-crypto plugin so that `nix-crypto-service` can locate the key.
ASSISTANT     */
ASSISTANT     "It can export the private key" = { _assert, ... }:
ASSISTANT     let
ASSISTANT       # The public key pem as computed by the nix plugin
ASSISTANT       expected-public-key-pem = pk-rsa.public-key-pem;
ASSISTANT       # The identity of the key, used to locate it in the store
ASSISTANT       key-identity = pk-rsa.identity;
ASSISTANT     in
ASSISTANT       _assert.bash-script
ASSISTANT       ''
ASSISTANT         PRIVATE_KEY_FILE=$(mktemp)
ASSISTANT         EXPECTED_PUBLIC_KEY_FILE=$(mktemp)
ASSISTANT         RANDOM_FILE=$(mktemp)
ASSISTANT         SIGNATURE_FILE=$(mktemp)
ASSISTANT 
ASSISTANT         # Write the expected public key pem to a temp file
ASSISTANT         cat > "$EXPECTED_PUBLIC_KEY_FILE" << 'EOF'
ASSISTANT         ${expected-public-key-pem}
ASSISTANT         EOF
ASSISTANT 
ASSISTANT         # Export the private key using nix-crypto-service
ASSISTANT         "${nix-crypto-service}" export secret \
ASSISTANT           --sled-store "$NIX_CRYPTO_STORE" \
ASSISTANT           --identity-type openssl-pkey \
ASSISTANT           --openssl-pkey-type rsa \
ASSISTANT           --openssl-pkey-id "${key-identity}" \
ASSISTANT           --output-file "$PRIVATE_KEY_FILE" \
ASSISTANT           --log-file "$NIX_CRYPTO_LOG" \
ASSISTANT           --log-level debug
ASSISTANT 
ASSISTANT         # Generate a random value to sign
ASSISTANT         dd if=/dev/urandom of="$RANDOM_FILE" bs=32 count=1 2>/dev/null
ASSISTANT 
ASSISTANT         # Sign the random value using the exported private key
ASSISTANT         openssl dgst -sha256 -sign "$PRIVATE_KEY_FILE" -out "$SIGNATURE_FILE" "$RANDOM_FILE"
ASSISTANT 
ASSISTANT         # Verify the signature using the expected public key
ASSISTANT         if ! openssl dgst -sha256 -verify "$EXPECTED_PUBLIC_KEY_FILE" -signature "$SIGNATURE_FILE" "$RANDOM_FILE"; then
ASSISTANT           exit 1
ASSISTANT         fi
ASSISTANT         exit 0
ASSISTANT       ''
ASSISTANT     ;
ASSISTANT 
ASSISTANT     /**
ASSISTANT       Asserts that a private key stored by the nix-crypto plugin can be exported
ASSISTANT       in encrypted form using `export-decryptable-pkey`, and that the key can be
ASSISTANT       decrypted using the passphrase retrieved via `nix-crypto-service export secret`
ASSISTANT       with `--identity-type openssl-symmetric-key`.
ASSISTANT 
ASSISTANT       Steps:
ASSISTANT         1. The encrypted PEM is produced by the nix-crypto plugin at evaluation time.
ASSISTANT         2. The passphrase is retrieved from the store using nix-crypto-service.
ASSISTANT         3. The openssl enc command decrypts the PEM using the passphrase.
ASSISTANT         4. The decrypted key is used to sign a random value, asserting it is valid.
ASSISTANT 
ASSISTANT       The `NIX_CRYPTO_STORE` environment variable must point to the same sled store used
ASSISTANT       by the nix-crypto plugin so that `nix-crypto-service` can locate the symmetric key.
ASSISTANT     */
ASSISTANT     "It can export decryptable key" = { _assert, ... }:
ASSISTANT     let
ASSISTANT       key-identity = pk-rsa.identity;
ASSISTANT     in
ASSISTANT       _assert.bash-script
ASSISTANT       ''
ASSISTANT         ENCRYPTED_PEM_FILE=$(mktemp)
ASSISTANT         PASSPHRASE_FILE=$(mktemp)
ASSISTANT         DECRYPTED_KEY_FILE=$(mktemp)
ASSISTANT         RANDOM_FILE=$(mktemp)
ASSISTANT         SIGNATURE_FILE=$(mktemp)
ASSISTANT 
ASSISTANT         # Write the encrypted PEM produced by the nix-crypto plugin to a temp file
ASSISTANT         cat > "$ENCRYPTED_PEM_FILE" << 'EOF'
ASSISTANT         ${encrypted-pkey-pem}
ASSISTANT         EOF
ASSISTANT 
ASSISTANT         # Retrieve the passphrase used to encrypt the private key
ASSISTANT         "${nix-crypto-service}" export secret \
ASSISTANT           --sled-store "$NIX_CRYPTO_STORE" \
ASSISTANT           --identity-type openssl-symmetric-key \
ASSISTANT           --openssl-symmetric-key-id "openssl-test-symmetric-key" \
ASSISTANT           --openssl-symmetric-key-derivation pbkdf2 \
ASSISTANT           --openssl-symmetric-key-iterations 600000 \
ASSISTANT           --output-file "$PASSPHRASE_FILE" \
ASSISTANT           --log-file "$NIX_CRYPTO_LOG" \
ASSISTANT           --log-level debug
ASSISTANT 
ASSISTANT         # Decrypt the private key using the passphrase
ASSISTANT         openssl enc -d -aes-128-cbc -pbkdf2 \
ASSISTANT           -iter 600000 \
ASSISTANT           -pass file:"$PASSPHRASE_FILE" \
ASSISTANT           -in "$ENCRYPTED_PEM_FILE" \
ASSISTANT           -out "$DECRYPTED_KEY_FILE"
ASSISTANT 
ASSISTANT         # Generate a random value to sign
ASSISTANT         dd if=/dev/urandom of="$RANDOM_FILE" bs=32 count=1 2>/dev/null
ASSISTANT 
ASSISTANT         # Sign the random value using the decrypted private key.
ASSISTANT         # If openssl reports no errors, the test is successful.
ASSISTANT         openssl dgst -sha256 -sign "$DECRYPTED_KEY_FILE" -out "$SIGNATURE_FILE" "$RANDOM_FILE"
ASSISTANT 
ASSISTANT         exit 0
ASSISTANT       ''
ASSISTANT     ;
ASSISTANT   }
ASSISTANT ```
