ASSISTANT nix-crypto-core/src/openssl/decryptable.rs
ASSISTANT ```
ASSISTANT use openssl::pkcs5::pbkdf2_hmac;
ASSISTANT use openssl::hash::MessageDigest;
ASSISTANT use openssl::symm::{encrypt, Cipher};
ASSISTANT use openssl::rand::rand_bytes;
ASSISTANT 
ASSISTANT use base64::engine::general_purpose::STANDARD;
ASSISTANT use base64::Engine;
ASSISTANT 
ASSISTANT use crate::error::Error;
ASSISTANT use crate::foundations::{CryptoNix, IsCryptoStoreKeyDerivable};
ASSISTANT use crate::store::{IsCryptoStoreKey, StoreHasher};
ASSISTANT use crate::openssl::pkey;
ASSISTANT 
ASSISTANT // ============================================================================
ASSISTANT // Decryptable trait
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT /// A `Decryptable` value can be represented as a byte vector for the purpose
ASSISTANT /// of encryption. This is the plaintext representation that will be encrypted,
ASSISTANT /// not the encrypted representation itself.
ASSISTANT pub trait Decryptable {
ASSISTANT     fn export(&self) -> Result<Vec<u8>, Error>;
ASSISTANT }
ASSISTANT 
ASSISTANT impl Decryptable for pkey::Key {
ASSISTANT     fn export(&self) -> Result<Vec<u8>, Error> {
ASSISTANT         self.key_to_pem()
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT #[repr(u8)]
ASSISTANT #[derive(Debug, Clone, Copy, PartialEq, Eq)]
ASSISTANT /// Enum that lists all the key derivation schemes supported
ASSISTANT /// by Nix Crypto for exporting decryptable credentials.
ASSISTANT pub enum KeyDerivation {
ASSISTANT     PBKDF2 = 0
ASSISTANT }
ASSISTANT 
ASSISTANT impl KeyDerivation {
ASSISTANT 
ASSISTANT     pub fn from_string(value: &String) -> Result<KeyDerivation, Error> {
ASSISTANT         match value.to_lowercase().as_str() {
ASSISTANT             "pbkdf2" => Ok(KeyDerivation::PBKDF2),
ASSISTANT             _ => Error::fail_with(
ASSISTANT                 format!("The given string '{}' is not a valid key derivation method.", value)
ASSISTANT             )
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     pub fn from_u8(value: u8) -> Result<KeyDerivation, Error> {
ASSISTANT 
ASSISTANT         if value == (KeyDerivation::PBKDF2 as u8) {
ASSISTANT             Ok(KeyDerivation::PBKDF2)
ASSISTANT         }
ASSISTANT         else {
ASSISTANT             Error::fail_with(format!("Cannot convert '{}' into a KeyDerivation", value))
ASSISTANT         }
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT // ============================================================================
ASSISTANT // SymmetricKeyValue
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT /// The value stored in the `CryptoStore` for a symmetric key. Contains the
ASSISTANT /// randomly generated secret, the key derivation scheme, and the iteration
ASSISTANT /// count used for PBKDF2.
ASSISTANT pub struct SymmetricKeyValue {
ASSISTANT     pub random_secret: String,
ASSISTANT     pub key_derivation: KeyDerivation,
ASSISTANT     pub iterations: u32,
ASSISTANT }
ASSISTANT 
ASSISTANT impl SymmetricKeyValue {
ASSISTANT     /// Serialize to bytes as `<key_derivation>:<iterations>:<random_secret>`.
ASSISTANT     fn to_bytes(&self) -> Vec<u8> {
ASSISTANT         format!("{}:{}:{}", (self.key_derivation as u8).clone(), self.iterations, self.random_secret)
ASSISTANT             .into_bytes()
ASSISTANT     }
ASSISTANT 
ASSISTANT     /// Deserialize from bytes produced by `to_bytes`.
ASSISTANT     fn from_bytes(bytes: &[u8]) -> Result<Self, Error> {
ASSISTANT         let s = std::str::from_utf8(bytes)?;
ASSISTANT 
ASSISTANT         // Split into at most 3 parts so the random_secret can itself contain ':'
ASSISTANT         let mut parts = s.splitn(3, ':');
ASSISTANT 
ASSISTANT         let key_derivation_u8 = parts
ASSISTANT             .next()
ASSISTANT             .ok_or_else(|| Error::from_message("Missing key_derivation in SymmetricKeyValue".to_string()))?
ASSISTANT             .to_string()
ASSISTANT             .parse::<u8>()
ASSISTANT             .map_err(|_| Error::from_message("Invalid key derivaiton for value.".to_string()))?;
ASSISTANT 
ASSISTANT         let key_derivation = KeyDerivation::from_u8(key_derivation_u8)?;
ASSISTANT 
ASSISTANT         let iterations_str = parts
ASSISTANT             .next()
ASSISTANT             .ok_or_else(|| Error::from_message("Missing iterations in SymmetricKeyValue".to_string()))?;
ASSISTANT 
ASSISTANT         let iterations = iterations_str
ASSISTANT             .parse::<u32>()
ASSISTANT             .map_err(|_| Error::from_message(format!("Invalid iterations value: {}", iterations_str)))?;
ASSISTANT 
ASSISTANT         let random_secret = parts
ASSISTANT             .next()
ASSISTANT             .ok_or_else(|| Error::from_message("Missing random_secret in SymmetricKeyValue".to_string()))?
ASSISTANT             .to_string();
ASSISTANT 
ASSISTANT         Ok(SymmetricKeyValue { random_secret, key_derivation, iterations })
ASSISTANT     }
ASSISTANT 
ASSISTANT 
ASSISTANT     /// Derive a 256-bit AES key from a passphrase using the specified
ASSISTANT     /// key derivation method.
ASSISTANT     fn derive_aes_key(&self, salt: &[u8]) -> Result<Vec<u8>, Error> {
ASSISTANT 
ASSISTANT         match self.key_derivation {
ASSISTANT             KeyDerivation::PBKDF2 => {
ASSISTANT                 let mut key = vec![0u8; 32];
ASSISTANT                 pbkdf2_hmac(
ASSISTANT                     self.random_secret.as_bytes(),
ASSISTANT                     salt,
ASSISTANT                     self.iterations as usize,
ASSISTANT                     MessageDigest::sha256(),
ASSISTANT                     &mut key,
ASSISTANT                 )?;
ASSISTANT                 Ok(key)
ASSISTANT             }
ASSISTANT         }
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT // ============================================================================
ASSISTANT // IsOpensslSymmetricKeyIdentity
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT /// Identifies an OpenSSL symmetric key. Implementors provide the key identity,
ASSISTANT /// derivation scheme, and PBKDF2 iteration count. The underlying
ASSISTANT /// `SymmetricKeyValue` (including the random secret) is derived and stored
ASSISTANT /// automatically.
ASSISTANT pub trait IsOpensslSymmetricKeyIdentity {
ASSISTANT     fn key_id(&self) -> &String;
ASSISTANT     fn key_derivation(&self) -> &String;
ASSISTANT     fn iterations(&self) -> u32;
ASSISTANT }
ASSISTANT 
ASSISTANT /// A newtype wrapper around a reference to an arbitrary `IsOpensslSymmetricKeyIdentity`
ASSISTANT /// instance. The `IsCrytpoStoreKeyDerivable` trait for symmetric key identites
ASSISTANT /// is implemented through this type.
ASSISTANT struct SymmetricKeyIdentity<'a, T: IsOpensslSymmetricKeyIdentity>(pub &'a T);
ASSISTANT 
ASSISTANT impl<'a, T : IsOpensslSymmetricKeyIdentity> IsCryptoStoreKey
ASSISTANT for SymmetricKeyIdentity<'a, T> {
ASSISTANT     type Value = SymmetricKeyValue;
ASSISTANT 
ASSISTANT     fn to_store_key_raw(&self, mut hasher: StoreHasher) -> Vec<u8> {
ASSISTANT         let identity = self.0;
ASSISTANT         let iterations = identity.iterations();
ASSISTANT         hasher.update(identity.key_id().as_bytes());
ASSISTANT         hasher.update(identity.key_derivation().as_bytes());
ASSISTANT         hasher.update(&iterations.to_be_bytes());
ASSISTANT         Vec::from(hasher.finish())
ASSISTANT     }
ASSISTANT 
ASSISTANT     fn to_store_value_raw(value: &SymmetricKeyValue) -> Result<Vec<u8>, Error> {
ASSISTANT         Ok(value.to_bytes())
ASSISTANT     }
ASSISTANT 
ASSISTANT 
ASSISTANT     fn from_store_value_raw(value: &Vec<u8>) -> Result<SymmetricKeyValue, Error> {
ASSISTANT         SymmetricKeyValue::from_bytes(value)
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT impl<'a, T: IsOpensslSymmetricKeyIdentity> IsCryptoStoreKeyDerivable
ASSISTANT for SymmetricKeyIdentity<'a, T> {
ASSISTANT     fn derive(&self) -> Result<SymmetricKeyValue, Error> {
ASSISTANT         let mut random_bytes = vec![0u8; 16];
ASSISTANT         rand_bytes(&mut random_bytes)?;
ASSISTANT         let random_secret = STANDARD.encode(&random_bytes);
ASSISTANT 
ASSISTANT         Ok(SymmetricKeyValue {
ASSISTANT             random_secret,
ASSISTANT             key_derivation: KeyDerivation::from_string(&self.0.key_derivation())?,
ASSISTANT             iterations: self.0.iterations(),
ASSISTANT         })
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT // ============================================================================
ASSISTANT // EncryptionParams
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT /// Stores the salt and IV used to encrypt a specific `(symmetric_key, credential)`
ASSISTANT /// pair. By persisting these in the store we guarantee that calling
ASSISTANT /// `export_decryptable` with the same key, credential, and store always
ASSISTANT /// produces identical output.
ASSISTANT pub struct EncryptionParams {
ASSISTANT     pub salt: Vec<u8>,
ASSISTANT     pub iv: Vec<u8>,
ASSISTANT }
ASSISTANT 
ASSISTANT impl EncryptionParams {
ASSISTANT     fn generate() -> Result<Self, Error> {
ASSISTANT         let mut salt = vec![0u8; 8];
ASSISTANT         let mut iv = vec![0u8; 16];
ASSISTANT         rand_bytes(&mut salt)?;
ASSISTANT         rand_bytes(&mut iv)?;
ASSISTANT         Ok(EncryptionParams { salt, iv })
ASSISTANT     }
ASSISTANT 
ASSISTANT     /// Serialize as `<salt_len_1_byte><salt><iv>`.
ASSISTANT     fn to_bytes(&self) -> Vec<u8> {
ASSISTANT         let mut bytes = Vec::new();
ASSISTANT         bytes.push(self.salt.len() as u8);
ASSISTANT         bytes.extend_from_slice(&self.salt);
ASSISTANT         bytes.extend_from_slice(&self.iv);
ASSISTANT         bytes
ASSISTANT     }
ASSISTANT 
ASSISTANT     fn from_bytes(bytes: &[u8]) -> Result<Self, Error> {
ASSISTANT         if bytes.is_empty() {
ASSISTANT             return Err(Error::from_message("EncryptionParams bytes are empty".to_string()));
ASSISTANT         }
ASSISTANT 
ASSISTANT         let salt_len = bytes[0] as usize;
ASSISTANT 
ASSISTANT         if bytes.len() < 1 + salt_len {
ASSISTANT             return Err(Error::from_message("EncryptionParams bytes too short for salt".to_string()));
ASSISTANT         }
ASSISTANT 
ASSISTANT         let salt = bytes[1..1 + salt_len].to_vec();
ASSISTANT         let iv = bytes[1 + salt_len..].to_vec();
ASSISTANT 
ASSISTANT         Ok(EncryptionParams { salt, iv })
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT /// The store key for `EncryptionParams`. It is derived by hashing the raw
ASSISTANT /// store keys of both the symmetric key identity and the credential identity,
ASSISTANT /// making it unique per `(key, credential)` pair.
ASSISTANT struct EncryptionParamsKey<'a, TKey, TCred> {
ASSISTANT     symmetric_key_identity: &'a TKey,
ASSISTANT     credential_identity: &'a TCred,
ASSISTANT }
ASSISTANT 
ASSISTANT impl<'a, TKey, TCred> EncryptionParamsKey<'a, TKey, TCred> {
ASSISTANT     pub fn new(symmetric_key_identity: &'a TKey, credential_identity: &'a TCred) -> Self {
ASSISTANT         EncryptionParamsKey { symmetric_key_identity, credential_identity }
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT impl<'a, TKey, TCred> IsCryptoStoreKey
ASSISTANT for EncryptionParamsKey<'a, TKey, TCred>
ASSISTANT where TKey : IsCryptoStoreKey, TCred : IsCryptoStoreKey {
ASSISTANT     type Value = EncryptionParams;
ASSISTANT 
ASSISTANT     fn to_store_key_raw(&self, mut hasher: StoreHasher) -> Vec<u8> {
ASSISTANT         hasher.update(b"encryption_params");
ASSISTANT         hasher.update_with_identity(self.symmetric_key_identity);
ASSISTANT         hasher.update_with_identity(self.credential_identity);
ASSISTANT         Vec::from(hasher.finish())
ASSISTANT     }
ASSISTANT 
ASSISTANT     fn to_store_value_raw(value: &EncryptionParams) -> Result<Vec<u8>, Error> {
ASSISTANT         Ok(value.to_bytes())
ASSISTANT     }
ASSISTANT 
ASSISTANT     fn from_store_value_raw(value: &Vec<u8>) -> Result<EncryptionParams, Error> {
ASSISTANT         EncryptionParams::from_bytes(value)
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT impl<'a, TKey, TCred> IsCryptoStoreKeyDerivable for EncryptionParamsKey<'a, TKey, TCred>
ASSISTANT where TKey : IsCryptoStoreKey, TCred : IsCryptoStoreKey {
ASSISTANT     fn derive(&self) -> Result<EncryptionParams, Error> {
ASSISTANT         EncryptionParams::generate()
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT // ============================================================================
ASSISTANT // Encryption helpers
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT const PEM_HEADER: &str = "-----BEGIN ENCRYPTED DATA-----";
ASSISTANT const PEM_FOOTER: &str = "-----END ENCRYPTED DATA-----";
ASSISTANT 
ASSISTANT /// Encrypt `plaintext` with AES-256-CBC and return a PEM-encoded string.
ASSISTANT ///
ASSISTANT /// The payload layout matches the OpenSSL `enc` format:
ASSISTANT ///   `Salted__` (8 bytes) | salt (8 bytes) | ciphertext
ASSISTANT /// The whole payload is Base64-encoded and wrapped in a PEM envelope.
ASSISTANT fn encrypt_to_pem(
ASSISTANT     key: &SymmetricKeyValue,
ASSISTANT     salt: &[u8],
ASSISTANT     iv: &[u8],
ASSISTANT     plaintext: &Vec<u8>
ASSISTANT ) -> Result<String, Error> {
ASSISTANT     let key = key.derive_aes_key(salt)?;
ASSISTANT     let cipher = Cipher::aes_256_cbc();
ASSISTANT     let ciphertext = encrypt(cipher, &key, Some(iv), plaintext)?;
ASSISTANT 
ASSISTANT     let mut payload = Vec::new();
ASSISTANT     payload.extend_from_slice(b"Salted__");
ASSISTANT     payload.extend_from_slice(salt);
ASSISTANT     payload.extend_from_slice(&ciphertext);
ASSISTANT 
ASSISTANT     let b64 = STANDARD.encode(&payload);
ASSISTANT 
ASSISTANT     // Wrap Base64 at 64 characters per line, as is standard for PEM
ASSISTANT     let pem_body = b64
ASSISTANT         .as_bytes()
ASSISTANT         .chunks(64)
ASSISTANT         .map(|chunk| std::str::from_utf8(chunk).unwrap())
ASSISTANT         .collect::<Vec<_>>()
ASSISTANT         .join("\n");
ASSISTANT 
ASSISTANT     Ok(format!("{}\n{}\n{}", PEM_HEADER, pem_body, PEM_FOOTER))
ASSISTANT }
ASSISTANT 
ASSISTANT // ============================================================================
ASSISTANT // export_decryptable
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT /// Export a credential encrypted with a symmetric key, returning a
ASSISTANT /// PEM-formatted string containing the AES-256-CBC encrypted credential.
ASSISTANT ///
ASSISTANT /// Calling this function multiple times with the same `key`, `credential`,
ASSISTANT /// and store will always produce identical output, because the salt and IV
ASSISTANT /// are stored in the `CryptoStore` on the first call and reused thereafter.
ASSISTANT pub fn export_decryptable<K, C>(
ASSISTANT     crypto_nix: &CryptoNix,
ASSISTANT     key: &K,
ASSISTANT     credential: &C,
ASSISTANT ) -> Result<String, Error>
ASSISTANT where
ASSISTANT     K: IsOpensslSymmetricKeyIdentity,
ASSISTANT     C: IsCryptoStoreKeyDerivable,
ASSISTANT     C::Value: Decryptable,
ASSISTANT {
ASSISTANT     // Step 1: Wrap the key in a SymmetricKeyIdentity and get or derive the
ASSISTANT     // symmetric key value (random_secret, derivation, iterations).
ASSISTANT     let symmetric_identity = SymmetricKeyIdentity(key);
ASSISTANT     let symmetric_key_value = crypto_nix.get_or_derive(&symmetric_identity)?;
ASSISTANT 
ASSISTANT     // Step 2: Get or derive the credential value
ASSISTANT     let credential_value = crypto_nix.get_or_derive(credential)?;
ASSISTANT 
ASSISTANT     // Encription parameters are unique per key/credential combination. This
ASSISTANT     // is important as the security of AES becomes weaker if the IV is
ASSISTANT     // reused on different plaintext inputs.
ASSISTANT     let encryption_params_key = EncryptionParamsKey::new(&symmetric_identity, credential);
ASSISTANT     let encryption_params = crypto_nix.get_or_derive(&encryption_params_key)?;
ASSISTANT 
ASSISTANT     // Step 4: Export the credential to plaintext bytes
ASSISTANT     let plaintext = credential_value.export()?;
ASSISTANT 
ASSISTANT     // Step 5: Encrypt and return as PEM
ASSISTANT     encrypt_to_pem(
ASSISTANT         &symmetric_key_value,
ASSISTANT         &encryption_params.salt,
ASSISTANT         &encryption_params.iv,
ASSISTANT         &plaintext
ASSISTANT     )
ASSISTANT }
ASSISTANT 
ASSISTANT // ============================================================================
ASSISTANT // get_symmetric_key_passphrase
ASSISTANT // ============================================================================
ASSISTANT 
ASSISTANT /// Retrieve (or derive and store) the random passphrase for the symmetric key
ASSISTANT /// identified by `key`. Returns the `random_secret` string which is the
ASSISTANT /// passphrase used as input to the key derivation function.
ASSISTANT ///
ASSISTANT /// Calling this function multiple times with the same `key` and store will
ASSISTANT /// always return the same passphrase, because the `SymmetricKeyValue` is
ASSISTANT /// stored on the first call and reused thereafter.
ASSISTANT pub fn get_symmetric_key_passphrase<K: IsOpensslSymmetricKeyIdentity>(
ASSISTANT     crypto_nix: &CryptoNix,
ASSISTANT     key: &K,
ASSISTANT ) -> Result<String, Error> {
ASSISTANT     let symmetric_identity = SymmetricKeyIdentity(key);
ASSISTANT     let value = crypto_nix.get_or_derive(&symmetric_identity)?;
ASSISTANT     Ok(value.random_secret)
ASSISTANT }
