USER nix-crypto-service/src/main.rs
USER ```
USER //! # nix-crypto-service
USER //!
USER //! A CLI tool for managing cryptographic secrets stored by the nix-crypto plugin.
USER //!
USER //! ## Usage
USER //!
USER //! ### Export a secret
USER //!
USER //! Exports a private key from the sled store to a PEM file:
USER //!
USER //! ```text
USER //! nix-crypto-service export secret \
USER //!   --sled-store <path> \
USER //!   --identity-type openssl-pkey \
USER //!   --openssl-pkey-type rsa \
USER //!   --openssl-pkey-id <identity> \
USER //!   --output-file <path>
USER //! ```
USER //!
USER //! Exports a symmetric key passphrase from the sled store to a file:
USER //!
USER //! ```text
USER //! nix-crypto-service export secret \
USER //!   --sled-store <path> \
USER //!   --identity-type openssl-symmetric-key \
USER //!   --openssl-symmetric-key-id <id> \
USER //!   --openssl-symmetric-key-derivation pbkdf2 \
USER //!   --openssl-symmetric-key-iterations 600000 \
USER //!   --output-file <path>
USER //! ```
USER //!
USER //! If `--sled-store` is not provided, the store path is resolved from the
USER //! `NIX_CRYPTO_STORE` environment variable, which must be set to `sled:<path>`.
USER //!
USER //! ### Logging
USER //!
USER //! Logging is optional. If `--log-file` is provided, log entries are written
USER //! to the specified file in append mode. The minimum log level can be set with
USER //! `--log-level` (default: `info`).
USER //!
USER //! ## Argument parsing
USER //!
USER //! This binary uses [`docopt`] for argument parsing. Note that `docopt` in Rust
USER //! skips `argv[0]` (the binary name) when parsing arguments. As a result, the
USER //! usage patterns must include the literal `nix-crypto-service` token so that
USER //! patterns are matched correctly when invoked directly. When using
USER //! `cargo run nix-crypto-service --version`, cargo passes `nix-crypto-service`
USER //! as `argv[1]`, which is why that works while invoking the binary directly
USER //! with `--version` does not match the pattern.
USER 
USER use docopt::Docopt;
USER use serde::Deserialize;
USER 
USER mod common;
USER mod export;
USER 
USER use crate::common::{Error, NixCryptoArgs};
USER 
USER const USAGE: &str = "
USER Usage:
USER     nix-crypto-service --version
USER     nix-crypto-service export secret [--sled-store <sled_store>] --identity-type <identity_type> [--openssl-pkey-type <openssl_pkey_type>] [--openssl-pkey-id <openssl_pkey_id>] [--openssl-symmetric-key-id <openssl_symmetric_key_id>] [--openssl-symmetric-key-derivation <openssl_symmetric_key_derivation>] [--openssl-symmetric-key-iterations <openssl_symmetric_key_iterations>] --output-file <output_file> [--log-file <log_file>] [--log-level <log_level>]
USER     nix-crypto-service --help
USER 
USER Options:
USER     -h, --help                                                              Show this help message.
USER     -v, --version                                                           Show the version.
USER     --sled-store <sled_store>                                               Path to the sled store on the filesystem.
USER     --identity-type <identity_type>                                         The identity type being exported (openssl-pkey, openssl-symmetric-key).
USER     --openssl-pkey-type <openssl_pkey_type>                                 The openssl private key type (required when --identity-type is 'openssl-pkey').
USER     --openssl-pkey-id <openssl_pkey_id>                                     The openssl private key id (required when --identity-type is 'openssl-pkey').
USER     --openssl-symmetric-key-id <openssl_symmetric_key_id>                   The symmetric key id (required when --identity-type is 'openssl-symmetric-key').
USER     --openssl-symmetric-key-derivation <openssl_symmetric_key_derivation>   The key derivation scheme [default: pbkdf2].
USER     --openssl-symmetric-key-iterations <openssl_symmetric_key_iterations>   The number of key derivation iterations [default: 600000].
USER     --output-file <output_file>                                             The file to write the exported secret to.
USER     --log-file <log_file>                                                   Path to the log file. If absent, logging is disabled.
USER     --log-level <log_level>                                                 Minimum log level: debug, info, warn, error [default: info].
USER ";
USER 
USER #[derive(Debug, Deserialize)]
USER struct Args {
USER     flag_version: bool,
USER     cmd_export: bool,
USER     cmd_secret: bool,
USER     flag_sled_store: Option<String>,
USER     flag_identity_type: Option<String>,
USER     flag_openssl_pkey_type: Option<String>,
USER     flag_openssl_pkey_id: Option<String>,
USER     flag_openssl_symmetric_key_id: Option<String>,
USER     flag_openssl_symmetric_key_derivation: Option<String>,
USER     flag_openssl_symmetric_key_iterations: Option<String>,
USER     flag_output_file: Option<String>,
USER     flag_log_file: Option<String>,
USER     flag_log_level: Option<String>,
USER }
USER 
USER impl Args {
USER 
USER     pub fn to_nix_crypto_args(&self) -> Result<NixCryptoArgs, Error> {
USER         NixCryptoArgs::from_flags(
USER             self.flag_sled_store.clone(),
USER             self.flag_log_file.clone(),
USER             self.flag_log_level.clone(),
USER         )
USER     }
USER 
USER     pub fn main(&self) -> Result<(), Error> {
USER         if self.flag_version {
USER             println!("nix-crypto-service {}", env!("CARGO_PKG_VERSION"));
USER             return Ok(());
USER         }
USER 
USER         if self.cmd_export && self.cmd_secret {
USER             let export_args = export::resolve_args(
USER                 self.to_nix_crypto_args()?,
USER                 self.flag_identity_type.clone(),
USER                 self.flag_openssl_pkey_type.clone(),
USER                 self.flag_openssl_pkey_id.clone(),
USER                 self.flag_openssl_symmetric_key_id.clone(),
USER                 self.flag_openssl_symmetric_key_derivation.clone(),
USER                 self.flag_openssl_symmetric_key_iterations.clone(),
USER                 self.flag_output_file.clone(),
USER             )?;
USER 
USER             export::run_secret(export_args)?;
USER             return Ok(());
USER         }
USER 
USER         Err(Error::unknown_action())
USER     }
USER }
USER 
USER fn main() {
USER     let args: Args = Docopt::new(USAGE)
USER         .and_then(|d| Ok(d.argv(std::env::args())))
USER         .and_then(|d| d.deserialize())
USER         .unwrap_or_else(|e| e.exit());
USER 
USER     match args.main() {
USER         Ok(()) => return,
USER         Err(e) => {
USER             eprintln!("{}\n\nError:\n\n{}", USAGE, e.as_string());
USER             std::process::exit(1);
USER         }
USER     }
USER }
USER ```
