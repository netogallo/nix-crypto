USER crypto/openssl/main.nix
USER ```
USER /**
USER   OpenSSL cryptographic operations for nix-crypto.
USER */
USER { pkgs, prelude, private-key-spec-type, x509-params-type, export-decryptable-pkey-params-type, ... }@module:
USER let
USER   inherit (pkgs) lib;
USER   inherit (lib) types;
USER   inherit (builtins.crypto) openssl;
USER   type-checker = prelude.type-checker {
USER     file = "${./openssl.nix}";
USER   };
USER 
USER   /**
USER     Produces a deterministic key identity string from an attribute set.
USER     Keys are sorted alphabetically and joined as `key=value` pairs separated
USER     by `&`. For example, `{ vault = "openssl"; name = "my-key"; }` produces
USER     `"name=my-key&vault=openssl"`.
USER 
USER     This string is used by both the nix-crypto plugin (to store the key) and
USER     `nix-crypto-service` (to look it up). The sort order ensures the identity
USER     is stable regardless of the order in which `attrs` is defined in nix.
USER   */
USER   to-key-identity = attrs:
USER     let
USER       keys = lib.sort (a: b: a < b) (lib.attrNames attrs);
USER       mk-entry = k:
USER         let
USER           value = attrs.${k};
USER         in
USER           "${k}=${value}"
USER       ;
USER     in
USER       lib.concatStringsSep "&" (lib.map mk-entry keys)
USER   ;
USER 
USER   /**
USER     Build an X.509 certificate signed by the given private key.
USER     Returns an attribute set with:
USER     - `certificate-pem`: the certificate in PEM format.
USER   */
USER   x509 = { key-ref, x509-params }:
USER   let
USER     x509-params-all =
USER       x509-params
USER       // { signing-private-key-identity = key-ref; }
USER     ;
USER   in
USER     {
USER       certificate-pem = openssl.x509-pem x509-params-all;
USER     }
USER   ;
USER 
USER   /**
USER     Export a private key credential encrypted with the given symmetric key.
USER     Returns a PEM-formatted string containing the AES-128-CBC encrypted
USER     private key.
USER 
USER     The same inputs (symmetric-key-params, key-ref, store) will always
USER     produce identical output, as the salt and IV are persisted in the store
USER     on the first call and reused thereafter.
USER   */
USER   export-decryptable-pkey = { key-ref, symmetric-key-params }:
USER     openssl.export-decryptable-pkey symmetric-key-params key-ref
USER   ;
USER 
USER   /**
USER     Retrieve or generate an OpenSSL private key.
USER     Accepts a `key-spec` with:
USER     - `attrs`: an attribute set of key-value pairs used to construct the key
USER       identity string (e.g. `{ vault = "openssl"; name = "my-key"; }`).
USER     - `type`: the key type string (e.g. `"rsa"`).
USER 
USER     Returns an attribute set with:
USER     - `identity`: the key identity string produced by `to-key-identity`. Exposed
USER       so that callers (e.g. `nix-crypto-service`) can locate the key in the
USER       sled store without reconstructing the identity manually.
USER     - `public-key-pem`: the public key in PEM format, computed by the nix plugin.
USER     - `x509`: a function to build X.509 certificates signed by this key.
USER     - `export-decryptable-pkey`: a function to export this private key encrypted
USER       with a symmetric key.
USER   */
USER   private-key-impl = key-spec:
USER   let
USER     key-ref = {
USER       key-identity = to-key-identity key-spec.attrs;
USER       key-type = key-spec.type;
USER     };
USER   in
USER     {
USER       identity = key-ref.key-identity;
USER       public-key-pem = openssl.public-key-pem key-ref;
USER       x509 =
USER         type-checker.function
USER         [ { name = "x509-params"; type = x509-params-type; } ]
USER         (x509-params: x509 { inherit key-ref x509-params; })
USER       ;
USER       export-decryptable-pkey =
USER         type-checker.function
USER         [ { name = "symmetric-key-params"; type = export-decryptable-pkey-params-type; } ]
USER         (symmetric-key-params: export-decryptable-pkey { inherit key-ref symmetric-key-params; })
USER       ;
USER     }
USER   ;
USER 
USER   private-key =
USER     type-checker.function
USER     [ { name = "key-spec"; type = private-key-spec-type; } ]
USER     private-key-impl
USER   ;
USER in
USER   { inherit private-key; }
USER ```
USER 
USER crypto/openssl/export-decryptable-pkey-params-type.nix
USER ```
USER { lib }:
USER let
USER   inherit (lib) types;
USER in
USER   types.submodule {
USER     options = {
USER       key-id = lib.mkOption {
USER         type = types.str;
USER         description = ''
USER           A unique identifier for the symmetric key. This is used to
USER           reference the key in the store. The same key-id will always
USER           refer to the same symmetric key within a given store.
USER         '';
USER       };
USER 
USER       key-derivation = lib.mkOption {
USER         type = types.enum [ "pbkdf2" ];
USER         default = "pbkdf2";
USER         description = ''
USER           The key derivation scheme to use when deriving the AES key
USER           from the random secret. Currently only `pbkdf2` is supported.
USER         '';
USER       };
USER 
USER       iterations = lib.mkOption {
USER         type = types.int;
USER         description = ''
USER           The number of iterations to use for the key derivation function.
USER           Higher values increase security but also increase computation time.
USER         '';
USER       };
USER     };
USER   }
USER ```
